local function afkHookActive()
    return _G.AnimeDiceRunning and _G.AnimeDiceAntiAFK
end
local function isAFKTrace()
    local trace = debug.traceback()
    return string.find(trace, "AFK", 1, true) or string.find(trace, "scheduleTeleport", 1, true)
end
