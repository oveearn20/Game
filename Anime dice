    local itemsOf = {}
    local function item(page, h)
        local wrap = new("Frame", {Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1, LayoutOrder = ord()}, page)
        local inner = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, wrap)
        itemsOf[page] = itemsOf[page] or {}
        table.insert(itemsOf[page], inner)
        return wrap, inner
    end
    local function stagger(page, d0)
        if REDUCED_MOTION or not page then return end
        for k, inner in ipairs(itemsOf[page] or {}) do
            inner.Position = UDim2.fromOffset(24, 0)
            task.delay((d0 or 0) + (k - 1) * 0.035, function()
                if inner.Parent then tw(inner, 0.45, {Position = UDim2.fromOffset(0, 0)}, Enum.EasingStyle.Quint) end
            end)
        end
    end

    local pages, tabs, tabCount, current = {}, {}, 0, nil
    local function showPage(name)
        local t = tabs[name]
        if not t then return end
        local changed = current ~= name
        for n, p in pairs(pages) do
            if n == name then
                if not p.Visible then
                    p.Visible = true
                    stagger(p, 0)
                end
            else
                p.Visible = false
            end
        end
        for n, tb in pairs(tabs) do
            tb.btn.BackgroundTransparency = 1
            tw(tb.lbl, 0.2, {TextTransparency = (n == name) and 0 or 0.4})
        end
        liquidMove(indicator, changed and indBar or nil, 2, 2 + (t.index - 1) * (TAB_H + TAB_GAP), TAB_H, false)
        current = name
    end

