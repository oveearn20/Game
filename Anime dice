    if hookfunction and not _G.AnimeDiceAFKHooks.teleport then
        local oldTeleport
        oldTeleport = hookfunction(TeleportService.Teleport, wrapC(function(self, placeId, player, ...)
            if afkHookActive() and isAFKTrace() then
