        local track = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(42, 22), BackgroundColor3 = T.offTrack, BorderSizePixel = 0}, row)
        pill(track)
        grad(track, C.white, Color3.fromRGB(165, 185, 225), 90)  -- ความวาวของราง
        local ts = stroke(track, C.blue, 1.1, 0.5)
        local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 11, 0.5, 0),
            Size = UDim2.fromOffset(16, 16), BackgroundColor3 = T.offKnob, BorderSizePixel = 0}, track)
        pill(knob)
        grad(knob, C.white, Color3.fromRGB(205, 220, 245), 90)
        stroke(knob, C.black, 1, 0.75)

        -- วงคลื่นจากปุ่มสวิตช์ตอนเปิด
        local function pulse()
            local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1}, knob)
            pill(r)
            local s = stroke(r, C.glow, 2, 0.1)
            tw(r, 0.45, {Size = UDim2.fromOffset(38, 38)}, Enum.EasingStyle.Quint)
            tw(s, 0.45, {Transparency = 1})
            task.delay(0.5, function() r:Destroy() end)
        end

        local function render(anim)
            local d = anim and 0.22 or 0
            tw(track, d, {BackgroundColor3 = state and C.blue or T.offTrack})
            tw(ts, d, {Color = state and C.glow or C.blue, Transparency = state and 0 or 0.5})
            tw(rs, d, {Color = state and C.glow or C.blue, Transparency = state and 0.2 or 0.5})
            -- ตำแหน่งใช้ Back ให้เด้งนิด ๆ, สีแยก tween กันสีเกินช่วงตอน overshoot
            tw(knob, anim and 0.34 or 0, {Position = UDim2.new(0, state and 31 or 11, 0.5, 0)}, Enum.EasingStyle.Back)
            tw(knob, d, {BackgroundColor3 = state and C.white or T.offKnob})
            if anim and state and not REDUCED_MOTION then pulse() end
        end
        render(false)

        interact(row, BASE,
            function() tw(rs, 0.15, {Transparency = 0.2}) end,
            function() tw(rs, 0.15, {Transparency = state and 0.2 or 0.5}) end)
        row.MouseButton1Click:Connect(function()
            state = not state
            render(true)
            if cb then task.spawn(cb, state) end
        end)

        return {
            Get = function() return state end,
            Set = function(v, silent)
                state = v == true
                render(true)
                if cb and not silent then task.spawn(cb, state) end
            end,
        }
    end

