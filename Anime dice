--========== คอนฟิก (บันทึกลงเครื่อง) ==========
local ConfigFolder = "JustHub/AnimeDice"
local AutoloadFile = ConfigFolder .. "/autoload.txt"
local HAS_FS = (writefile and readfile and isfile) ~= nil
local TOGGLE_KEYS = {"AutoRoll", "AutoRebirth", "AutoClaim", "AutoClaimRegularQuests", "AntiAFK",
    "AutoCollect", "AutoEquipBest", "AutoLevelSlots", "AutoUseItems", "AutoTower", "AutoEquipBestTowerTeam",
    "HideTowerScreen", "SellBelowChance", "AutoSellUnits", "ProtectPlottedUnits", "ProtectGradeSPlus",
    "ProtectLockedUnits", "AutoRerollGrade", "AutoUpgrades", "OnlySelectedUpgrades", "AutoBuyDice"}
local SLIDER_KEYS = {"CollectInterval", "EquipInterval", "ItemUseInterval", "SellInterval", "GradeRollDelay"}
local MULTI_KEYS  = {"SelectedItems", "SelectedSellRarities", "SelectedUpgradeCategories"}

local function safeName(name)
    return (tostring(name or ""):gsub("[^%w_%-]", ""))
end
local function ensureConfigFolder()
    pcall(function()
        if makefolder and isfolder then
            if not isfolder("JustHub") then makefolder("JustHub") end
            if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
        end
    end)
end
local function listConfigs()
    ensureConfigFolder()
    local list = {}
    pcall(function()
        if not listfiles then return end
        for _, path in ipairs(listfiles(ConfigFolder)) do
            local n = string.match(path, "([^/\\]+)%.json$")
            if n and n ~= "" then list[#list + 1] = n end
        end
    end)
    table.sort(list)
    return list
end
local function getAutoloadConfigName()
    local name = nil
    pcall(function()
        if isfile and isfile(AutoloadFile) then
            local c = readfile(AutoloadFile)
            if c and #c > 0 then name = (c:gsub("%s+", "")) end
        end
    end)
    return name
end
-- อัปเดต UI ทุกตัวให้ตรงกับ State (ไม่เรียก callback)
local function refreshUI()
    for _, k in ipairs(TOGGLE_KEYS) do if Refs[k] then Refs[k].Set(State[k] == true, true) end end
    for _, k in ipairs(SLIDER_KEYS) do if Refs[k] then Refs[k].Set(State[k], true) end end
    for _, k in ipairs(MULTI_KEYS) do if Refs[k] then Refs[k].Set(State[k] or {}, true) end end
    local rb = tonumber(State.TargetRebirth) or 19
    Refs.TargetRebirth.Set(rb >= 999 and "inf" or tostring(rb), true)
    local lv = tonumber(State.TargetUnitLevel) or 30
    Refs.TargetUnitLevel.Set(lv >= 999999 and "max" or tostring(lv), true)
    Refs.ItemUseCondition.Set(string.find(tostring(State.ItemUseCondition or ""), "Always Use", 1, true) and "always" or "expired", true)
    if not Refs.SelectedTower.Set(State.SelectedTower, true) then
        State.SelectedTower = "Dragon Tower"
        Refs.SelectedTower.Set("Dragon Tower", true)
    end
    Refs.TargetGrade.Set(State.TargetGrade, true)
    if not Refs.GradeUnit.Set(State.TargetGradeUnitKey, true) then
        State.TargetGradeUnitKey = Refs.GradeUnit.Get()
    end
    Refs.InGameAutoSellInput.Set(State.InGameAutoSellInput or "100m", true)
    _G.AnimeDiceAntiAFK = State.AntiAFK
end
local function saveConfigFile(name)
    if not HAS_FS then return false, "executor ไม่รองรับการบันทึกไฟล์" end
    ensureConfigFolder()
    local n = safeName(name)
    if n == "" then return false, "ชื่อต้องเป็น a-z, 0-9, _ หรือ -" end
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode({Version = "JustHub-1", Timestamp = os.time(), State = State})
    end)
    if not ok then return false, "แปลงข้อมูลไม่สำเร็จ" end
    if not pcall(writefile, ConfigFolder .. "/" .. n .. ".json", encoded) then
        return false, "เขียนไฟล์ไม่สำเร็จ"
    end
    return true, n
end
local function loadConfigFile(name)
    if not HAS_FS then return false, "executor ไม่รองรับการอ่านไฟล์" end
    local n = safeName(name)
    local path = ConfigFolder .. "/" .. n .. ".json"
    if n == "" or not isfile(path) then return false, "ไม่พบคอนฟิก " .. n end
    local okRead, content = pcall(readfile, path)
    if not okRead or not content or #content == 0 then return false, "อ่านไฟล์ไม่สำเร็จ" end
    local okDec, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not okDec or type(decoded) ~= "table" then return false, "ไฟล์คอนฟิกเสีย" end
    local loaded = decoded.State or decoded
    if type(loaded) ~= "table" then return false, "ไม่พบข้อมูลในคอนฟิก" end
    for k, v in pairs(loaded) do
        if State[k] ~= nil and type(State[k]) == type(v) then State[k] = v end
    end
    local okUI, err = pcall(refreshUI)
    if not okUI then warn("[JustHub] refreshUI:", err) end
    return true, n
end
local function deleteConfigFile(name)
    if not HAS_FS or not delfile then return false, "executor ไม่รองรับการลบไฟล์" end
    local n = safeName(name)
    local path = ConfigFolder .. "/" .. n .. ".json"
    if n == "" or not isfile(path) then return false, "ไม่พบคอนฟิก " .. n end
    if not pcall(delfile, path) then return false, "ลบไม่สำเร็จ" end
    if getAutoloadConfigName() == n then pcall(delfile, AutoloadFile) end
    return true, n
end
local function setAutoloadConfig(name)
    if not HAS_FS then return false, "executor ไม่รองรับการบันทึกไฟล์" end
    ensureConfigFolder()
    if not name or name == "" then
        pcall(function() if isfile(AutoloadFile) and delfile then delfile(AutoloadFile) end end)
        return true, ""
    end
    local n = safeName(name)
    if not isfile(ConfigFolder .. "/" .. n .. ".json") then return false, "ไม่พบคอนฟิก " .. n end
    if not pcall(writefile, AutoloadFile, n) then return false, "บันทึก Auto-Load ไม่สำเร็จ" end
    return true, n
end
local function autoloadText()
    local n = getAutoloadConfigName()
    return "Auto-Load: " .. ((n and n ~= "") and n or "ปิด")
end

--========== Settings ==========
do
    local p = pSet
    JH.Label(p, "กันหลุด (ANTI-AFK)")
    stateToggle(p, "กันหลุด 24/7 (Anti-AFK)", "AntiAFK", function(v) _G.AnimeDiceAntiAFK = v end)
    JH.Label(p, "คอนฟิก (CONFIG)")
    JH.Note(p, "บันทึกการตั้งค่าลงเครื่อง (โฟลเดอร์ JustHub/AnimeDice) และตั้งให้โหลดเองทุกครั้งที่รันได้")
    local setAutoStatus = JH.StatusRow(p, autoloadText())

    local function configOptions()
        local list = listConfigs()
        if #list == 0 then return {{id = "", label = "ไม่มีคอนฟิก (ว่าง)"}} end
        return opts(list)
    end
    local cfgOpts = configOptions()
    local selected = cfgOpts[1].id
    local dropCfg
    local function refreshList(selectId)
        dropCfg.SetOptions(configOptions())
        if selectId then dropCfg.Set(selectId, true) end
        selected = dropCfg.Get()
        setAutoStatus(autoloadText())
    end
    local function needSelected()
        if selected == "" then Toast("เลือกคอนฟิกก่อน") return false end
        return true
    end

    local nameInput = JH.Input(p, "ชื่อคอนฟิกใหม่", "Default", "เช่น Farm_Main, Night_AFK")
    JH.Button(p, "สร้างคอนฟิกใหม่ (บันทึกค่าปัจจุบัน)", function()
        local ok, msg = saveConfigFile(nameInput.Get())
        if ok then refreshList(msg) end
        Toast(ok and ("บันทึกคอนฟิก [" .. msg .. "] แล้ว") or ("ผิดพลาด: " .. msg))
    end)
    dropCfg = JH.Dropdown(p, "เลือกคอนฟิก", cfgOpts, selected, function(id) selected = id end)
    JH.Button(p, "โหลดคอนฟิก", function()
        if not needSelected() then return end
        local ok, msg = loadConfigFile(selected)
        Toast(ok and ("โหลดคอนฟิก [" .. msg .. "] แล้ว") or ("โหลดไม่สำเร็จ: " .. msg))
    end)
    JH.Button(p, "บันทึกทับคอนฟิกที่เลือก", function()
        if not needSelected() then return end
        local ok, msg = saveConfigFile(selected)
        Toast(ok and ("บันทึกทับ [" .. msg .. "] แล้ว") or ("ผิดพลาด: " .. msg))
    end)
    JH.Button(p, "รีเฟรชรายชื่อคอนฟิก", function()
        refreshList()
        Toast("รีเฟรชรายชื่อแล้ว")
    end)
    JH.Button(p, "ตั้งเป็น Auto-Load", function()
        if not needSelected() then return end
        local ok, msg = setAutoloadConfig(selected)
        setAutoStatus(autoloadText())
        Toast(ok and ("ตั้ง [" .. msg .. "] เป็น Auto-Load แล้ว") or ("ผิดพลาด: " .. msg))
    end)
    JH.Button(p, "ยกเลิก Auto-Load", function()
        setAutoloadConfig(nil)
        setAutoStatus(autoloadText())
        Toast("ยกเลิก Auto-Load แล้ว")
    end)
    JH.Button(p, "ลบคอนฟิกที่เลือก", function()
        if not needSelected() then return end
        local ok, msg = deleteConfigFile(selected)
        if ok then refreshList() end
        Toast(ok and ("ลบคอนฟิก [" .. msg .. "] แล้ว") or ("ลบไม่สำเร็จ: " .. msg))
    end, true)

    JH.Label(p, "ระบบ (SYSTEM)")
    JH.Button(p, "ซ่อนเมนู", function() JH.setOpen(false) end)
    JH.Button(p, "ปิดสคริปต์ (Unload)", function() cleanup() end, true)
end

