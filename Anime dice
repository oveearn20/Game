        glass(row, 13, BASE, T.surfTop, T.surfBot, 90)
        local rs = rim(row, C.blue, 1.2, 0.5)
        sheen(row, 13, 0.88)

        text(row, title, 10, Enum.Font.GothamBold, {Position = UDim2.fromOffset(15, 7),
            Size = UDim2.new(1, -60, 0, 12), TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = C.glow, TextTransparency = 0.15})
        local val = text(row, cur.label, 13, Enum.Font.GothamBold, {Position = UDim2.fromOffset(15, 21),
            Size = UDim2.new(1, -60, 0, 18), TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd})

        -- ปุ่มลูกศร: กระจกฟ้าตอนปิด, เต็มสีแบบ "ถูกเลือก" ตอนเปิด
        local chip = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(28, 28), BackgroundColor3 = C.white, BackgroundTransparency = 0.7, BorderSizePixel = 0}, row)
        pill(chip)
        grad(chip, C.blue, C.deep, 90)
        local chipStroke = stroke(chip, C.glow, 1.1, 0.7)
        local arrow = text(chip, ">", 14, Enum.Font.GothamBold, {Size = UDim2.fromScale(1, 1), Rotation = 90})

        -- รายการ: ซ่อนตอนปิด, ขยายความสูงตอนเปิด
        local list = new("ScrollingFrame", {Position = UDim2.fromOffset(0, ROW + 6), Size = UDim2.new(1, 0, 0, 0),
            BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = C.bright, Visible = false,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ClipsDescendants = true}, inner)
        glass(list, 12, 0.18, T.surfTop, T.surfBot, 90)
        rim(list, C.blue, 1.1, 0.4)
        new("UIPadding", {PaddingTop = UDim.new(0, PAD), PaddingBottom = UDim.new(0, PAD),
            PaddingLeft = UDim.new(0, PAD), PaddingRight = UDim.new(0, PAD)}, list)
        local hl = new("Frame", {Size = UDim2.new(1, 0, 0, ITEM), Visible = false, ZIndex = 1}, list)
        local hlBar = activeFill(hl, 10)
        local itemsF = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, ZIndex = 2}, list)
        new("UIListLayout", {Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder}, itemsF)

        -- เปลี่ยนข้อความค่าที่เลือก: ของเก่าเลื่อนขึ้นหาย ของใหม่เด้งขึ้นมา
        local function setVal(label)
            if val.Text == label then return end
            if REDUCED_MOTION then val.Text = label return end
            tw(val, 0.12, {Position = UDim2.fromOffset(15, 15), TextTransparency = 1})
            task.delay(0.12, function()
                if not val.Parent then return end
                val.Text = label
                val.Position = UDim2.fromOffset(15, 27)
                tw(val, 0.3, {Position = UDim2.fromOffset(15, 21), TextTransparency = 0}, Enum.EasingStyle.Back)
            end)
        end

        local items = {}
        local function paint(anim, moved)
            local d = anim and 0.18 or 0
            for id, it in pairs(items) do
                tw(it.lbl, d, {TextTransparency = (id == cur.id) and 0 or 0.35})
            end
            local it = items[cur.id]
            if it then liquidMove(hl, moved and hlBar or nil, 0, (it.index - 1) * (ITEM + GAP), ITEM, not anim) end
        end
        local function close()
            opened = false
            tw(wrap, 0.28, {Size = UDim2.new(1, 0, 0, ROW)}, Enum.EasingStyle.Quint)
            tw(list, 0.28, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quint)
            tw(arrow, 0.34, {Rotation = 90}, Enum.EasingStyle.Back)
            tw(chip, 0.2, {BackgroundTransparency = 0.7})
            tw(chipStroke, 0.2, {Transparency = 0.7})
            tw(rs, 0.2, {Color = C.blue, Transparency = 0.5})
            task.delay(0.29, function() if not opened then list.Visible = false end end)
        end
        local function sizes()
            local n = #options
            listH = math.min(n * ITEM + math.max(n - 1, 0) * GAP + PAD * 2, MAXLIST)
            openH = ROW + 6 + listH + 2
            if opened then
                list.Size = UDim2.new(1, 0, 0, listH)
                wrap.Size = UDim2.new(1, 0, 0, openH)
            end
        end
        local function build()
            for _, it in pairs(items) do it.btn:Destroy() end
            items = {}
            for i, o in ipairs(options) do
                local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.white,
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ITEM), LayoutOrder = i,
                    ClipsDescendants = true}, itemsF)
                round(b, 10)
                local lbl = text(b, o.label, 12, Enum.Font.GothamMedium, {Position = UDim2.fromOffset(16, 0),
                    Size = UDim2.new(1, -28, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd, TextTransparency = 0.35})
                local fire = rippleOn(b, C.glow, 0.55)
                items[o.id] = {btn = b, lbl = lbl, index = i}
                if not TOUCH then
                    b.MouseEnter:Connect(function()
                        if o.id ~= cur.id then tw(b, 0.15, {BackgroundTransparency = 0.93}) end
                    end)
                    b.MouseLeave:Connect(function() tw(b, 0.15, {BackgroundTransparency = 1}) end)
                end
                b.MouseButton1Click:Connect(function()
                    fire()
                    local changed = (cur.id ~= o.id)
                    cur = o
                    b.BackgroundTransparency = 1
                    setVal(o.label)
                    paint(true, changed)
                    task.delay(0.18, function() if opened then close() end end)  -- ให้เห็นไฮไลต์ไหลก่อนปิด
                    if changed and cb then task.spawn(cb, o.id) end
                end)
            end
            paint(false, true)
        end
        build()
        sizes()

        row.MouseButton1Click:Connect(function()
            if opened then close() return end
            opened = true
            list.Visible = true
            tw(wrap, 0.34, {Size = UDim2.new(1, 0, 0, openH)}, Enum.EasingStyle.Quint)
            tw(list, 0.34, {Size = UDim2.new(1, 0, 0, listH)}, Enum.EasingStyle.Quint)
            tw(arrow, 0.38, {Rotation = 270}, Enum.EasingStyle.Back)
            tw(chip, 0.2, {BackgroundTransparency = 0})
            tw(chipStroke, 0.2, {Transparency = 0.15})
            tw(rs, 0.2, {Color = C.glow, Transparency = 0.2})
            -- รายการไหลเข้ามาทีละบรรทัด
            if not REDUCED_MOTION then
                for id, it in pairs(items) do
                    local target = (id == cur.id) and 0 or 0.35
                    it.lbl.Position = UDim2.fromOffset(32, 0)
                    it.lbl.TextTransparency = 1
                    task.delay(0.04 + it.index * 0.03, function()
                        if it.lbl.Parent then
                            tw(it.lbl, 0.32, {Position = UDim2.fromOffset(16, 0), TextTransparency = target}, Enum.EasingStyle.Quint)
                        end
                    end)
                end
            end
        end)
        interact(row, BASE,
            function() if not opened then tw(rs, 0.2, {Transparency = 0.25}) end end,
            function() if not opened then tw(rs, 0.2, {Transparency = 0.5}) end end)

        return {
            Get = function() return cur.id end,
            IsOpen = function() return opened end,
            -- เปลี่ยนรายการ (เช่นรายชื่อบอส) ถ้าตัวที่เลือกอยู่หายไป จะกลับไปตัวแรกและเรียก cb
            -- เลือกค่าจากโค้ด (เช่นตอนโหลดคอนฟิก) silent = true ไม่เรียก cb
            Set = function(id, silent)
                for _, o in ipairs(options) do
                    if o.id == id then
                        local changed = cur.id ~= o.id
                        cur = o
                        setVal(o.label)
                        paint(false, changed)
                        if changed and cb and not silent then task.spawn(cb, o.id) end
                        return true
                    end
                end
                return false
            end,
            SetOptions = function(newOpts)
                options = newOpts
                if #options == 0 then options = {{id = "", label = "-"}} end
                local keep
                for _, o in ipairs(options) do if o.id == cur.id then keep = o end end
                local lost = keep == nil
                cur = keep or options[1]
                setVal(cur.label)
                build()
                sizes()
                if lost and cb then task.spawn(cb, cur.id) end
            end,
        }
    end

