    -- ดรอปดาวน์เลือกได้หลายอัน: MultiDropdown(page, "หัวข้อ", {{id=,label=},...}, {id=true,...}, function(set) ... end)
    -- cb ได้ตาราง {id = true} ของที่เลือกทั้งหมด
    local function MultiDropdown(page, title, options, defaults, cb)
        local ROW, ITEM, GAP, PAD, MAXLIST = 46, 32, 4, 6, 196
        local BASE = 0.3
        local sel = {}
        for k, v in pairs(defaults or {}) do
            if type(k) == "number" then sel[v] = true elseif v then sel[k] = true end
        end
        local opened, listH, openH = false, 0, 0

        local wrap, inner = item(page, ROW)
        local row = new("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, ROW)}, inner)
        glass(row, 13, BASE, T.surfTop, T.surfBot, 90)
        local rs = rim(row, C.blue, 1.2, 0.5)
        sheen(row, 13, 0.88)
        text(row, title, 10, Enum.Font.GothamBold, {Position = UDim2.fromOffset(15, 7),
            Size = UDim2.new(1, -60, 0, 12), TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = C.glow, TextTransparency = 0.15})
        local val = text(row, "", 13, Enum.Font.GothamBold, {Position = UDim2.fromOffset(15, 21),
            Size = UDim2.new(1, -60, 0, 18), TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd})
        local chip = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(28, 28), BackgroundColor3 = C.white, BackgroundTransparency = 0.7, BorderSizePixel = 0}, row)
        pill(chip)
        grad(chip, C.blue, C.deep, 90)
        local chipStroke = stroke(chip, C.glow, 1.1, 0.7)
        local arrow = text(chip, ">", 14, Enum.Font.GothamBold, {Size = UDim2.fromScale(1, 1), Rotation = 90})

        local list = new("ScrollingFrame", {Position = UDim2.fromOffset(0, ROW + 6), Size = UDim2.new(1, 0, 0, 0),
            BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = C.bright, Visible = false,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ClipsDescendants = true}, inner)
        glass(list, 12, 0.18, T.surfTop, T.surfBot, 90)
        rim(list, C.blue, 1.1, 0.4)
        new("UIPadding", {PaddingTop = UDim.new(0, PAD), PaddingBottom = UDim.new(0, PAD),
            PaddingLeft = UDim.new(0, PAD), PaddingRight = UDim.new(0, PAD)}, list)
        local itemsF = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, ZIndex = 2}, list)
        new("UIListLayout", {Padding = UDim.new(0, GAP), SortOrder = Enum.SortOrder.LayoutOrder}, itemsF)

        local function summary()
            local names = {}
            for _, o in ipairs(options) do if sel[o.id] then names[#names + 1] = o.label end end
            if #names == 0 then return "ยังไม่ได้เลือก" end
            if #names == 1 then return names[1] end
            return #names .. " รายการ: " .. table.concat(names, ", ")
        end
        local function emit()
            if not cb then return end
            local copy = {}
            for k in pairs(sel) do copy[k] = true end
            task.spawn(cb, copy)
        end

        local items = {}
        local function paintItem(it, on, anim)
            local d = anim and 0.18 or 0
            tw(it.lbl, d, {TextTransparency = on and 0 or 0.35})
            tw(it.box, d, {BackgroundTransparency = on and 0 or 0.8})
            tw(it.boxStroke, d, {Transparency = on and 0.1 or 0.5})
            tw(it.mark, d, {BackgroundTransparency = on and 0 or 1})
        end
        local function sizes()
            local n = #options
            listH = math.min(n * ITEM + math.max(n - 1, 0) * GAP + PAD * 2, MAXLIST)
            openH = ROW + 6 + listH + 2
            if opened then
                list.Size = UDim2.new(1, 0, 0, listH)
                wrap.Size = UDim2.new(1, 0, 0, openH)
            end
        end
        local function build()
            for _, it in pairs(items) do it.btn:Destroy() end
            items = {}
            for i, o in ipairs(options) do
                local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.white,
                    BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ITEM), LayoutOrder = i,
                    ClipsDescendants = true}, itemsF)
                round(b, 10)
                local lbl = text(b, o.label, 12, Enum.Font.GothamMedium, {Position = UDim2.fromOffset(16, 0),
                    Size = UDim2.new(1, -52, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd, TextTransparency = 0.35})
                -- ช่องติ๊ก: สี่เหลี่ยมกระจก + จุดขาวตอนเลือก
                local box = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                    Size = UDim2.fromOffset(18, 18), BackgroundColor3 = C.blue, BackgroundTransparency = 0.8,
                    BorderSizePixel = 0}, b)
                round(box, 5)
                local boxStroke = stroke(box, C.glow, 1.1, 0.5)
                local mark = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromOffset(8, 8), BackgroundColor3 = C.white, BackgroundTransparency = 1,
                    BorderSizePixel = 0}, box)
                round(mark, 3)
                local fire = rippleOn(b, C.glow, 0.55)
                local it = {btn = b, lbl = lbl, box = box, boxStroke = boxStroke, mark = mark, index = i}
                items[o.id] = it
                if not TOUCH then
                    b.MouseEnter:Connect(function() tw(b, 0.15, {BackgroundTransparency = 0.93}) end)
                    b.MouseLeave:Connect(function() tw(b, 0.15, {BackgroundTransparency = 1}) end)
                end
                b.MouseButton1Click:Connect(function()
                    fire()
                    if sel[o.id] then sel[o.id] = nil else sel[o.id] = true end
                    paintItem(it, sel[o.id] == true, true)
                    val.Text = summary()
                    emit()
                end)
                paintItem(it, sel[o.id] == true, false)
            end
            val.Text = summary()
        end
        build()
        sizes()

        local function close()
            opened = false
            tw(wrap, 0.28, {Size = UDim2.new(1, 0, 0, ROW)}, Enum.EasingStyle.Quint)
            tw(list, 0.28, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quint)
            tw(arrow, 0.34, {Rotation = 90}, Enum.EasingStyle.Back)
            tw(chip, 0.2, {BackgroundTransparency = 0.7})
            tw(chipStroke, 0.2, {Transparency = 0.7})
            tw(rs, 0.2, {Color = C.blue, Transparency = 0.5})
            task.delay(0.29, function() if not opened then list.Visible = false end end)
        end
        row.MouseButton1Click:Connect(function()
            if opened then close() return end
            opened = true
            list.Visible = true
            tw(wrap, 0.34, {Size = UDim2.new(1, 0, 0, openH)}, Enum.EasingStyle.Quint)
            tw(list, 0.34, {Size = UDim2.new(1, 0, 0, listH)}, Enum.EasingStyle.Quint)
            tw(arrow, 0.38, {Rotation = 270}, Enum.EasingStyle.Back)
            tw(chip, 0.2, {BackgroundTransparency = 0})
            tw(chipStroke, 0.2, {Transparency = 0.15})
            tw(rs, 0.2, {Color = C.glow, Transparency = 0.2})
            if not REDUCED_MOTION then
                for id, it in pairs(items) do
                    local target = sel[id] and 0 or 0.35
                    it.lbl.Position = UDim2.fromOffset(32, 0)
                    it.lbl.TextTransparency = 1
                    task.delay(0.04 + math.min(it.index, 12) * 0.03, function()
                        if it.lbl.Parent then
                            tw(it.lbl, 0.32, {Position = UDim2.fromOffset(16, 0), TextTransparency = target}, Enum.EasingStyle.Quint)
                        end
                    end)
                end
            end
        end)
        interact(row, BASE,
            function() if not opened then tw(rs, 0.2, {Transparency = 0.25}) end end,
            function() if not opened then tw(rs, 0.2, {Transparency = 0.5}) end end)

        return {
            Get = function()
                local copy = {}
                for k in pairs(sel) do copy[k] = true end
                return copy
            end,
            Set = function(tbl, silent)
                sel = {}
                for k, v in pairs(tbl or {}) do
                    if type(k) == "number" then sel[v] = true elseif v then sel[k] = true end
                end
                for id, it in pairs(items) do paintItem(it, sel[id] == true, true) end
                val.Text = summary()
                if not silent then emit() end
            end,
            SetOptions = function(newOpts)
                options = newOpts
                build()
                sizes()
            end,
        }
    end

    -- แจ้งเตือนด้านบนจอ (ซ้อนกันได้หลายอัน มีแถบเวลานับถอยหลัง)
    local toastHost = new("Frame", {AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20),
        Size = UDim2.fromOffset(310, 300), BackgroundTransparency = 1, ZIndex = 50}, gui)
    new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center}, toastHost)

    local function Toast(msg)
        local slot = new("Frame", {Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, LayoutOrder = ord()}, toastHost)
        local card = new("Frame", {Position = UDim2.fromOffset(0, -16), Size = UDim2.new(1, 0, 0, 44)}, slot)
        glass(card, 12, 0.12, T.headTop, T.headBot, 90)
        card.BackgroundTransparency = 1
        local cs = rim(card, C.glow, 1.4, 1)
        local sh = sheen(card, 12, 0.85)
        sh.BackgroundTransparency = 1
        local logo = new("ImageLabel", {Image = HEAD_LOGO, BackgroundTransparency = 1, ImageTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0), Size = UDim2.fromOffset(26, 26),
            ScaleType = Enum.ScaleType.Fit}, card)
        local lbl = text(card, msg, 12, Enum.Font.GothamBold, {Position = UDim2.fromOffset(42, 0),
            Size = UDim2.new(1, -52, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            TextTransparency = 1})
        local prog = new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -3),
            Size = UDim2.new(1, -24, 0, 2), BackgroundColor3 = C.glow, BackgroundTransparency = 0.3, BorderSizePixel = 0}, card)
        pill(prog)

        tw(slot, 0.3, {Size = UDim2.new(1, 0, 0, 44)}, Enum.EasingStyle.Quint)
        tw(card, 0.4, {Position = UDim2.fromOffset(0, 0), BackgroundTransparency = alpha(0.12)}, Enum.EasingStyle.Back)
        tw(cs, 0.3, {Transparency = 0.15})
        tw(sh, 0.3, {BackgroundTransparency = 0})
        tw(logo, 0.3, {ImageTransparency = 0})
        tw(lbl, 0.3, {TextTransparency = 0})
        tw(prog, 2.4, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)

        task.delay(2.4, function()
            if not slot.Parent then return end
            prog.Visible = false
            tw(card, 0.25, {Position = UDim2.fromOffset(0, -12), BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tw(cs, 0.25, {Transparency = 1})
            tw(sh, 0.25, {BackgroundTransparency = 1})
            tw(logo, 0.25, {ImageTransparency = 1})
            tw(lbl, 0.25, {TextTransparency = 1})
            task.delay(0.2, function()
                if slot.Parent then tw(slot, 0.25, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quint) end
            end)
            task.delay(0.5, function() slot:Destroy() end)
        end)
    end

    --========== Discord ==========
    local dc = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, 40), ClipsDescendants = true}, sidePanel)
    glass(dc, 11, 0.1, T.dc1, T.dc2, 90)
    local dcStroke = rim(dc, C.glow, 1.3, 0.2)
    sheen(dc, 11, 0.75)
    new("ImageLabel", {Image = DISCORD, BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24),
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ScaleType = Enum.ScaleType.Fit}, dc)
    text(dc, "DISCORD", 12, Enum.Font.GothamBlack, {Position = UDim2.fromOffset(37, 0),
        Size = UDim2.new(1, -40, 1, 0), TextXAlignment = Enum.TextXAlignment.Left})
    interact(dc, 0.1,
        function() tw(dcStroke, 0.15, {Transparency = 0}) end,
        function() tw(dcStroke, 0.15, {Transparency = 0.2}) end)
    local dcRipple = rippleOn(dc)
    dc.MouseButton1Click:Connect(function()
        dcRipple()
        local ok = pcall(function() (setclipboard or toclipboard)(INVITE) end)
        Toast(ok and "คัดลอกลิงก์ Discord แล้ว" or INVITE)
    end)

    --========== ปุ่มลอย ==========
    local isOpen, animId = true, 0
    local float = new("ImageButton", {Image = LOGO, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 14 + FLOAT_SIZE / 2, 0.5, 0), Size = UDim2.fromOffset(FLOAT_SIZE, FLOAT_SIZE), Visible = false,
        ScaleType = Enum.ScaleType.Fit, ZIndex = 100}, gui)
    -- แสดงเฉพาะโลโก้ ไม่มีพื้นหลัง/ขอบ
    float.BackgroundTransparency = 1
    float.BorderSizePixel = 0
    float.AutoButtonColor = false
    local floatScale = new("UIScale", {}, float)
    if not TOUCH then
        float.MouseEnter:Connect(function()
            springStop(floatScale)
            tw(floatScale, 0.2, {Scale = 1.07}, Enum.EasingStyle.Back)
        end)
        float.MouseLeave:Connect(function()
            springStop(floatScale)
            tw(floatScale, 0.2, {Scale = 1})
        end)
    end
    float.MouseButton1Down:Connect(function()
        springStop(floatScale)
        tw(floatScale, 0.1, {Scale = 0.9})
        UIS.InputEnded:Once(function()
            if float.Visible and not isOpen then springTo(floatScale, "Scale", 1, 3.2, 0.3) end
        end)
    end)

    --========== เอฟเฟกต์น้ำ ==========
    -- คลื่นฟองที่ผิวน้ำ: วงกลมเรียงเป็นแถว ขยับขึ้นลงคนละจังหวะ (อยู่ใน popper จึงเด้งไปพร้อมหน้าต่าง)
    local wave = new("Frame", {Position = UDim2.fromOffset(0, H), Size = UDim2.fromOffset(W, 0),
        BackgroundTransparency = 1, Visible = false, ZIndex = 5}, popper)
    local crest = {}
    local CREST_N = 15
    for k = 1, CREST_N do
        local d = 30 + (k % 3) * 8
        local x = 16 + (k - 1) * (W - 32) / (CREST_N - 1)
        local b = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, 0),
            Size = UDim2.fromOffset(d, d), BackgroundColor3 = (k % 2 == 0) and C.glow or C.bright,
            BackgroundTransparency = 1, BorderSizePixel = 0}, wave)
        pill(b)
        grad(b, C.white, Color3.fromRGB(190, 215, 255), 90)
        crest[k] = {f = b, x = x, ph = k * 0.9}
    end
    local surf = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = C.white, BackgroundTransparency = 1, BorderSizePixel = 0}, wave)
    new("UIGradient", {Transparency = NS(0, 1, 0.12, 0, 0.88, 0, 1, 1)}, surf)

    local waveOn = false
    bind(RS.Heartbeat, function()
        if not waveOn then return end
        local h = clip.Size.Y.Offset
        local p = math.clamp((h - M) / H, 0, 1)                      -- 0 = น้ำอยู่ขอบล่าง, 1 = ขอบบน
        local fade = math.clamp(math.min(p / 0.08, (1 - p) / 0.15), 0, 1)
        wave.Position = UDim2.fromOffset(0, H + M - h)
        local tt = os.clock()
        for _, c in ipairs(crest) do
            local y = math.sin(tt * 7 + c.ph) * 5 + math.sin(tt * 3.1 + c.ph * 1.7) * 3
            c.f.Position = UDim2.fromOffset(c.x, y)
            c.f.BackgroundTransparency = 1 - 0.5 * fade
        end
        surf.BackgroundTransparency = 1 - 0.8 * fade
    end)
    local function setWave(on)
        waveOn = on
        wave.Visible = on
    end

    -- ฟองอากาศลอยขึ้นในหน้าต่าง
    local function bubbles(n)
        for _ = 1, n do
            task.delay(math.random() * 0.5, function()
                if not gui.Parent then return end
                local sz = math.random(4, 10)
                local x = math.random(20, W - 20)
                local b = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, H + 6),
                    Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = C.white, BackgroundTransparency = 0.85,
                    BorderSizePixel = 0, ZIndex = 6}, main)
                pill(b)
                local bs = stroke(b, C.white, 1, 0.45)
                local dur = 0.7 + math.random() * 0.6
                tw(b, dur, {Position = UDim2.fromOffset(x + math.random(-14, 14), H - math.random(90, 240))}, Enum.EasingStyle.Sine)
                task.delay(dur * 0.6, function()
                    if b.Parent then
                        tw(b, dur * 0.4, {BackgroundTransparency = 1})
                        tw(bs, dur * 0.4, {Transparency = 1})
                    end
                end)
                task.delay(dur + 0.05, function() b:Destroy() end)
            end)
        end
    end

    -- หยดน้ำ (กลมเรืองแสง + จุดสะท้อนแสง)
    local function makeDrop(pos, s)
        local d = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(s, s),
            BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 95}, gui)
        pill(d)
        grad(d, C.glow, C.blue, 120)
        stroke(d, C.glow, 3, 0.45)
        local hi = new("Frame", {Position = UDim2.fromScale(0.2, 0.15), Size = UDim2.fromScale(0.32, 0.32),
            BackgroundColor3 = C.white, BackgroundTransparency = 0.2, BorderSizePixel = 0}, d)
        pill(hi)
        return d
    end

    -- บินตามเส้นโค้ง (bezier) จาก a ไป b
    local function fly(o, a, b, dur, arc, done)
        local ctrl = a:Lerp(b, 0.5) + UDim2.fromOffset(0, -arc)
        local t0 = os.clock()
        local c
        c = bind(RS.Heartbeat, function()
            if not o.Parent then c:Disconnect() return end
            local t = math.min((os.clock() - t0) / dur, 1)
            local e = t < 0.5 and 2 * t * t or 1 - ((-2 * t + 2) ^ 2) / 2
            o.Position = a:Lerp(ctrl, e):Lerp(ctrl:Lerp(b, e), e)
            if t >= 1 then
                c:Disconnect()
                if done then done() end
            end
        end)
    end

    -- หยดน้ำกระทบแล้วแตก
    local function burst(d, s)
        tw(d, 0.08, {Size = UDim2.fromOffset(s * 1.7, s * 0.5), BackgroundTransparency = 1})
        task.delay(0.1, function() d:Destroy() end)
    end

    -- น้ำกระเซ็น: วงคลื่นขยายหลายวง + ละอองกระจาย
    local function splash(pos, maxSize, rings)
        for k = 1, rings or 3 do
            task.delay((k - 1) * 0.08, function()
                if not gui.Parent then return end
                local sz = maxSize * (1 - (k - 1) * 0.18)
                local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(14, 14),
                    BackgroundTransparency = 1, ZIndex = 90}, gui)
                pill(r)
                local s = stroke(r, k == 1 and C.white or C.glow, 3, 0.1)
                tw(r, 0.75, {Size = UDim2.fromOffset(sz, sz)}, Enum.EasingStyle.Quint)
                tw(s, 0.75, {Transparency = 1, Thickness = 0.5})
                task.delay(0.8, function() r:Destroy() end)
            end)
        end
        for k = 1, 8 do
            local ang = (k / 8) * math.pi * 2 + math.random() * 0.4
            local dist = maxSize * (0.22 + math.random() * 0.15)
            local d = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(7, 7),
                BackgroundColor3 = C.glow, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 91}, gui)
            pill(d)
            tw(d, 0.5, {Position = pos + UDim2.fromOffset(math.cos(ang) * dist, math.sin(ang) * dist * 0.7),
                Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
            task.delay(0.55, function() d:Destroy() end)
        end
    end

    -- แสงวาบที่ขอบหน้าต่างตอนเปิดเสร็จ
    local function flashEdge()
        if REDUCED_MOTION then return end
        if haloLoop then haloLoop:Cancel() end
        halo.Transparency = 0.3
        tw(halo, 0.9, {Transparency = 0.88})
        tw(edge, 0.12, {Thickness = 3.6})
        task.delay(0.12, function() if gui.Parent then tw(edge, 0.6, {Thickness = 2.2}) end end)
        task.delay(0.92, function() if gui.Parent then haloIdle() end end)
    end

    -- เบลอฉากเกมด้านหลัง (เฉพาะฝั่งผู้เล่น ลบเองเมื่อลบ UI)
    local blur = USE_BLUR and new("BlurEffect", {Name = "JustHubBlur", Size = 0}, Lighting) or nil
    local function setBlur(on)
        if blur and blur.Parent then tw(blur, on and 0.6 or 0.4, {Size = on and BLUR_SIZE or 0}) end
    end

    --========== open / close ==========
    local FX = WATER_FX and not REDUCED_MOTION

    local function showFloat()
        float.Visible = true
        springTo(floatScale, "Scale", 1, 3, 0.3, 0.01)
    end

    -- น้ำเติมหน้าต่างจากล่างขึ้นบน + เด้งเยลลี่ + ฟอง แล้วน้ำไหลลงจากกระจก
    local function fillIn(alive)
        holder.Visible = true
        clip.Size = UDim2.fromOffset(W + M * 2, 0)
        setWave(true)
        springTo(pop, "Scale", 1, 2.4, 0.36, 0.84)
        wet.Visible = true
        wet.Position = UDim2.fromScale(0, 0)
        wet.BackgroundTransparency = 0.55
        bubbles(14)
        stagger(pages[current], 0.45)
        tw(clip, 0.8, {Size = UDim2.fromOffset(W + M * 2, FULL)}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
        task.delay(0.8, function()
            if not alive() then return end
            setWave(false)
            flashEdge()
            tw(wet, 0.7, {Position = UDim2.fromScale(0, 1), BackgroundTransparency = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.72, function() if alive() then wet.Visible = false end end)
        end)
    end

    local function setOpen(v)
        isOpen = v
        animId = animId + 1
        local id = animId
        local function alive() return animId == id and gui.Parent ~= nil end
        setBlur(v)

        -- โหมดเร็ว (ปิดเอฟเฟกต์น้ำ หรือผู้เล่นเปิด "ลดการเคลื่อนไหว")
        if not FX then
            springStop(pop)
            setWave(false)
            wet.Visible = false
            clip.Size = UDim2.fromOffset(W + M * 2, FULL)
            if v then
                holder.Visible = true
                float.Visible = false
                pop.Scale = 0.6
                tw(pop, REDUCED_MOTION and 0 or 0.4, {Scale = 1}, Enum.EasingStyle.Back)
            else
                tw(pop, REDUCED_MOTION and 0 or 0.22, {Scale = 0.6}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                task.delay(REDUCED_MOTION and 0 or 0.23, function()
                    if alive() then
                        holder.Visible = false
                        float.Visible = true
                        floatScale.Scale = 1
                    end
                end)
            end
            return
        end

        if v then
            -- เปิด: หยดน้ำบินจากปุ่มลอย (หรือหยดลงจากด้านบนตอนรันครั้งแรก) -> กระเซ็น -> น้ำเติม
            local fromFloat = float.Visible
            local s = 26 * scale.Scale
            local fromPos = fromFloat and float.Position or (holder.Position + UDim2.fromOffset(0, -170 * scale.Scale))
            if fromFloat then
                springStop(floatScale)
                tw(floatScale, 0.16, {Scale = 0.01}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                task.delay(0.16, function() if alive() then float.Visible = false end end)
            end
            local drop = makeDrop(fromPos, s)
            tw(drop, 0.3, {Size = UDim2.fromOffset(s * 0.75, s * 1.35)})
            fly(drop, fromPos, holder.Position, 0.34, fromFloat and 90 * scale.Scale or 0, function()
                burst(drop, s)
                if not alive() then return end
                splash(holder.Position, math.max(W, H) * scale.Scale * 0.95, 3)
                fillIn(alive)
            end)
        else
            -- ปิด: น้ำท่วมกระจก -> ระบายลง -> กลายเป็นหยดน้ำบินกลับไปที่ปุ่มลอย
            if not holder.Visible then
                showFloat()
                return
            end
            springStop(pop)
            setWave(true)
            wet.Visible = true
            tw(wet, 0.2, {Position = UDim2.fromScale(0, 0), BackgroundTransparency = 0.55})
            bubbles(6)
            tw(clip, 0.5, {Size = UDim2.fromOffset(W + M * 2, 0)}, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
            tw(pop, 0.5, {Scale = 0.94}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.5, function()
                if not alive() then return end
                setWave(false)
                holder.Visible = false
                wet.Visible = false
                local s = 24 * scale.Scale
                local fromPos = holder.Position + UDim2.fromOffset(0, H / 2 * scale.Scale * 0.94)
                local drop = makeDrop(fromPos, s)
                tw(drop, 0.3, {Size = UDim2.fromOffset(s * 0.75, s * 1.35)})
                fly(drop, fromPos, float.Position, 0.38, 110 * scale.Scale, function()
                    burst(drop, s)
                    if not alive() then return end
                    splash(float.Position, FLOAT_SIZE * 1.6, 2)
                    showFloat()
                end)
            end)
        end
    end

    closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)
    drag(float, float, function() setOpen(true) end)
    drag(header, holder)
    bind(UIS.InputBegan, function(i, gp)
        if not gp and i.KeyCode == Enum.KeyCode.RightControl then setOpen(not isOpen) end
    end)

    -- ลบ UI แล้วเก็บกวาดทุกอย่าง (connection, blur, ฟังก์ชันที่ลงทะเบียนไว้)
    local destroyHooks = {}
    gui.Destroying:Connect(function()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        if blur then pcall(function() blur:Destroy() end) end
        for _, fn in ipairs(destroyHooks) do pcall(fn) end
    end)

    return {
        gui = gui,
        addTab = addTab, showPage = showPage, setOpen = setOpen,
        Label = Label, Note = Note, StatusRow = StatusRow, Toggle = Toggle,
        Dropdown = Dropdown, MultiDropdown = MultiDropdown, Slider = Slider, Input = Input,
        Button = Button, Toast = Toast,
        onDestroy = function(fn) destroyHooks[#destroyHooks + 1] = fn end,
    }
end
