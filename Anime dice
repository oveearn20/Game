    JH.Button(p, "เลือกเฉพาะไอเทมที่มีในคลัง", function()
        local owned, count = {}, 0
        pcall(function()
            local inv = DataController.Inventory and DataController.Inventory()
            if type(inv) ~= "table" then return end
            for _, it in pairs(inv) do
                if type(it) == "table" and it.name and (tonumber(it.amount) or 0) > 0 then
                    local cfg = EntryRegistry.getEntryConfig(it.name)
                    if cfg and cfg.kind == "Boost" and not owned[it.name] then
                        owned[it.name] = true
                        count = count + 1
                    end
                end
            end
        end)
        -- ไอเทมที่มีแต่ไม่อยู่ในรายการ: เพิ่มเข้ารายการให้เห็น
        local known, added = {}, false
        for _, n in ipairs(boostNames) do known[n] = true end
        for n in pairs(owned) do
            if not known[n] then table.insert(boostNames, n) added = true end
        end
        if added then
            table.sort(boostNames)
            Refs.SelectedItems.SetOptions(opts(boostNames))
        end
        State.SelectedItems = owned
        Refs.SelectedItems.Set(owned, true)
        Toast("เลือกไอเทมที่มีในคลัง " .. count .. " ชนิด")
    end)
    JH.Button(p, "ยกเลิกที่เลือกทั้งหมด", function()
        State.SelectedItems = {}
        Refs.SelectedItems.Set({}, true)
        Toast("ล้างรายการไอเทมแล้ว")
    end)
    JH.Button(p, "ใช้ที่เลือกทันที 1 ครั้ง", function()
        local n = useSelectedItemsNow()
        Toast(n > 0 and ("ใช้ไอเทมสำเร็จ " .. n .. " ชนิด") or "ไม่มีไอเทมที่เลือกในคลัง")
    end)
end

--========== Upgrade: เกรด ==========
do
    local p = pUp
    local function unitOptions()
        local list = {}
        pcall(function()
            local inv = DataController.Inventory and DataController.Inventory()
            if not inv then return end
            for id, it in pairs(inv) do
                if type(it) == "table" and it.name then
                    local cfg = EntryRegistry.getEntryConfig(it.name)
                    if cfg and cfg.kind == "Unit" then
                        local grade = (it.attributes and it.attributes.grade) or "D"
                        local lvl = (it.attributes and it.attributes.level) or 1
                        list[#list + 1] = {id = id, label = string.format("%s [Lv.%s | %s] #%s",
                            it.name, tostring(lvl), grade, string.sub(tostring(id), 1, 4))}
                    end
                end
            end
        end)
        table.sort(list, function(a, b) return a.label < b.label end)
        if #list == 0 then list[1] = {id = "", label = "ไม่พบตัวละครในคลัง"} end
        return list
    end

    JH.Label(p, "รีเกรดอัตโนมัติ (REROLL)")
    JH.Note(p, "ใช้ 1 Gem ต่อการสุ่ม 1 ครั้ง ระบบหยุดเองเมื่อได้เกรดเป้าหมายหรือ Gem หมด")
