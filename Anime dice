    for _, parent in ipairs({PG, GUI_PARENT}) do
        local old = parent:FindFirstChild("JustHubLite")
        if old then old:Destroy() end
    end
    local oldBlur = Lighting:FindFirstChild("JustHubBlur")
    if oldBlur then oldBlur:Destroy() end

    local LOGO      = "rbxassetid://87977664474407"  -- โลโก้ปุ่มลอย
    local HEAD_LOGO = "rbxassetid://88803597067423"  -- โลโก้มุมซ้ายบนของเมนู
    local DISCORD   = "rbxassetid://97396797065904"
    local INVITE    = "https://discord.gg/eR5kKvYEs8"

    local FLOAT_SIZE = 100  -- ขนาดปุ่มลอย (ปรับเลขนี้ได้)

    -- ตั้งค่ากระจก (ปรับได้)
    local GLASS_ALPHA = 0.22  -- ความโปร่งของหน้าต่างหลัก: 0 = ทึบ, 1 = ใสหมด
    local USE_BLUR    = true  -- เบลอฉากเกมด้านหลังขณะเปิดเมนู
    local BLUR_SIZE   = 14    -- ความแรงของเบลอ (0-56)
    local WATER_FX    = true  -- เอฟเฟกต์น้ำตอนเปิด/ปิด (false = เปิดปิดแบบเร็ว)

    local W, H = 480, 320

    local C = {
        black  = Color3.fromRGB(2, 3, 10),
        navy   = Color3.fromRGB(7, 14, 38),
        deep   = Color3.fromRGB(12, 26, 70),
        blue   = Color3.fromRGB(40, 105, 245),
        bright = Color3.fromRGB(70, 150, 255),
        glow   = Color3.fromRGB(110, 185, 255),
        white  = Color3.fromRGB(255, 255, 255),
        dc     = Color3.fromRGB(70, 85, 230),
    }

    -- โทนสีของพื้นผิวทุกชิ้น (สร้างจากสีแบรนด์เดิม ใช้ชุดเดียวกันทั้ง UI)
    local T = {
        winTop   = Color3.fromRGB(10, 20, 55),    -- หน้าต่างหลัก (สีเดิม)
        headTop  = Color3.fromRGB(16, 38, 100),   -- หัวเมนู / แจ้งเตือน (สีเดิม)
        headBot  = Color3.fromRGB(4, 8, 24),
        surfTop  = Color3.fromRGB(14, 30, 74),    -- แถวปุ่ม / ดรอปดาวน์ / สถานะ / sidebar
        surfBot  = Color3.fromRGB(5, 10, 28),
        offTrack = Color3.fromRGB(18, 30, 66),    -- สวิตช์ตอนปิด
        offKnob  = Color3.fromRGB(130, 160, 210),
        danger1  = Color3.fromRGB(200, 40, 90),   -- ปุ่มอันตราย (สีเดิม)
        danger2  = Color3.fromRGB(70, 10, 30),
        dangerE  = Color3.fromRGB(255, 120, 160),
        dc1      = Color3.fromRGB(95, 110, 255),  -- ปุ่ม Discord (สีเดิม)
        dc2      = Color3.fromRGB(20, 28, 100),
        close    = Color3.fromRGB(210, 40, 90),   -- ปุ่ม X ตอนชี้ (สีเดิม)
    }

    -- การตั้งค่าการเข้าถึงของผู้เล่น (ถ้าไม่มี property นี้ จะใช้ค่าปกติ)
    local REDUCED_MOTION, PREF_T = false, 1
    pcall(function() REDUCED_MOTION = GS.ReducedMotionEnabled == true end)
    pcall(function() PREF_T = math.clamp(tonumber(GS.PreferredTransparency) or 1, 0, 1) end)
    local TOUCH = UIS.TouchEnabled and not UIS.MouseEnabled  -- มือถือ: ไม่ใช้เอฟเฟกต์ hover กันค้าง


    --========== helpers ==========
    local conns = {}
    local function bind(signal, fn)
        local c = signal:Connect(fn)
        conns[#conns + 1] = c
        return c
    end

    local function new(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do o[k] = v end
        o.Parent = parent
        return o
    end
    local function round(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 10)}, o) end
    local function pill(o) return new("UICorner", {CornerRadius = UDim.new(0.5, 0)}, o) end
    local function stroke(o, col, th, tr) return new("UIStroke", {Color = col or C.bright, Thickness = th or 1.2, Transparency = tr or 0.4}, o) end
    local function grad(o, c1, c2, rot) return new("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 90}, o) end
    local function tw(o, t, p, style, dir)
        local tween = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), p)
        tween:Play()
        return tween
    end
    local function text(parent, str, size, font, props)
        local t = new("TextLabel", {Text = str, TextSize = size, Font = font or Enum.Font.GothamBold,
            TextColor3 = C.white, BackgroundTransparency = 1}, parent)
        for k, v in pairs(props or {}) do t[k] = v end
        return t
    end

    -- NumberSequence แบบย่อ: NS(เวลา, ค่า, เวลา, ค่า, ...) เวลาต้องเริ่ม 0 และจบ 1
    local function NS(...)
        local a, kp = {...}, {}
        for i = 1, #a, 2 do kp[#kp + 1] = NumberSequenceKeypoint.new(a[i], a[i + 1]) end
        return NumberSequence.new(kp)
    end

    -- แอนิเมชันวนไม่รู้จบ (ปิดเองเมื่อผู้เล่นเปิด "ลดการเคลื่อนไหว")
    local function loop(o, t, p, style, reverses)
        if REDUCED_MOTION then return end
        local tween = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut,
            -1, reverses ~= false), p)
        tween:Play()
        return tween
    end

    -- ความโปร่งของกระจก ปรับตามการตั้งค่าความโปร่งใสของผู้เล่น
    local function alpha(a) return math.max(a, 0) * PREF_T end

    -- ลำดับใน UIListLayout ให้ตรงลำดับที่สร้างเสมอ
    local orderN = 0
    local function ord() orderN = orderN + 1 return orderN end

    -- พื้นผิวกระจก: สีโปร่งแสง + ไล่สี
    local function glass(o, r, a, c1, c2, rot)
        o.BackgroundColor3 = C.white
        o.BackgroundTransparency = alpha(a)
        o.BorderSizePixel = 0
        round(o, r)
        return grad(o, c1, c2, rot)
    end

    -- ขอบกระจก: สว่างด้านบน จางตรงกลาง สะท้อนอ่อนด้านล่าง
    local function rim(o, col, th, tr)
        local s = stroke(o, col, th, tr)
        new("UIGradient", {Transparency = NS(0, 0, 0.5, 0.6, 1, 0.3), Rotation = 90}, s)
        return s
    end

    -- แสงสะท้อนครึ่งบนของกระจก (อยู่ใต้ข้อความเสมอ)
    local function sheen(o, r, top)
        local s = new("Frame", {Size = UDim2.new(1, 0, 0.6, 0), BackgroundColor3 = C.white,
            BorderSizePixel = 0, ZIndex = 0}, o)
        round(s, r)
        new("UIGradient", {Transparency = NS(0, top or 0.88, 1, 1), Rotation = 90}, s)
        return s
    end

    -- พื้นผิว "ถูกเลือก" ชุดเดียวกันทั้ง UI (แท็บที่เลือก + ตัวเลือกดรอปดาวน์) คืนแถบขาวด้านซ้าย
    local function activeFill(o, r)
        o.BackgroundColor3 = C.white
        o.BorderSizePixel = 0
        round(o, r)
        grad(o, C.blue, C.deep, 0)
        rim(o, C.glow, 1.2, 0.1)
        sheen(o, r, 0.78)
        local bar = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0),
            Size = UDim2.fromOffset(3, 0), BackgroundColor3 = C.white, BorderSizePixel = 0}, o)
        round(bar, 2)
        return bar
    end

    -- hover + กด สำหรับปุ่มกระจก (เปลี่ยนความทึบของกระจก)
    local function interact(btn, base, enter, leave)
        local hovering = false
        local function bg(v, t) tw(btn, t or 0.15, {BackgroundTransparency = alpha(v)}) end
        if not TOUCH then
            btn.MouseEnter:Connect(function()
                hovering = true
                bg(base - 0.1)
                if enter then enter() end
            end)
            btn.MouseLeave:Connect(function()
                hovering = false
                bg(base)
                if leave then leave() end
            end)
        end
        btn.MouseButton1Down:Connect(function()
            bg(base - 0.22, 0.08)
            UIS.InputEnded:Once(function() bg(hovering and base - 0.1 or base, 0.2) end)
        end)
    end

    -- ripple เริ่มจากจุดที่กด (ปุ่มต้องเปิด ClipsDescendants) คืนฟังก์ชันสำหรับเรียกตอนคลิก
    local function rippleOn(btn, col, tr)
        local lastPos
        btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                lastPos = Vector2.new(i.Position.X, i.Position.Y)
            end
        end)
        return function()
            local rx, ry = 0.5, 0.5
            if lastPos then
                local inset = GS:GetGuiInset()
                local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
                if as.X > 0 and as.Y > 0 then
                    rx = math.clamp((lastPos.X + inset.X - ap.X) / as.X, 0, 1)
                    ry = math.clamp((lastPos.Y + inset.Y - ap.Y) / as.Y, 0, 1)
                end
            end
            local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(rx, ry),
                Size = UDim2.fromScale(0, 0), SizeConstraint = Enum.SizeConstraint.RelativeXX,
                BackgroundColor3 = col or C.white, BackgroundTransparency = tr or 0.6, BorderSizePixel = 0, ZIndex = 3}, btn)
            pill(r)
            tw(r, 0.5, {Size = UDim2.fromScale(2.2, 2.2), BackgroundTransparency = 1})
            task.delay(0.55, function() r:Destroy() end)
        end
    end

    local function drag(handle, target, onTap)
        local dragging, start, origin, moved
        bind(handle.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, moved, start, origin = true, false, i.Position, target.Position
            end
        end)
        bind(UIS.InputChanged, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - start
                if d.Magnitude > 6 then moved = true end
                target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
            end
        end)
        bind(UIS.InputEnded, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
                if not moved and onTap then onTap() end
            end
        end)
    end

    --========== spring (เด้งแบบเยลลี่ ใช้กับ UIScale) ==========
    local springs = {}
    local function springTo(obj, prop, target, freq, damp, from)
        if REDUCED_MOTION then
            springs[obj] = nil
            obj[prop] = target
            return
        end
        local s = springs[obj]
        if not s or s.prop ~= prop then
            s = {prop = prop, x = obj[prop], v = 0}
            springs[obj] = s
        end
        if from then
            s.x, s.v = from, 0
            obj[prop] = from
        end
        s.target, s.f, s.d = target, freq or 3, damp or 0.4
    end
    local function springStop(obj) springs[obj] = nil end
    bind(RS.Heartbeat, function(dt)
        dt = math.min(dt, 1 / 20)
        for o, s in pairs(springs) do
            if not o.Parent then
                springs[o] = nil
            else
                local w, h = 2 * math.pi * s.f, dt / 2
                for _ = 1, 2 do
                    local acc = -w * w * (s.x - s.target) - 2 * s.d * w * s.v
                    s.v = s.v + acc * h
                    s.x = s.x + s.v * h
                end
                if math.abs(s.x - s.target) < 0.0005 and math.abs(s.v) < 0.005 then
                    s.x = s.target
                    springs[o] = nil
                end
                o[s.prop] = s.x
            end
        end
    end)

    --========== root ==========
    local gui = new("ScreenGui", {Name = "JustHubLite", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, GUI_PARENT)

    -- โครงสร้าง: holder (ลาก + ขนาดตามจอ) > popper (เด้ง) > clip (ระดับน้ำ) > win (หน้าต่าง) > main (กระจก)
    local M = 34                 -- ระยะเผื่อรอบหน้าต่าง (ให้เงา/halo ไม่โดนตัด)
    local FULL = H + M * 2       -- ความสูงของ clip ตอนน้ำเต็ม

    local holder = new("Frame", {Name = "Holder", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, H), BackgroundTransparency = 1, Visible = false}, gui)
    local scale = new("UIScale", {}, holder)
    local popper = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1}, holder)
    local pop = new("UIScale", {}, popper)
    local clip = new("Frame", {AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, M),
        Size = UDim2.fromOffset(W + M * 2, FULL), BackgroundTransparency = 1, ClipsDescendants = true}, popper)
