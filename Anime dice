-- Toggle ที่ผูกกับ State[key] (บันทึก/โหลดคอนฟิกได้)
local function stateToggle(page, label, key, onChange)
    local h = JH.Toggle(page, label, State[key] == true, function(v)
        State[key] = v
        if onChange then onChange(v) end
    end)
    Refs[key] = h
    return h
end
-- Slider ที่ผูกกับ State[key]
local function stateSlider(page, label, key, min, max, step, suffix)
    local h = JH.Slider(page, label, min, max, State[key], step, function(v) State[key] = v end, suffix)
    Refs[key] = h
    return h
end
-- {"a", "b"} -> {{id = "a", label = "a"}, ...}
local function opts(list)
    local t = {}
    for i, v in ipairs(list) do t[i] = {id = v, label = v} end
    return t
end
-- แปลง "100m" / "1.5b" / "500k" เป็นตัวเลข
local function parseCompact(s)
    s = tostring(s or ""):gsub("[%s,]", "")
    local n = tonumber(s)
    if n then return n end
    local ok, v = pcall(function() return NumberFormatter.ParseCompact(s) end)
    if ok and tonumber(v) then return tonumber(v) end
    local num, suf = s:match("^([%d%.]+)(%a+)$")
    local mult = {k = 1e3, m = 1e6, b = 1e9, t = 1e12, qd = 1e15}
    if num and mult[suf:lower()] then return tonumber(num) * mult[suf:lower()] end
    return nil
end
local function fmtNum(n)
    local ok, s = pcall(function() return NumberFormatter.FormatCompact(n) end)
    return ok and s or tostring(n)
end

