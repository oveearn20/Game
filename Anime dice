        {id = "always",  label = COND_ALWAYS},
    }, string.find(tostring(State.ItemUseCondition or ""), "Always Use", 1, true) and "always" or "expired", function(id)
        State.ItemUseCondition = (id == "always") and COND_ALWAYS or COND_EXPIRED
    end)
    stateSlider(p, "ความถี่ตรวจไอเทม", "ItemUseInterval", 1, 10, 0.5, " วิ")

