    -- แถบเลื่อนค่าตัวเลข: Slider(page, "ชื่อ", min, max, ค่าเริ่มต้น, ทีละ, function(v) ... end, "หน่วย")
    local function Slider(page, str, min, max, default, step, cb, suffix)
        step = step or 1
        local dec, s = 0, step
        while s < 1 - 1e-9 and dec < 3 do s = s * 10 dec = dec + 1 end
        local fmt = "%." .. dec .. "f"
        local function snap(v)
            v = math.clamp(v, min, max)
            v = min + math.floor((v - min) / step + 0.5) * step
            return tonumber(string.format(fmt, math.clamp(v, min, max)))
        end
        local value = snap(tonumber(default) or min)

        local _, inner = item(page, 54)
        local row = new("Frame", {Size = UDim2.fromScale(1, 1)}, inner)
        glass(row, 11, 0.3, T.surfTop, T.surfBot, 90)
        local rs = rim(row, C.blue, 1.1, 0.5)
        sheen(row, 11, 0.88)
        text(row, str, 12, Enum.Font.GothamBold, {Position = UDim2.fromOffset(12, 7),
            Size = UDim2.new(1, -96, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
        local valLbl = text(row, "", 12, Enum.Font.GothamBlack, {AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -12, 0, 7), Size = UDim2.fromOffset(80, 18), TextXAlignment = Enum.TextXAlignment.Right,
            TextColor3 = C.glow})

        local track = new("Frame", {Position = UDim2.new(0, 14, 0, 34), Size = UDim2.new(1, -28, 0, 8),
            BackgroundColor3 = T.offTrack, BorderSizePixel = 0}, row)
        pill(track)
        stroke(track, C.blue, 1, 0.5)
        local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.white, BorderSizePixel = 0}, track)
        pill(fill)
        grad(fill, C.bright, C.blue, 0)
        local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 2}, track)
        pill(knob)
        grad(knob, C.white, Color3.fromRGB(205, 220, 245), 90)
        stroke(knob, C.glow, 1.2, 0.2)
        -- พื้นที่กดครึ่งล่างของแถว (กดง่ายบนมือถือ)
        local hit = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 1, -24), ZIndex = 3}, row)

        local function render(anim)
            local a = (max > min) and (value - min) / (max - min) or 0
            local d = anim and 0.12 or 0
            tw(fill, d, {Size = UDim2.fromScale(a, 1)})
            tw(knob, d, {Position = UDim2.fromScale(a, 0.5)})
            valLbl.Text = string.format(fmt, value) .. (suffix or "")
        end
        render(false)

        local sliding = false
        local function setFromX(x)
            local ap, as = track.AbsolutePosition.X, track.AbsoluteSize.X
            if as <= 0 then return end
            local v = snap(min + math.clamp((x - ap) / as, 0, 1) * (max - min))
            if v ~= value then
                value = v
                render(false)
                if cb then task.spawn(cb, value) end
            end
        end
        local function inputX(i) return i.Position.X + GS:GetGuiInset().X end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                page.ScrollingEnabled = false  -- กันหน้าเลื่อนตอนลากบนมือถือ
                tw(knob, 0.12, {Size = UDim2.fromOffset(20, 20)})
                tw(rs, 0.15, {Color = C.glow, Transparency = 0.2})
                setFromX(inputX(i))
            end
        end)
        bind(UIS.InputChanged, function(i)
            if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                setFromX(inputX(i))
            end
        end)
        bind(UIS.InputEnded, function(i)
            if sliding and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                sliding = false
                page.ScrollingEnabled = true
                tw(knob, 0.2, {Size = UDim2.fromOffset(16, 16)}, Enum.EasingStyle.Back)
                tw(rs, 0.2, {Color = C.blue, Transparency = 0.5})
            end
        end)

        return {
            Get = function() return value end,
            Set = function(v, silent)
                value = snap(tonumber(v) or value)
                render(true)
                if cb and not silent then task.spawn(cb, value) end
            end,
        }
    end

    -- ช่องพิมพ์ข้อความ: Input(page, "หัวข้อ", ค่าเริ่มต้น, "ข้อความจาง", function(text, enter) ... end)
    -- เรียก cb ตอนพิมพ์เสร็จ (กด Enter หรือแตะที่อื่น)
