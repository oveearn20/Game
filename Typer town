    -- เบลอฉากเกมด้านหลัง (เฉพาะฝั่งผู้เล่น ลบเองเมื่อลบ UI)
    local blur = (USE_BLUR and not TOUCH) and new("BlurEffect", {Name = "JustHubBlur", Size = 0}, Lighting) or nil   -- มือถือไม่เบลอ (หนักเครื่อง + จอมัวตอนฟาม)
    local blurAllowed = true
