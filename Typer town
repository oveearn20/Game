    --========== เอฟเฟกต์น้ำ ==========
    -- คลื่นฟองที่ผิวน้ำ: วงกลมเรียงเป็นแถว ขยับขึ้นลงคนละจังหวะ (อยู่ใน popper จึงเด้งไปพร้อมหน้าต่าง)
    local wave = new("Frame", {Position = UDim2.fromOffset(0, H), Size = UDim2.fromOffset(W, 0),
        BackgroundTransparency = 1, Visible = false, ZIndex = 5}, popper)
    local crest = {}
    local CREST_N = 15
    for k = 1, CREST_N do
        local d = 30 + (k % 3) * 8
        local x = 16 + (k - 1) * (W - 32) / (CREST_N - 1)
        local b = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, 0),
            Size = UDim2.fromOffset(d, d), BackgroundColor3 = (k % 2 == 0) and C.glow or C.bright,
            BackgroundTransparency = 1, BorderSizePixel = 0}, wave)
        pill(b)
        grad(b, C.white, Color3.fromRGB(190, 215, 255), 90)
        crest[k] = {f = b, x = x, ph = k * 0.9}
    end
    local surf = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = C.white, BackgroundTransparency = 1, BorderSizePixel = 0}, wave)
    new("UIGradient", {Transparency = NS(0, 1, 0.12, 0, 0.88, 0, 1, 1)}, surf)

    local waveOn = false
    bind(RS.Heartbeat, function()
        if not waveOn then return end
        local h = clip.Size.Y.Offset
        local p = math.clamp((h - M) / H, 0, 1)                      -- 0 = น้ำอยู่ขอบล่าง, 1 = ขอบบน
        local fade = math.clamp(math.min(p / 0.08, (1 - p) / 0.15), 0, 1)
        wave.Position = UDim2.fromOffset(0, H + M - h)
        local tt = os.clock()
        for _, c in ipairs(crest) do
            local y = math.sin(tt * 7 + c.ph) * 5 + math.sin(tt * 3.1 + c.ph * 1.7) * 3
            c.f.Position = UDim2.fromOffset(c.x, y)
            c.f.BackgroundTransparency = 1 - 0.5 * fade
        end
        surf.BackgroundTransparency = 1 - 0.8 * fade
    end)
    local function setWave(on)
        waveOn = on
        wave.Visible = on
    end

    -- ฟองอากาศลอยขึ้นในหน้าต่าง
    local function bubbles(n)
        for _ = 1, n do
            task.delay(math.random() * 0.5, function()
                if not gui.Parent then return end
                local sz = math.random(4, 10)
                local x = math.random(20, W - 20)
                local b = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, H + 6),
                    Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = C.white, BackgroundTransparency = 0.85,
                    BorderSizePixel = 0, ZIndex = 6}, main)
                pill(b)
                local bs = stroke(b, C.white, 1, 0.45)
                local dur = 0.7 + math.random() * 0.6
                tw(b, dur, {Position = UDim2.fromOffset(x + math.random(-14, 14), H - math.random(90, 240))}, Enum.EasingStyle.Sine)
                task.delay(dur * 0.6, function()
                    if b.Parent then
                        tw(b, dur * 0.4, {BackgroundTransparency = 1})
                        tw(bs, dur * 0.4, {Transparency = 1})
                    end
                end)
                task.delay(dur + 0.05, function() b:Destroy() end)
            end)
        end
    end

    -- หยดน้ำ (กลมเรืองแสง + จุดสะท้อนแสง)
    local function makeDrop(pos, s)
        local d = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(s, s),
            BackgroundColor3 = C.white, BorderSizePixel = 0, ZIndex = 95}, gui)
        pill(d)
        grad(d, C.glow, C.blue, 120)
        stroke(d, C.glow, 3, 0.45)
        local hi = new("Frame", {Position = UDim2.fromScale(0.2, 0.15), Size = UDim2.fromScale(0.32, 0.32),
            BackgroundColor3 = C.white, BackgroundTransparency = 0.2, BorderSizePixel = 0}, d)
        pill(hi)
        return d
    end

    -- บินตามเส้นโค้ง (bezier) จาก a ไป b
    local function fly(o, a, b, dur, arc, done)
        local ctrl = a:Lerp(b, 0.5) + UDim2.fromOffset(0, -arc)
        local t0 = os.clock()
        local c
        c = bind(RS.Heartbeat, function()
            if not o.Parent then c:Disconnect() return end
            local t = math.min((os.clock() - t0) / dur, 1)
            local e = t < 0.5 and 2 * t * t or 1 - ((-2 * t + 2) ^ 2) / 2
            o.Position = a:Lerp(ctrl, e):Lerp(ctrl:Lerp(b, e), e)
            if t >= 1 then
                c:Disconnect()
                if done then done() end
            end
        end)
    end

    -- หยดน้ำกระทบแล้วแตก
    local function burst(d, s)
        tw(d, 0.08, {Size = UDim2.fromOffset(s * 1.7, s * 0.5), BackgroundTransparency = 1})
        task.delay(0.1, function() d:Destroy() end)
    end

    -- น้ำกระเซ็น: วงคลื่นขยายหลายวง + ละอองกระจาย
    local function splash(pos, maxSize, rings)
        for k = 1, rings or 3 do
            task.delay((k - 1) * 0.08, function()
                if not gui.Parent then return end
                local sz = maxSize * (1 - (k - 1) * 0.18)
                local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(14, 14),
                    BackgroundTransparency = 1, ZIndex = 90}, gui)
                pill(r)
                local s = stroke(r, k == 1 and C.white or C.glow, 3, 0.1)
                tw(r, 0.75, {Size = UDim2.fromOffset(sz, sz)}, Enum.EasingStyle.Quint)
                tw(s, 0.75, {Transparency = 1, Thickness = 0.5})
                task.delay(0.8, function() r:Destroy() end)
            end)
        end
        for k = 1, 8 do
            local ang = (k / 8) * math.pi * 2 + math.random() * 0.4
            local dist = maxSize * (0.22 + math.random() * 0.15)
            local d = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(7, 7),
                BackgroundColor3 = C.glow, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 91}, gui)
            pill(d)
            tw(d, 0.5, {Position = pos + UDim2.fromOffset(math.cos(ang) * dist, math.sin(ang) * dist * 0.7),
                Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
            task.delay(0.55, function() d:Destroy() end)
        end
    end

    -- แสงวาบที่ขอบหน้าต่างตอนเปิดเสร็จ
    local function flashEdge()
        if REDUCED_MOTION then return end
