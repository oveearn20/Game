-- เรียกฟังก์ชันแบบกันพัง: error ไม่ทำให้ลูป/สคริปต์ตาย แต่พิมพ์บอกใน console (ไม่เงียบ) จำกัด 1 ครั้ง/5 วิ ต่อชื่อ
RG.errAt = {}
RG.safe = function(name, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and os.clock() - (RG.errAt[name] or -1e9) > 5 then
        RG.errAt[name] = os.clock()
        warn("[CF] " .. name .. " error: " .. tostring(err))
    end
    return ok, err
end

