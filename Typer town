    end

    -- พื้นผิว "ถูกเลือก" ชุดเดียวกันทั้ง UI (แท็บที่เลือก + ตัวเลือกดรอปดาวน์) คืนแถบขาวด้านซ้าย
    local function activeFill(o, r)
        o.BackgroundColor3 = C.white
        o.BorderSizePixel = 0
        round(o, r)
        grad(o, C.blue, C.deep, 0)
        rim(o, C.glow, 1.2, 0.1)
        sheen(o, r, 0.78)
        local bar = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0),
            Size = UDim2.fromOffset(3, 0), BackgroundColor3 = C.white, BorderSizePixel = 0}, o)
        round(bar, 2)
        return bar
    end

    -- hover + กด สำหรับปุ่มกระจก (เปลี่ยนความทึบของกระจก)
    local function interact(btn, base, enter, leave)
        local hovering = false
        local function bg(v, t) tw(btn, t or 0.15, {BackgroundTransparency = alpha(v)}) end
        if not TOUCH then
            btn.MouseEnter:Connect(function()
                hovering = true
                bg(base - 0.1)
                if enter then enter() end
            end)
            btn.MouseLeave:Connect(function()
                hovering = false
                bg(base)
                if leave then leave() end
            end)
        end
        btn.MouseButton1Down:Connect(function()
            bg(base - 0.22, 0.08)
            UIS.InputEnded:Once(function() bg(hovering and base - 0.1 or base, 0.2) end)
        end)
    end

    -- ripple เริ่มจากจุดที่กด (ปุ่มต้องเปิด ClipsDescendants) คืนฟังก์ชันสำหรับเรียกตอนคลิก
    local function rippleOn(btn, col, tr)
        local lastPos
        btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                lastPos = Vector2.new(i.Position.X, i.Position.Y)
            end
        end)
        return function()
            local rx, ry = 0.5, 0.5
            if lastPos then
                local inset = GS:GetGuiInset()
                local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
                if as.X > 0 and as.Y > 0 then
                    rx = math.clamp((lastPos.X + inset.X - ap.X) / as.X, 0, 1)
                    ry = math.clamp((lastPos.Y + inset.Y - ap.Y) / as.Y, 0, 1)
                end
            end
            local r = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(rx, ry),
                Size = UDim2.fromScale(0, 0), SizeConstraint = Enum.SizeConstraint.RelativeXX,
                BackgroundColor3 = col or C.white, BackgroundTransparency = tr or 0.6, BorderSizePixel = 0, ZIndex = 3}, btn)
            pill(r)
            tw(r, 0.5, {Size = UDim2.fromScale(2.2, 2.2), BackgroundTransparency = 1})
            task.delay(0.55, function() r:Destroy() end)
        end
    end

    local function drag(handle, target, onTap)
        local dragging, start, origin, moved
        bind(handle.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, moved, start, origin = true, false, i.Position, target.Position
            end
        end)
        bind(UIS.InputChanged, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - start
                if d.Magnitude > 6 then moved = true end
                target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
            end
        end)
        bind(UIS.InputEnded, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
                if not moved and onTap then onTap() end
            end
        end)
    end

    --========== spring (เด้งแบบเยลลี่ ใช้กับ UIScale) ==========
    local springs = {}
    local function springTo(obj, prop, target, freq, damp, from)
        if REDUCED_MOTION then
            springs[obj] = nil
            obj[prop] = target
            return
        end
        local s = springs[obj]
        if not s or s.prop ~= prop then
            s = {prop = prop, x = obj[prop], v = 0}
            springs[obj] = s
        end
        if from then
            s.x, s.v = from, 0
            obj[prop] = from
        end
        s.target, s.f, s.d = target, freq or 3, damp or 0.4
    end
    local function springStop(obj) springs[obj] = nil end
    bind(RS.Heartbeat, function(dt)
        dt = math.min(dt, 1 / 20)
        for o, s in pairs(springs) do
            if not o.Parent then
                springs[o] = nil
            else
                local w, h = 2 * math.pi * s.f, dt / 2
                for _ = 1, 2 do
                    local acc = -w * w * (s.x - s.target) - 2 * s.d * w * s.v
                    s.v = s.v + acc * h
                    s.x = s.x + s.v * h
                end
                if math.abs(s.x - s.target) < 0.0005 and math.abs(s.v) < 0.005 then
