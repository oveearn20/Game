-- รถกำลังวาป/ขับ/ล็อกอยู่ไหม (Server Hop ใช้เช็คก่อนย้ายเซิร์ฟ) ถ้าล็อกค้างเกิน 150 วิ ถือว่าไม่ busy กันค้างถาวร
RG.busy = function()
    if RG.active and os.clock() - (RG.activeAt or 0) < 150 then return true end
    return os.clock() < (RG.busyUntil or 0)
end
RG.model = function(root)   -- โมเดลรถทั้งคันของเรา (มี Owner) ถ้าไม่เจอใช้โมเดลที่ใกล้สุด
    local m = root:FindFirstAncestorOfClass("Model")
    local cur = m
    while cur do
        if cur:GetAttribute("OwnerId") == lp.UserId or cur:GetAttribute("Owner") == lp.Name then return cur end
        cur = cur:FindFirstAncestorOfClass("Model")
    end
    return m
end

