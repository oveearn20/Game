-- ล้างสถานะค้างตอนหยุด: ปล่อย W, ปลดล็อกรถ/ตัวละคร, คืน collision, ลงจากรถ
TX.cleanup = function()
    pcall(function() game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.W, false, game) end)
    pcall(RG.calm)
    if RG.active then pcall(RG.release, RG.active) end
    RG.busyUntil = 0
    pcall(setNC, workspace.Terrain, false)
    task.spawn(function()
        task.wait(0.3)
        pcall(function()
            local ch = lp.Character
            local hum = getHum()
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hum then
                local seat = hum.SeatPart
                local m = seat and RG.model(seat)
                if m then
                    for _, d in ipairs(m:GetDescendants()) do
                        if d:IsA("BasePart") then d.Anchored = false end
                    end
                end
                if RG.active then RG.release(RG.active) end
                setNC(seat or hrp or workspace.Terrain, false)
                hum.PlatformStand = false
                hum:Move(Vector3.zero)
                if hum.SeatPart then
                    hum.Sit = false
                    task.wait(0.1)
                    if hum.SeatPart then hum.Jump = true end
                end
            end
            if ch then
                for _, d in ipairs(ch:GetDescendants()) do
                    if d:IsA("BasePart") and d.Anchored then d.Anchored = false end
                end
            end
        end)
    end)
end

-- ===== Watchdog: ค้าง = รีเซ็ตเอง =====
local STALL_SEC = 120
local TICK_MAX = 300
task.spawn(function()
    while sg.Parent do
        task.wait(2)
        if autoOn then RG.safe("watchdog", function()
            local stalled = os.clock() - lastStatusAt > STALL_SEC
            local tooLong = tickStart and os.clock() - tickStart > TICK_MAX
            if stalled or tooLong then
                token = token + 1
                presses = 0; fullTok = -1; fullReal = false; sellBackoffUntil = 0
                local hum = getHum()
                if hum then hum:Move(Vector3.zero) end
                pcall(TX.cleanup)                    -- ปลดล็อกรถ/คืนชน กันค้างสภาพล็อก
                lastStatusAt = os.clock(); tickStart = nil
                setStatus("♻️ ค้างนานเกิน → รีเซ็ตแล้วเริ่มใหม่")
            end
        end) end
    end
end)

RG.close = function()
    autoOn = false
    token = token + 1
    pcall(TX.cleanup)
    for _, c in ipairs(RG.conns) do pcall(function() c:Disconnect() end) end
    RG.conns = {}
    pcall(function() sg:Destroy() end)
end
do
    local env = (getgenv and getgenv()) or _G
    env.__CF_CLEAN = RG.close
end

RG.onAuto = function(on)
    on = on == true
    if on == autoOn then refreshToggle() return end
    autoOn = on
    RG.cfsSet("autoOn", autoOn)
    token = token + 1
    presses = 0
    fullTok = -1; fullReal = false
    refreshToggle()
    if autoOn then
        setStatus("▶ เริ่ม " .. POINTS[selectedIdx].n)
    else
        pcall(TX.cleanup)
        setStatus("■ ปิดออโต้ฟามแล้ว")
    end
end



