    -- แสงสะท้อนครึ่งบนของกระจก (อยู่ใต้ข้อความเสมอ)
    local function sheen(o, r, top)
        local s = new("Frame", {Size = UDim2.new(1, 0, 0.6, 0), BackgroundColor3 = C.white,
            BorderSizePixel = 0, ZIndex = 0}, o)
        round(s, r)
        new("UIGradient", {Transparency = NS(0, top or 0.88, 1, 1), Rotation = 90}, s)
