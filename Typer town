    local function liquidMove(f, bar, x, y, h, instant)
        local ws, wo = f.Size.X.Scale, f.Size.X.Offset
        if instant or REDUCED_MOTION or not f.Visible then
            f.Visible = true
            f.Position = UDim2.fromOffset(x, y)
            f.Size = UDim2.new(ws, wo, 0, h)
        else
            local dist = math.abs(y - f.Position.Y.Offset)
            if dist > 1 then
                tw(f, 0.16, {Size = UDim2.new(ws, wo, 0, h + math.min(dist * 0.3, 14))})
                task.delay(0.16, function()
                    if f.Parent then tw(f, 0.42, {Size = UDim2.new(ws, wo, 0, h)}, Enum.EasingStyle.Back) end
                end)
            end
            tw(f, 0.42, {Position = UDim2.fromOffset(x, y)}, Enum.EasingStyle.Quint)
        end
        if bar then
            bar.Size = UDim2.fromOffset(3, 0)
            tw(bar, 0.32, {Size = UDim2.fromOffset(3, math.floor(h * 0.55))}, Enum.EasingStyle.Back)
        end
    end

