local function rotY(v, deg)
    local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
    return Vector3.new(v.X * c - v.Z * s, 0, v.X * s + v.Z * c)
end

-- kind = "low"(กระโดดข้ามได้) | "tall" | "gap"(หน้าผา/น้ำ) | nil ; steer = ทิศโล่งสำหรับเลี่ยง
local function probe(hrp, dir)
    local ch = lp.Character
    wallParams.FilterDescendantsInstances = {ch}
    waterParams.FilterDescendantsInstances = {ch}
    local o = hrp.Position
    local function ray(yOff, d, len)
        local r = workspace:Raycast(o + Vector3.new(0, yOff, 0), d * len, wallParams)
        return r and r.Instance.CanCollide and math.abs(r.Normal.Y) < 0.55
    end
    local function clear(d)
        return not (ray(-1.8, d, 4.5) or ray(1.2, d, 4.5) or ray(3.5, d, 4.5))
    end
    local steer
    local l, r = rotY(dir, 45), rotY(dir, -45)
    local lc, rc = clear(l), clear(r)
    if lc and rc then steer = (math.random() < 0.5) and l or r
    elseif lc then steer = l
    elseif rc then steer = r end

    local knee = ray(-1.8, dir, 3.5) or ray(-0.6, dir, 3.5)
    local chest = ray(1.2, dir, 3.5)
    local head = ray(3.5, dir, 3.5)
    if head or (chest and knee and ray(5.2, dir, 3.5)) then return "tall", steer end
    if knee or chest then return "low", steer end

    local ahead = o + dir * 4
    local g = workspace:Raycast(ahead + Vector3.new(0, 3, 0), Vector3.new(0, -45, 0), waterParams)
    if not g or g.Material == Enum.Material.Water then return "gap", steer end
end

local function walkTo(target, tok)
    local hum = getHum()
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return false end
    local t0 = os.clock()
    local lastD, lastT = flatDist(hrp.Position, target), t0
    local stuck = 0
    while true do
        if cancelled(tok) then hum:Move(Vector3.zero); return false end
        if hum.SeatPart then return false end
        if not hrp.Parent then return false end
        local d = flatDist(hrp.Position, target)
        if d <= ARRIVE_DIST then return true end
        if os.clock() - t0 > WALK_TIMEOUT then return false end
        local dir = Vector3.new(target.X - hrp.Position.X, 0, target.Z - hrp.Position.Z)
        dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
        local kind, steer = probe(hrp, dir)
        if kind == "low" then
            hum.Jump = true
        elseif kind == "tall" or kind == "gap" then
            if steer then
                hum:MoveTo(hrp.Position + steer * 8)
                if kind == "tall" then hum.Jump = true end
                task.wait(0.4)
            else
                hum:Move(Vector3.zero)
                hum:MoveTo(hrp.Position - dir * 5)
                task.wait(0.4)
                stuck += 1
            end
        end
        hum:MoveTo(target)
        if os.clock() - lastT >= 0.8 then
            if lastD - d < 0.8 then
                stuck += 1
                hum.Jump = true
                if stuck == 3 then
                    hrp.CFrame = hrp.CFrame + dir * 2.5 + Vector3.new(0, 3, 0)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                elseif stuck >= 5 then
                    return false
                else
                    local side = Vector3.new(-dir.Z, 0, dir.X) * (stuck % 2 == 0 and 1 or -1)
                    hum:MoveTo(hrp.Position + side * 5)
                    task.wait(0.4)
                end
            else
                stuck = 0
            end
            lastD, lastT = d, os.clock()
        end
        task.wait(0.1)
    end
end

local PFS = game:GetService("PathfindingService")
local function walkPath(target, tok)
    local hum = getHum()
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return false end
    local path = PFS:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, Costs = {Water = math.huge}})
    local ok = pcall(function() path:ComputeAsync(hrp.Position, target) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        return walkTo(target, tok)
    end
    local wps = path:GetWaypoints()
    for k = 2, #wps do
        if cancelled(tok) then hum:Move(Vector3.zero); return false end
        if hum.SeatPart then return false end
        local wp = wps[k]
        if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
        if not walkTo(wp.Position, tok) then
            if cancelled(tok) then return false end
            hum.Jump = true
            task.wait(0.2)
            if not walkTo(wp.Position, tok) then return walkTo(target, tok) end
        end
    end
    return walkTo(target, tok)
end

-- ==================== ฟาม (ProximityPrompt) ====================
local function farmKey(pt)
    return pt.n:match("[%a_]+")
end

local function promptPos(p)
    local par = p.Parent
    if par and par:IsA("Attachment") then return par.WorldPosition end
    if par and par:IsA("BasePart") then return par.Position end
end

local function findPrompts(pt)
    local sys = workspace:FindFirstChild("Systems")
    local farm = sys and sys:FindFirstChild("Farm")
    if not farm then return {} end
    local key = farmKey(pt)
    local scope = (key and farm:FindFirstChild(key)) or farm
    local list = {}
    for _, d in ipairs(scope:GetDescendants()) do
        if d:IsA("ProximityPrompt") then table.insert(list, d) end
    end
    if #list == 0 and scope ~= farm then
        for _, d in ipairs(farm:GetDescendants()) do
            if d:IsA("ProximityPrompt") then table.insert(list, d) end
        end
    end
    local root = getRoot()
    if root then
        local me = root.Position
        table.sort(list, function(a, b)
            local pa, pb = promptPos(a), promptPos(b)
            local da = pa and (pa - me).Magnitude or math.huge
            local db = pb and (pb - me).Magnitude or math.huge
            return da < db
        end)
    end
    return list
end

local function pressPrompt(p)
    if fireproximityprompt then
        pcall(fireproximityprompt, p)
    else
        task.spawn(function()
            pcall(function()
                p:InputHoldBegin()
                task.wait((p.HoldDuration or 0) + 0.05)
                p:InputHoldEnd()
            end)
        end)
    end
end

pressFarmNow = function(pt)
    if pt.combo then return end
    local ps = findPrompts(pt)
    if #ps > 0 then pressPrompt(ps[1]) end
end

local function farmStarted()
    local bar = gui:FindFirstChild("Bar")
    local main = bar and bar:FindFirstChild("Main")
    local inner = main and main:FindFirstChild("Bar")
    local title = inner and inner:FindFirstChild("Title")
    return title ~= nil and title:IsA("TextLabel") and title.Text:lower():find("collecting") ~= nil
end

