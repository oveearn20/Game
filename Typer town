local AUTO_SELL = true
local CAR_NAME = "Buggy"
local lastCarSeat = nil
local callCar, sellAll

-- ==================== HELPERS ====================
local function cancelled(tok)
    return (not autoOn) or tok ~= token or not sg.Parent
end

local function waitSec(sec, tok)
    local t0 = os.clock()
    while os.clock() - t0 < sec and not cancelled(tok) do task.wait(0.1) end
end

local function getHum()
    local char = lp.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- นั่งรถ = รถ / ไม่ได้นั่ง = ตัวละคร (ค่าที่ 2 = เป็นรถหรือไม่)
local function getRoot()
    local char = lp.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local seat = hum.SeatPart
        local model = RG.model(seat)
        if model then
            return model.PrimaryPart or model:FindFirstChild("VehicleRoot") or seat, true
        end
        return seat, true
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp, false end
end

-- ===== ปิด/คืน CanCollide (จำค่าเดิมครั้งแรกถาวร ไม่เพี้ยนแม้เคยพังกลางทาง) =====
RG.nc = function(p)
    if RG.orig[p] == nil then RG.orig[p] = p.CanCollide end
    RG.touched[p] = true
    p.CanCollide = false
end
local function setNC(root, v)
    if v then
        local m = RG.model(root) or root
        for _, p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") then RG.nc(p) end
        end
        if root:IsA("BasePart") then RG.nc(root) end
    else
        local ch = lp.Character
        for p in pairs(RG.touched) do
            if p.Parent then
                local o = RG.orig[p]
                if o ~= nil then p.CanCollide = o end
            end
            RG.touched[p] = nil
            if ch and p:IsDescendantOf(ch) then RG.orig[p] = nil end   -- ชิ้นตัวละครให้เกมจัดการเอง ไม่จำข้ามรอบ
        end
    end
end

local function bottomOffset(root, model)
    local lowest
    local list = model and model:GetDescendants() or {root}
    for _, p in ipairs(list) do
        if p:IsA("BasePart") and p.Transparency < 0.95 then
            local cf, sz = p.CFrame, p.Size
            local ext = (math.abs(cf.RightVector.Y) * sz.X + math.abs(cf.UpVector.Y) * sz.Y + math.abs(cf.LookVector.Y) * sz.Z) / 2
            local low = cf.Position.Y - ext
            if not lowest or low < lowest then lowest = low end
        end
    end
    if lowest then return root.Position.Y - lowest end
    return root.Size.Y / 2
end

local function belowRootOf(root)
    local model = RG.model(root)
    local b = root.Size.Y / 2
    if model then b = bottomOffset(root, model) end
    return b, model
end

local function flatDist(a, b)
    return Vector3.new(b.X - a.X, 0, b.Z - a.Z).Magnitude
end

-- ===== ล็อก/ย้ายรถ แบบ v2 (วาปได้จริง): ล็อก+ย้ายเฉพาะ root ชิ้นเดียว แล้วเซ็ตความเร็ว 0 ทุกครั้ง =====
-- (ยังเก็บ RG.active / RG.activeAt ไว้ให้ Server Hop เช็คว่ารถกำลังล็อก/วาปอยู่ไหม)
RG.new = function(root)
    local rig = {root = root, parts = {root}, list = {}}
    RG.active = rig
    RG.activeAt = os.clock()
    return rig
end
RG.anchor = function(rig, on)
    if rig.root.Parent then rig.root.Anchored = on end
end
RG.place = function(rig, cf)
    local root = rig.root
    if not root.Parent then return end
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end
RG.release = function(rig)
    if not rig then return end
    if rig.root.Parent then
        rig.root.Anchored = false
        rig.root.AssemblyLinearVelocity = Vector3.zero
        rig.root.AssemblyAngularVelocity = Vector3.zero
    end
    if RG.active == rig then RG.active = nil end
end
RG.calm = function()    -- สั่งคันเร่ง/พวงมาลัย = 0
    local hum = getHum()
    local s = hum and hum.SeatPart
    if s and s:IsA("VehicleSeat") then pcall(function() s.Throttle = 0; s.Steer = 0 end) end
end
RG.still = function(root, tok, maxT)   -- รอรถนิ่ง
    local t0, since = os.clock(), nil
    while os.clock() - t0 < maxT and not cancelled(tok) do
        if root.AssemblyLinearVelocity.Magnitude < 1.5 then
            since = since or os.clock()
            if os.clock() - since > 0.3 then return end
        else
            since = nil
        end
        task.wait(0.1)
    end
end
RG.park = function(rig, inside)   -- จอดแล้วปลดล็อก (คืนการชนก่อน แล้วค่อยปลด)
    if not rig then return end
    setNC(rig.root, false)
    RG.release(rig)
    if inside then
        for _ = 1, 6 do
            if rig.root.Parent then
                rig.root.AssemblyLinearVelocity = Vector3.zero
                rig.root.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait(0.05)
        end
    end
end

-- วางบนพื้นที่ x,z (ถ้าเป็นน้ำให้อยู่เหนือผิวน้ำ) | rig = ย้ายผ่าน RG.place
local function landOn(root, x, z, fallbackY, rig)
    local b, model = belowRootOf(root)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {lp.Character, model}
    rp.IgnoreWater = true
    pcall(function() rp.RespectCanCollide = true end)
    local startY = math.max(root.Position.Y, fallbackY or 0) + 300
    local hit
    for _ = 1, 12 do
        hit = workspace:Raycast(Vector3.new(x, startY, z), Vector3.new(0, -3000, 0), rp)
        if hit then break end
        pcall(function() lp:RequestStreamAroundAsync(Vector3.new(x, fallbackY or root.Position.Y, z), 0.5) end)
        task.wait(0.25)
    end
    local gy = hit and hit.Position.Y or (fallbackY or root.Position.Y)
    local wt = waterTop(x, z)
    if wt and gy <= wt + 0.5 then gy = wt + WATER_CLEAR end
    local function put(y)
        local cf = root.CFrame
        local ncf = CFrame.new(x, y, z) * (cf - cf.Position)
        if rig then
            RG.place(rig, ncf)
        else
            root.CFrame = ncf
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    put(gy + b + GROUND_GAP)
    for _ = 1, 4 do
        task.wait(0.1)
        if not root.Parent then return end
        local h2 = workspace:Raycast(Vector3.new(x, root.Position.Y + 400, z), Vector3.new(0, -3000, 0), rp)
        if h2 and h2.Position.Y > root.Position.Y - b + 2.5 and not (wt and h2.Position.Y <= wt + 0.5) then
            put(h2.Position.Y + b + GROUND_GAP + 0.5)
        else
            break
        end
    end
end

-- ==================== วาป (รถเท่านั้น) : มุดใต้ดิน ====================
-- hold = true : ลงพื้นแล้ว "ล็อกรถค้างไว้" คืน true, rig ให้ผู้เรียกปลด (RG.park) หลังลงจากรถ (กันรถพุ่งก่อนลง)
-- hold = false: ปลดล็อกแล้วรอให้รถนิ่งบนพื้นก่อนคืนค่า
local function warpTo(dest, tok, slow, hold)
    local stepMax = slow and SELL_STEP or STEP_SIZE
    local nearRatio = slow and SELL_RATIO or NEAR_RATIO
    local minStep = slow and SELL_MIN_STEP or MIN_STEP
    local root, isVeh = getRoot()
    if not root or not isVeh then return false end
    RG.busyUntil = os.clock() + 4                  -- แจ้ง Server Hop ว่ากำลังเตรียมวาป (ก่อนล็อกรถ)
    RG.still(root, tok, 1.5)                       -- รอรถนิ่งก่อนเริ่ม
    if cancelled(tok) then return false end
    root, isVeh = getRoot()
    if not root or not isVeh then return false end
    local from = root.Position
    local char = lp.Character
    local below, model = belowRootOf(root)
    local rig = RG.new(root)

    local function noclipAll()
        setNC(root, true)
        if char then
            for _, pt in ipairs(char:GetDescendants()) do
                if pt:IsA("BasePart") then RG.nc(pt) end
            end
        end
    end
    noclipAll()
    RG.anchor(rig, true)                           -- ล็อกรถ

    local VIMw
    pcall(function() VIMw = game:GetService("VirtualInputManager") end)
    local wDown = false
    local function holdW(on)
        if on == wDown or not VIMw then return end
        wDown = on
        pcall(function() VIMw:SendKeyEvent(on, Enum.KeyCode.W, false, game) end)
    end
    local function fin(ret)
        holdW(false)
        if ret and hold then return true, rig end
        RG.calm()
        RG.release(rig)
        return ret
    end
    holdW(true)

    local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
    if flat.Magnitude > 0.1 then dest = dest + flat.Unit * OFFSET end
    flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
    do   -- จุดโผล่สุดท้ายต้องห่างน้ำ >= RG.SAFE studs ไม่งั้นขยับไปจุดที่ปลอดภัยใกล้ๆ
        local safe = RG.safeSpot(dest)
        if safe then
            dest = safe
            flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
        else
            setStatus("⚠️ หาจุดโผล่ห่างน้ำ 100 studs ไม่เจอ ใช้จุดเดิม")
        end
    end

    local function place(x, y, z)
        local cf = root.CFrame
        RG.place(rig, CFrame.new(x, y, z) * (cf - cf.Position))
    end

    local carH = model and model:GetExtentsSize().Y or 6
    local sink = (carH - below) + UNDER_MARGIN
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {char, model}
    rp.IgnoreWater = true
    pcall(function() rp.RespectCanCollide = true end)

    local lastGy = from.Y - below
    local function groundAt(x, z)
        for _ = 1, 8 do
            local top = math.max(lastGy, dest.Y, from.Y) + 600
            local hit = workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -3000, 0), rp)
            if hit then lastGy = hit.Position.Y; return lastGy end
            pcall(function() lp:RequestStreamAroundAsync(Vector3.new(x, lastGy, z), 0.3) end)
            task.wait(0.25)
        end
        return lastGy
    end
    local function underY(x, z)
        local wt = waterTop(x, z)
        if wt then return wt + WATER_CLEAR + below end
        return groundAt(x, z) - sink
    end

    local function bail()
        local p = root.Position
        landOn(root, p.X, p.Z, from.Y, rig)
        setNC(root, false)
        return fin(false)
    end

    -- 1) จมลงใต้พื้นตรงจุดที่อยู่
    do
        if cancelled(tok) then return bail() end
        noclipAll()
        place(from.X, underY(from.X, from.Z), from.Z)
        task.wait(STEP_DELAY)
    end

    -- 2) เลื่อนแนวราบใต้ผิวพื้น (ใกล้จุดหมาย = ก้าวสั้นลง)
    local total = flat.Magnitude
    if total > 0.1 then
        local dir = flat.Unit
        local travelled = 0
        local stepLen = math.clamp(total * nearRatio, minStep, stepMax)
        while travelled < total - 0.5 do
            if cancelled(tok) then return bail() end
            local cur, v = getRoot()
            if cur ~= root or not v then setNC(root, false); return fin(false) end
            local step = math.min(stepLen, total - travelled)
            travelled = travelled + step
            local x = from.X + dir.X * travelled
            local z = from.Z + dir.Z * travelled
            noclipAll()
            place(x, underY(x, z), z)
            task.wait(STEP_DELAY)
        end
    end

    -- 3) โผล่ขึ้นพื้นที่จุดหมาย (ยังล็อกอยู่) → ปล่อย W + คันเร่ง 0 → คืนการชน → ปลด
    landOn(root, dest.X, dest.Z, dest.Y, rig)
    holdW(false)
    RG.calm()
    task.wait(LAND_DELAY)
    setNC(root, false)
    if hold then return true, rig end
    RG.calm()
    RG.release(rig)
    RG.still(root, tok, 1.5)                       -- ให้ล้อ/ช่วงล่างลงนิ่งบนพื้นจริง
    return true
end

-- ขับรถไปพิกัดจริง | สำเร็จ: คืน true, rig, inside (ผู้เรียกต้อง RG.park หลังลงรถ)
local function driveTo(real, tok, wps, speed)   -- wps = จุดทางผ่านตามเส้นนำทาง (ไม่ใส่ = ขับตรงแบบเดิม)
    local char = lp.Character
    local hum = getHum()
    local root, isVeh = getRoot()
    if not (char and hum and root and isVeh) then return false end
    local seat = hum.SeatPart
    RG.busyUntil = os.clock() + 3                  -- แจ้ง Server Hop ว่ากำลังจะขับ (ก่อนล็อกรถ)
    RG.still(root, tok, 1.0)
    if cancelled(tok) then return false end
    local belowRoot, model = belowRootOf(root)
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {char, model}
    rp.IgnoreWater = true

    local rig = RG.new(root)
    setNC(root, true)
    RG.anchor(rig, true)
    RG.calm()

    -- ===== ล้อหมุนตอนไถล: หาล้อ (ชื่อมี wheel/tire) + บานพับของล้อ แล้วใส่ความเร็วหมุนให้ตรงกับระยะที่ไถล =====
    local wheels, hinges, joints = {}, {}, {}
    if model then
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("HingeConstraint") then
                hinges[#hinges + 1] = d
            elseif d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("ManualWeld") then
                joints[#joints + 1] = d
            end
        end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") and d ~= root and d.Transparency < 0.95 then
                local nl = d.Name:lower()
                local inWheels, a = false, d.Parent
                while a and a ~= model do   -- อยู่ในโฟลเดอร์ Wheels/Tires ก็นับ (ชื่อชิ้นอาจเป็น FL/FR/RL/RR)
                    local an = a.Name:lower()
                    if an == "wheels" or an == "wheel" or an == "tires" or an == "tyres" then inWheels = true; break end
                    a = a.Parent
                end
                local byName = nl:find("wheel", 1, true) or nl:find("tire", 1, true) or nl:find("tyre", 1, true)
                if (byName or inWheels) and not nl:find("spring", 1, true) then
                    local sz = d.Size
                    local axisLocal, rad
                    if sz.X <= sz.Y and sz.X <= sz.Z then axisLocal, rad = Vector3.xAxis, math.max(sz.Y, sz.Z) / 2
                    elseif sz.Y <= sz.Z then axisLocal, rad = Vector3.yAxis, math.max(sz.X, sz.Z) / 2
                    else axisLocal, rad = Vector3.zAxis, math.max(sz.X, sz.Y) / 2 end
                    local hg, jt
                    for _, h in ipairs(hinges) do
                        if (h.Attachment0 and h.Attachment0.Parent == d) or (h.Attachment1 and h.Attachment1.Parent == d) then
                            hg = h; break
                        end
                    end
                    if not hg then
                        for _, j in ipairs(joints) do
                            if j.Part1 == d then jt = j; break end
                        end
                    end
                    wheels[#wheels + 1] = {
                        part = d, hinge = hg, joint = jt, axisLocal = axisLocal, r = math.max(rad, 0.5), ang = 0,
                        baseC0 = jt and jt.C0, axisJ = jt and jt.C1:VectorToWorldSpace(axisLocal),
                    }
                end
            end
        end
        local info = {}
        for _, w in ipairs(wheels) do
            info[#info + 1] = w.part.Name .. ":" .. (w.hinge and "hinge" or (w.joint and w.joint.ClassName) or "none")
        end
        print("[Wheels] " .. #wheels .. " ชิ้น: " .. table.concat(info, ", "))
    end
    local function spinWheels(dirv, upv, spd, dt)
        local rollAxis = upv:Cross(dirv)
        for _, w in ipairs(wheels) do
            local pt = w.part
            if pt.Parent then
                local axisW = pt.CFrame:VectorToWorldSpace(w.axisLocal)
                if w.hinge and w.hinge.Attachment0 then axisW = w.hinge.Attachment0.WorldAxis end
                local sp = rollAxis:Dot(axisW) * spd / w.r
                if w.joint and w.joint.Parent and not w.hinge then   -- ล้อต่อด้วย Motor6D/Weld: หมุนที่ข้อต่อ
                    w.ang = (w.ang + sp * dt) % (2 * math.pi)
                    local rot = CFrame.fromAxisAngle(w.axisJ, w.ang)
                    pcall(function()
                        if w.joint:IsA("Motor6D") then w.joint.Transform = rot else w.joint.C0 = w.baseC0 * rot end
                    end)
                else
                    pcall(function() pt.AssemblyAngularVelocity = axisW * sp end)
                end
            end
        end
    end
    local function resetWheels()
        for _, w in ipairs(wheels) do
            if w.joint and w.joint.Parent then
                pcall(function()
                    if w.joint:IsA("Motor6D") then w.joint.Transform = CFrame.new() else w.joint.C0 = w.baseC0 end
                end)
            end
            if w.part.Parent then pcall(function() w.part.AssemblyAngularVelocity = Vector3.zero end) end
        end
    end
    task.spawn(function() pcall(function() lp:RequestStreamAroundAsync(real, 0.5) end) end)
    local lastBeat = os.clock()
    local ncLast = 0
    local ncConn
    ncConn = RunService.Stepped:Connect(function()
        local t = os.clock()
        if t - lastBeat > 1 or not root.Parent then ncConn:Disconnect(); return end
        if t - ncLast < 0.15 then return end
        ncLast = t
        setNC(root, true)
        for _, pt in ipairs(char:GetDescendants()) do
            if pt:IsA("BasePart") then RG.nc(pt) end
        end
    end)
    local seatRot = (seat and seat.CFrame.Rotation) or root.CFrame.Rotation
    local relRot = seatRot:Inverse() * root.CFrame.Rotation
    local yawOff = CFrame.Angles(0, math.rad(CAR_YAW_OFFSET), 0)
    local up = Vector3.new(0, 1, 0)
    local first = true
    local inside = false
    local lost = false
    local t0 = os.clock()
    local wi, odo, lastStream, lastMsg = 1, 0, 0, 0
    local nW = wps and #wps or 0
    local topSpeed = speed or VEH_SPEED
    local tmax = MOVE_TIMEOUT
    local longMode = wps ~= nil or speed ~= nil
    if speed and not wps then
        tmax = 40 + flatDist(root.Position, real) / math.max(topSpeed * 0.4, 10)
    end
    if wps then
        local L = 0
        for i = 2, nW do L = L + flatDist(wps[i - 1], wps[i]) end
        tmax = 40 + L / math.max(topSpeed * 0.4, 10)
    end

    local ext = model and model:GetExtentsSize() or Vector3.new(6, 4, 12)
    local boxW = math.clamp(math.min(ext.X, ext.Z), 4, 10)
    pcall(function() rp.RespectCanCollide = true end)
    local curDir, lastSide = nil, 1
    local mag, moved = 0, 0
    local ghostUntil = 0
    local stuckT, stuckD, stuckN = os.clock(), nil, 0
    local function blocked(origin, d)
        local c0 = origin + Vector3.new(0, 2.5, 0)
        local ok, r = pcall(function()
            return workspace:Blockcast(CFrame.lookAt(c0, c0 + d), Vector3.new(boxW, 4, 1), d * DRIVE_LOOK, rp)
        end)
        if ok then
            return r ~= nil and math.abs(r.Normal.Y) < 0.55
        end
        local side = Vector3.new(-d.Z, 0, d.X) * 3
        for _, off in ipairs({Vector3.zero, side, -side}) do
            for _, h in ipairs({0.5, 3}) do
                local rr = workspace:Raycast(origin + off + Vector3.new(0, h, 0), d * DRIVE_LOOK, rp)
                if rr and rr.Instance.CanCollide and math.abs(rr.Normal.Y) < 0.55 then return true end
            end
        end
        return false
    end
    while true do
        local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
        if cancelled(tok) then
            ncConn:Disconnect(); resetWheels(); setNC(root, false); RG.release(rig)
            return false
        end
        local cur, v = getRoot()
        if cur ~= root or not v then lost = true; break end
        local now = os.clock()
        lastBeat = now
        if now - t0 > tmax then break end
        local p = root.Position
        local tgt = wps and wps[wi] or real
        local d = Vector3.new(tgt.X - p.X, 0, tgt.Z - p.Z)
        if wps then
            RG.activeAt = now                          -- ให้ Server Hop รู้ว่ายังขับอยู่ (เส้นทางยาวเกิน 150 วิ)
            while wi < nW and d.Magnitude <= RG.ROUTE.pass do
                wi += 1; tgt = wps[wi]
                d = Vector3.new(tgt.X - p.X, 0, tgt.Z - p.Z)
            end
            if wi < nW and now - lastStream > 1 then   -- ขอสตรีมแมพล่วงหน้า กันพื้นยังไม่โหลด
                lastStream = now
                local ahead = wps[math.min(wi + 10, nW)]
                task.spawn(function()
                    pcall(function() lp:RequestStreamAroundAsync(Vector3.new(ahead.X, p.Y, ahead.Z), 0.3) end)
                end)
            end
            if now - lastMsg > 1 then
                lastMsg = now
                setStatus(string.format("🧭 ตามเส้นนำทาง %d/%d (ห่างเป้า ~%.0f studs)", wi, nW, flatDist(p, real)))
            end
        end
        local lastLeg = (not wps) or wi >= nW
        if lastLeg and d.Magnitude <= CAR_ARRIVE then break end

        if not stuckD then stuckD = wps and (1e6 - odo) or d.Magnitude; stuckT = now end
        if now - stuckT >= 1.5 then
            local prog = stuckD - (wps and (1e6 - odo) or d.Magnitude)
            if prog >= 4 then
                stuckN = 0
            elseif now >= ghostUntil then
                stuckN += 1
                if stuckN == 1 then
                    lastSide = -lastSide; mag = 0
                else
                    ghostUntil = now + math.min(2 + stuckN * 2, 10)
                    mag = 0
                    setStatus("🧱 ติดสิ่งกีดขวาง → ทะลุตรงด้วย noclip")
                end
            end
            stuckD, stuckT = (wps and (1e6 - odo) or d.Magnitude), now
        end

        local want0 = d.Unit
        local aim
        if now < ghostUntil or d.Magnitude <= 60 then
            aim = want0; mag = 0
        else
            local function dirAt(m)
                return CFrame.Angles(0, math.rad(m * lastSide), 0):VectorToWorldSpace(want0)
            end
            if mag == 0 then
                if blocked(p, want0) then
                    local bestA, bestS
                    for a = 15, 150, 15 do
                        for _, sgn in ipairs({lastSide, -lastSide}) do
                            if not bestA and not blocked(p, CFrame.Angles(0, math.rad(a * sgn), 0):VectorToWorldSpace(want0)) then
                                bestA, bestS = a, sgn
                            end
                        end
                        if bestA then break end
                    end
                    if bestA then lastSide = bestS; mag = bestA; moved = 0 end
                end
            elseif blocked(p, dirAt(mag)) then
                local m = mag
                while m < 150 and blocked(p, dirAt(m)) do m += 15 end
                mag = m; moved = 0
            elseif moved >= 14 and not blocked(p, dirAt(mag - 15)) then
                mag -= 15; moved = 0
            end
            aim = (mag > 0) and dirAt(mag) or want0
        end
        curDir = curDir and curDir:Lerp(aim, 1 - math.exp(-(wps and 9 or 5) * dt)) or aim
        if curDir.Magnitude < 0.1 then curDir = aim end
        local dir = curDir.Unit
        local ramp = math.clamp((now - t0) / 0.8, 0.15, 1)
        local brake = lastLeg and math.clamp((d.Magnitude - CAR_ARRIVE) / math.max(40, topSpeed * 0.8), 0.12, 1) or 1
        local np = p + dir * math.min(topSpeed * ramp * brake * dt, lastLeg and d.Magnitude or 1e9)
        odo += (np - p).Magnitude
        moved += (np - p).Magnitude

        local hit = workspace:Raycast(Vector3.new(np.X, p.Y + 4, np.Z), Vector3.new(0, -600, 0), rp)
        if not hit then
            hit = workspace:Raycast(Vector3.new(np.X, p.Y + 120, np.Z), Vector3.new(0, -600, 0), rp)
        end
        local gy = hit and hit.Position.Y or (longMode and (p.Y - belowRoot - GROUND_GAP) or real.Y)
        local n = hit and hit.Normal or Vector3.new(0, 1, 0)
        if lastLeg and hit and hit.Position.Y - real.Y > 8 and d.Magnitude < 60 then
            gy = real.Y; n = Vector3.new(0, 1, 0); inside = true
        end
        local wt = waterTop(np.X, np.Z)
        if wt and gy <= wt + 0.5 then gy = wt + WATER_CLEAR; n = Vector3.new(0, 1, 0) end
        if n.Y < 0.7 then n = Vector3.new(0, 1, 0) end

        up = first and n or up:Lerp(n, 1 - math.exp(-10 * dt)).Unit
        local want = (CFrame.lookAt(Vector3.zero, dir, up).Rotation * yawOff) * relRot
        local rot = first and want or root.CFrame.Rotation:Lerp(want, 1 - math.exp(-8 * dt))
        local ty = (Vector3.new(np.X, gy, np.Z) + up * (belowRoot + GROUND_GAP)).Y
        local y = first and ty or (p.Y + (ty - p.Y) * (1 - math.exp(-15 * dt)))
        first = false

        RG.place(rig, CFrame.new(np.X, y, np.Z) * rot)
        spinWheels(dir, up, (np - p).Magnitude / math.max(dt, 1e-3), dt)   -- ล้อหมุนตามความเร็วที่ไถลจริง
    end
    ncConn:Disconnect()
    resetWheels()   -- หยุดหมุนล้อ/คืนข้อต่อตอนถึงที่
    if lost then
        setNC(root, false)
        RG.release(rig)
        return false
    end
    -- ถึงแล้ว: วางล้อบนพื้นจริง (ยังล็อกอยู่)
    if not inside then
        local p = root.Position
        local h = workspace:Raycast(Vector3.new(p.X, p.Y + 4, p.Z), Vector3.new(0, -600, 0), rp)
        if h and not waterTop(p.X, p.Z) then
            local cf = root.CFrame
            RG.place(rig, CFrame.new(p.X, h.Position.Y + belowRoot + GROUND_GAP, p.Z) * (cf - cf.Position))
        end
    end
    RG.calm()
    if inside then return true, rig, true end    -- จอดในเขา: ค้าง noclip+ล็อกไว้จนลงรถ
    setNC(root, false)
    return true, rig, false
end

-- ===== ดึงรถแบบฟิสิกส์: ไม่ล็อก ไม่ noclip ให้ CarHover ทำงานปกติ (ล้อติดพื้น หมุนเอง) =====
-- ทุกเฟรมตั้งความเร็วไปข้างหน้าตามทิศหัวรถ + ความเร็วเชิงมุมรอบแกน Y เพื่อเลี้ยวไปหาจุดทางผ่าน
-- ติดสิ่งกีดขวางนานเกิน 1.5 วิ = noclip ชั่วคราวทะลุไป | ถึงแล้วล็อกรถไว้จนลงรถ (เหมือน driveTo)
-- ===== นักบิน: ขับแบบคน = ตัดทางลัดเมื่อพื้นโล่ง + ตรวจกำแพง/น้ำ/หน้าผา แล้วหลบ/ชะลอ =====
-- ไม่ยุ่งกับฟิสิกส์ของรถ: ฟังก์ชันนี้แค่คำนวณ "ความเร็ว" กับ "อัตราเลี้ยว" ให้ลูปขับเอาไปเซ็ต
-- ทุกอย่างแตกแล้วไม่พังทั้งระบบ (pcall) และถ้าเซนเซอร์มีปัญหา จะถอยกลับไปตามเส้นปกติ
RG.pilot = (function()
    local P = {}
    local sqrt, abs, max, min, ceil = math.sqrt, math.abs, math.max, math.min, math.ceil
    local cos, sin, rad, huge, floor = math.cos, math.sin, math.rad, math.huge, math.floor
    local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end

    local function clamp(v, lo, hi)
        if v < lo then return lo elseif v > hi then return hi end
        return v
    end
    local function flat(a, b)
        local dx, dz = b.X - a.X, b.Z - a.Z
        return sqrt(dx * dx + dz * dz)
    end
    local function segDist(p, A, B)   -- ระยะแบนราบจากจุด p ถึงท่อน AB
        local abx, abz = B.X - A.X, B.Z - A.Z
        local l2 = abx * abx + abz * abz
        local t = 0
        if l2 > 1e-6 then t = clamp(((p.X - A.X) * abx + (p.Z - A.Z) * abz) / l2, 0, 1) end
        local dx, dz = p.X - (A.X + abx * t), p.Z - (A.Z + abz * t)
        return sqrt(dx * dx + dz * dz)
    end
    local function rot(d, ang)        -- หมุนเวกเตอร์แบนราบรอบแกน Y (บวก = เลี้ยวซ้าย เหมือน AssemblyAngularVelocity.Y)
        local c, s = cos(ang), sin(ang)
        return Vector3.new(d.X * c + d.Z * s, 0, -d.X * s + d.Z * c)
    end

    -- o: wps (จุดแรก = ตำแหน่งรถ, จุดสุดท้าย = เป้า), top, passR, decel, lat, accel, arrive, halfW, below,
    --    shortcut, avoid, look, exclude (ของที่ไม่นับเป็นสิ่งกีดขวาง: ตัวละคร/รถเรา)
    function P.new(o)
        local c = {}
        c.wps, c.nW = o.wps, #o.wps
        c.top = o.top
        c.passR = o.passR or 30
        c.aDec, c.aLat, c.aAcc = max(o.decel or 60, 10), max(o.lat or 70, 10), max(o.accel or 80, 10)
        c.arrive = o.arrive or 6
        c.halfW = clamp(o.halfW or 4, 2, 9)
        c.rad = clamp(c.halfW + 0.3, 2.5, 6)         -- รัศมีทรงกลมตรวจชน (กว้างกว่าครึ่งรถนิดหน่อย)
        c.castH = c.rad + 0.8                          -- ความสูงศูนย์กลางทรงกลมเหนือพื้น (ขอบทางเตี้ยๆ ไม่นับ)
        c.below = o.below or 2.2                       -- จาก root ถึงพื้น
        c.shortcut = (o.shortcut ~= false)
        c.walls = (o.walls ~= false)   -- false = รถ noclip: พาร์ท (ตึก/รั้ว/ต้นไม้/หิน) ทะลุได้ ไม่ต้องหลบ | ยังไม่ทะลุเขา (Terrain)
        c.gndHigh = c.walls
        c.lockIdx = o.lockIdx   -- จุดผ่านบังคับ (index ใน wps): ห้ามตัดข้าม ต้องเข้าใกล้ <= 12 studs ก่อนไปต่อ
        c.avoid = (o.avoid ~= false)
        c.look = o.look or 450
        c.maxTests = 6
        c.seg, c.aim = 1, min(2, c.nW)
        c.curV = 8
        c.gc, c.gn = {}, 0
        c.planAt, c.senseAt, c.senseT = -1, -1, 0
        c.dev, c.cl, c.L, c.commit = 0, huge, 0, 0
        c.avoidOff = 0
        c.boxedSince = nil
        c.ghost = false
        c.info = {}
        -- ระยะทางที่เหลือจากจุด j ถึงเป้า (ใช้วัดว่ายังคืบหน้าอยู่ไหม)
        c.suf = {}
        c.suf[c.nW] = 0
        for j = c.nW - 1, 1, -1 do c.suf[j] = c.suf[j + 1] + flat(c.wps[j], c.wps[j + 1]) end
        c.bestRem, c.bestAt, c.avoidT = huge, 0, 0
        c.cum = {0}
        for j = 2, c.nW do c.cum[j] = c.cum[j - 1] + flat(c.wps[j - 1], c.wps[j]) end
        local gp, wp = RaycastParams.new(), RaycastParams.new()
        for _, q in ipairs({gp, wp}) do
            q.FilterType = Enum.RaycastFilterType.Exclude
            q.FilterDescendantsInstances = o.exclude or {}
            pcall(function() q.RespectCanCollide = true end)
        end
        gp.IgnoreWater = false     -- พื้น: ให้เห็นผิวน้ำด้วย (จะได้รู้ว่าเป็นน้ำ)
        wp.IgnoreWater = true      -- กำแพง: ไม่สนผิวน้ำ
        c.gp, c.wp = gp, wp
        local okS, fn = pcall(function() return workspace.Spherecast end)
        c.sphere = okS and fn ~= nil
        return c
    end

    -- ===== พื้น: ความสูงพื้น/น้ำ ณ (x,z) แคชช่อง 6 studs (ไม่รู้ = false, ลองใหม่ใน 1.5 วิ) =====
    function P.gnd(c, x, z, yHint)
        local key = floor(x / 6) * 100003 + floor(z / 6)
        local e = c.gc[key]
        local now = c.now or 0
        if e and now < e[1] then return e[2], e[3] end
        -- ปกติยิงจากสูง 250 | noclip: ยิงจากระดับรถ (+7) ของสูงกว่านั้น (ตึก/หลังคา/สะพานลอย) รถทะลุผ่าน ไม่นับเป็นพื้น
        local hit = workspace:Raycast(Vector3.new(x, yHint + (c.gndHigh and 250 or 7), z), Vector3.new(0, -700, 0), c.gp)
        local y, w = false, false
        if hit then
            y = hit.Position.Y
            w = (hit.Material == Enum.Material.Water) or (waterParts[hit.Instance] == true)
        end
        if not w then   -- น้ำที่เป็นพาร์ททะลุได้ (CanCollide=false) เรย์ไม่เห็น: เช็คกับระบบน้ำเดิมของสคริปต์
            local wt = waterTop(x, z)
            if wt and (not y or wt >= y - 0.5) then y, w = wt, true end
        end
        if c.gn > 4000 then c.gc, c.gn = {}, 0 end
        c.gc[key] = {now + (hit and 10 or 1.5), y, w}
        c.gn = c.gn + 1
        return y, w
    end

    -- ชนอะไรถึงเรียกว่ากำแพง: ผนังชัน (normal.Y <= 0.6) สูงพ้นขอบทาง ขนาดใหญ่พอ และไม่ใช่ตัวละครคน
    function P.isWall(c, h, base)
        local inst = h.Instance
        if not inst then return false end
        if not c.walls and not inst:IsA("Terrain") then return false end   -- noclip: ทะลุพาร์ทได้
        if h.Normal.Y > 0.6 then return false end
        if h.Position.Y < base + 1.2 then return false end
        if inst:IsA("Terrain") then return true end
        if not inst:IsA("BasePart") then return false end
        local s = inst.Size
        if max(s.X, s.Y, s.Z) < 3.5 then return false end
        local m = inst:FindFirstAncestorOfClass("Model")
        if m and m:FindFirstChildOfClass("Humanoid") then return false end
        return true
    end

    -- ยิงทรงกลม (ไม่มี Spherecast = เรย์ 5 เส้น กว้างกว่าทรงกลมนิดหน่อย)
    function P.cast(c, o, d, radius)
        if c.sphere then
            local ok, r = pcall(workspace.Spherecast, workspace, o, radius, d, c.wp)
            if ok then return r end
            c.sphere = false
        end
        local len = d.Magnitude
        if len < 1e-6 then return nil end
        local rx, rz = -d.Z / len, d.X / len
        local best
        for _, k in ipairs({0, -0.55, 0.55, -1.15, 1.15}) do
            local h = workspace:Raycast(o + Vector3.new(rx * radius * k, 0, rz * radius * k), d, c.wp)
            if h and (not best or h.Distance < best.Distance) then best = h end
        end
        return best
    end

    -- หากำแพงตามเส้น o -> o+d : คืน (hit, ระยะ) ชนของที่ไม่ใช่กำแพง (ขอบทาง/ก้อนหิน) แล้วยิงต่อ
    function P.castWalls(c, o, d, base)
        local len = d.Magnitude
        if len < 0.5 then return nil end
        local u = d / len
        local done = 0
        for _ = 1, 4 do
            local h = P.cast(c, o + u * done, u * (len - done), c.rad)
            if not h then return nil end
            if P.isWall(c, h, base) then return h, done + h.Distance end
            done = done + max(h.Distance, 0) + 2
            if done >= len - 1 then return nil end
        end
        return nil
    end

    -- ทางตรง a -> b ขับผ่านได้ไหม (พื้นต่อเนื่อง ไม่ใช่น้ำ ไม่ชัน ไม่มีหน้าผา ขอบข้างปลอดภัย ไม่มีกำแพงตามความกว้างรถ)
    function P.los(c, a, b)
        local dx, dz = b.X - a.X, b.Z - a.Z
        local D = sqrt(dx * dx + dz * dz)
        if D < 8 then return true end
        local ux, uz = dx / D, dz / D
        local rx, rz = -uz, ux
        local lat = c.halfW + 3
        local STEP = 10
        local y0, w0 = P.gnd(c, a.X, a.Z, a.Y)
        if not y0 or w0 then return false, "start" end
        local ts, ys = {0}, {y0}
        local n = ceil(D / STEP)
        local py, pt = y0, 0
        for i = 1, n do
            local t = min(i * STEP, D)
            local x, z = a.X + ux * t, a.Z + uz * t
            local y, w = P.gnd(c, x, z, py)
            if not y then return false, "unknown" end
            if w then return false, "water" end
            local ds = t - pt
            local dy = y - py
            if dy > 0.7 * ds + 1.0 then return false, "steep" end
            if dy < -(1.2 * ds + 1.5) then return false, "drop" end
            if i % 2 == 0 or i == n then
                for sg = -1, 1, 2 do
                    local yl, wl = P.gnd(c, x + rx * lat * sg, z + rz * lat * sg, y)
                    if not yl or wl or abs(yl - y) > 5 then return false, "edge" end
                end
            end
            ts[#ts + 1] = t
            ys[#ys + 1] = y
            py, pt = y, t
        end
        local i0, N = 1, #ts
        while i0 < N do
            local i1 = min(i0 + 3, N)
            local t0, t1 = ts[i0], ts[i1]
            local o = Vector3.new(a.X + ux * t0, ys[i0] + c.castH, a.Z + uz * t0)
            local e = Vector3.new(a.X + ux * t1, ys[i1] + c.castH, a.Z + uz * t1)
            if P.castWalls(c, o, e - o, ys[i0]) then return false, "wall" end
            i0 = i1
        end
        return true
    end

    -- ระยะโล่งข้างหน้าตามทิศ dir (กำแพง / น้ำ / พื้นหาย / หน้าผา / ลาดชันเกิน) สูงสุด L
    function P.clearance(c, p, dir, L, base)
        local o = Vector3.new(p.X, base + c.castH, p.Z)
        local hit, dist = P.castWalls(c, o, dir * L, base)
        local lim = hit and min(L, dist) or L
        local y, t = base, 8
        local lat = c.halfW + 1
        local rx, rz = -dir.Z, dir.X
        while t <= lim do
            local x, z = p.X + dir.X * t, p.Z + dir.Z * t
            local gy, w = P.gnd(c, x, z, y)
            if not gy or w then return t - 8 end
            if gy < y - 6 or gy > y + 7 then return t - 8 end
            do   -- ขอบข้างตัวรถ (ล้อไม่ตกขอบ/ไม่ลงน้ำ)
                for sg = -1, 1, 2 do
                    local yl, wl = P.gnd(c, x + rx * lat * sg, z + rz * lat * sg, gy)
                    if not yl or wl or yl < gy - 6 then return t - 8 end
                end
            end
            y = gy
            t = t + 8
        end
        return lim
    end

    -- เลือกทิศหลบ: ทางตรงไปเป้าโล่งพอ = ไปเลย | ไม่โล่ง = เลือกข้างหลบ (ซ้าย/ขวา) แล้ว "ยึดข้างนั้น"
    -- เลียบสิ่งกีดขวางไปจนทางไปเป้าโล่ง (กันส่ายไปมาหน้ากำแพงยาว/ทะเลสาบ) เบี่ยงน้อยสุดที่โล่งพอ
    -- คืน (มุมเบี่ยงเรเดียน, ระยะโล่งในทิศที่เลือก, ระยะที่มอง)
    local DEGS = {12, 25, 40, 55, 70, 85, 100, 120, 140, 160}
    function P.sense(c, p, desired, speed, Lmax, fwd)
        local L = clamp(speed * speed / (2 * c.aDec) + 50, 40, 420)
        if Lmax then L = min(L, max(Lmax, 20)) end
        local base = p.Y - c.below
        local need = max(min(30, L), L * 0.6)
        local c0 = P.clearance(c, p, desired, L, base)
        -- ทางที่หัวรถชี้อยู่ตอนนี้ (ระหว่างหักหลบ หัวรถยังชี้หาสิ่งกีดขวางได้ ต้องเบรกตามนี้ด้วย)
        if fwd and (fwd.X * desired.X + fwd.Z * desired.Z) < 0.996 then
            c.clFwd = P.clearance(c, p, fwd, L, base)
        else
            c.clFwd = c0
        end
        if c0 >= need then
            if c.commit ~= 0 and (c.now or 0) - (c.commitAt or 0) > 0.6 then c.commit = 0 end
            if c.commit == 0 then return 0, c0, L end
        end
        local function side(sg)   -- ข้าง sg: มุมเบี่ยงน้อยสุดที่โล่งพอ (ไม่มี = มุมที่โล่งสุด)
            local bd, bc = nil, -1
            for i = 1, #DEGS do
                local dev = sg * rad(DEGS[i])
                local cl = P.clearance(c, p, rot(desired, dev), L, base)
                if cl >= need then return dev, cl, true end
                if cl > bc then bd, bc = dev, cl end
            end
            return bd, bc, false
        end
        if c0 >= need then return 0, c0, L end
        if c.commit == 0 then
            -- เลือกข้าง: ข้างที่ต้องเบี่ยงน้อยกว่า (เสมอกัน = ข้างที่หัวรถหันอยู่)
            local dl, cll, okl = side(1)
            local dr, clr, okr = side(-1)
            local pick
            if okl and okr then
                if abs(dl) < abs(dr) then pick = 1 elseif abs(dr) < abs(dl) then pick = -1
                else
                    local cr = fwd and (desired.X * fwd.Z - desired.Z * fwd.X) or 0
                    pick = (cr < 0) and 1 or -1
                end
            elseif okl then pick = 1
            elseif okr then pick = -1
            else pick = (cll >= clr) and 1 or -1 end
            c.commit, c.commitAt = pick, c.now or 0
            if pick == 1 then return dl, cll, L end
            return dr, clr, L
        end
        local dv, cl, ok = side(c.commit)
        c.commitAt = c.now or 0
        if not ok and cl < 12 then   -- ข้างนี้ตันจริง ลองอีกข้าง
            local dv2, cl2 = side(-c.commit)
            if cl2 > cl then c.commit = -c.commit; return dv2, cl2, L end
        end
        return dv, cl, L
    end

    -- ความคืบหน้าบนเส้น: ท่อนปัจจุบัน seg (wps[seg] -> wps[seg+1])
    function P.advance(c, p)
        local wps, nW = c.wps, c.nW
        local seg = c.seg
        while seg < nW - 1 do
            local dB = flat(p, wps[seg + 1])
            local pr = (c.lockIdx and seg + 1 == c.lockIdx) and 12 or c.passR
            if dB > pr then break end
            -- ตัดโค้งก่อนถึงจุดได้เฉพาะเมื่อมองเห็นปลายท่อนถัดไป (กันเลี้ยวก่อนแล้วชนกำแพงตรงหัวมุม)
            if dB > 12 and (c.shortcut or c.avoid) then
                local key = seg + 1
                if c.passKey ~= key or (c.now or 0) - (c.passAt or -1) >= 0.2 then
                    c.passKey, c.passAt = key, c.now or 0
                    local okL, vis = pcall(P.los, c, p, wps[seg + 2])
                    c.passVis = (not okL) or vis
                end
                if not c.passVis then break end
            end
            seg = seg + 1
        end
        -- รถตัดโค้งแล้วอาจไม่เคยเข้าใกล้จุดกลางทาง: ดูท่อนที่ใกล้รถสุดใน 8 ท่อนข้างหน้า
        local bm, bd = seg, segDist(p, wps[seg], wps[seg + 1])
        local mMax = min(seg + 8, nW - 1)
        if c.lockIdx and seg < c.lockIdx then mMax = min(mMax, c.lockIdx - 1) end   -- ยังไม่ถึงจุดผ่าน: ห้ามข้ามไปท่อนหลังจุดผ่าน
        for m = seg + 1, mMax do
            local d = segDist(p, wps[m], wps[m + 1])
            if d < bd - 3 then bm, bd = m, d end
        end
        c.seg = bm
    end

    -- เลือกจุดเล็ง: จุดไกลสุดบนเส้นที่ "มองเห็นผ่านได้" (ตัดทางลัด) ไม่มีเลย = จุดถัดไปตามเส้น
    function P.plan(c, p)
        local wps, nW = c.wps, c.nW
        local lo = min(c.seg + 1, nW)
        local hi = min(nW, lo + 12)
        if c.lockIdx and c.seg < c.lockIdx then hi = min(hi, c.lockIdx) end   -- ตัดทางลัดได้ไม่เกินจุดผ่าน
        local aim = clamp(c.aim, lo, hi)
        if not c.shortcut then c.aim = lo; return end
        local tests = 0
        local function visible(j)
            tests = tests + 1
            if flat(p, wps[j]) > c.look then return false end
            local good, why = P.los(c, p, wps[j])
            c.why = why
            return good
        end
        local best = lo
        if aim > lo then
            if visible(aim) then
                best = aim
                local j = aim + 1
                while j <= hi and j <= aim + 3 and tests < c.maxTests do
                    if visible(j) then best = j; j = j + 1 else break end
                end
            else
                local j = aim - 1
                while j > lo and tests < c.maxTests do
                    if visible(j) then best = j; break end
                    j = j - 1
                end
            end
        else
            local j = lo + 1
            while j <= hi and j <= lo + 3 and tests < c.maxTests do
                if visible(j) then best = j; j = j + 1 else break end
            end
        end
        c.aim = best
    end

    -- จุดบนเส้นที่ระยะ sd (นับจากต้นเส้น)
    function P.at(c, sd, hint)
        local cum, wps, nW = c.cum, c.wps, c.nW
        if sd <= 0 then return wps[1], 1 end
        if sd >= cum[nW] then return wps[nW], nW - 1 end
        local j = clamp(hint or 1, 1, nW - 1)
        while j > 1 and cum[j] > sd do j = j - 1 end
        while j < nW - 1 and cum[j + 1] < sd do j = j + 1 end
        local A, B = wps[j], wps[j + 1]
        local seg = cum[j + 1] - cum[j]
        local t = seg > 1e-6 and (sd - cum[j]) / seg or 0
        return Vector3.new(A.X + (B.X - A.X) * t, 0, A.Z + (B.Z - A.Z) * t), j
    end

    -- เพดานความเร็วจากโค้งจริงข้างหน้า: วัดมุมเลี้ยวของเส้นช่วงละ 50 studs (รอยหยักเล็กๆ ของเส้นแผนที่ไม่นับ)
    -- รัศมี R = 50 / มุม, ความเร็วเข้าโค้ง vc = sqrt(aLat·R), ต้องเบรกให้ทัน: v <= sqrt(vc² + 2·a·ระยะถึงโค้ง)
    local WIN = 50
    function P.cornerCap(c, p, aim)
        local cum, nW = c.cum, c.nW
        local s0 = cum[aim]
        local dAim = flat(p, c.wps[aim])
        local horizon = c.curV * c.curV / (2 * c.aDec) + 80
        local sEnd = min(cum[nW] - WIN, s0 + horizon)
        local cap = huge
        local hint = aim
        local sd = s0
        while sd <= sEnd do
            local P0, h0 = P.at(c, sd - WIN, hint)
            local P1, h1 = P.at(c, sd, h0)
            local P2 = P.at(c, sd + WIN, h1)
            hint = h0
            local ax, az = P1.X - P0.X, P1.Z - P0.Z
            local bx, bz = P2.X - P1.X, P2.Z - P1.Z
            local la, lb = sqrt(ax * ax + az * az), sqrt(bx * bx + bz * bz)
            if la > 5 and lb > 5 then
                local th = math.acos(clamp((ax * bx + az * bz) / (la * lb), -1, 1))
                if th > 0.12 then
                    local vc = max(sqrt(c.aLat * WIN / th), 28)
                    local dist = dAim + (sd - s0)
                    cap = min(cap, sqrt(vc * vc + 2 * c.aDec * max(dist - 10, 0)))
                end
            end
            sd = sd + 15
        end
        return cap
    end

    -- 1 เฟรม: คืน (ความเร็วที่สั่ง, อัตราเลี้ยว Y, info)
    --   p = ตำแหน่งรถ, fwd = หัวรถแบนราบ (หน่วย), now = เวลา (วินาที)
    function P.step(c, p, fwd, dt, now)
        c.now = now
        local wps, nW = c.wps, c.nW
        P.advance(c, p)
        if now - c.planAt >= 0.25 then
            c.planAt = now
            local ok, err = pcall(P.plan, c, p)
            if not ok then c.shortcut = false; c.err = tostring(err); c.aim = min(c.seg + 1, nW) end
        end
        c.aim = clamp(c.aim, min(c.seg + 1, nW), nW)
        if c.lockIdx and c.seg < c.lockIdx and c.aim > c.lockIdx then c.aim = c.lockIdx end
        local aim = c.aim
        local A, F = wps[aim], wps[nW]
        -- มองไกลตามความเร็ว (pure pursuit): เล็งจุดบนเส้นห่างไปข้างหน้า 25..95 studs ถ้าไกลกว่าจุดเล็ง
        -- เส้นแผนที่หยักทุก 25 studs จะถูกเฉลี่ย ไม่ส่ายตาม
        do
            local sg = c.seg
            local S0, S1 = wps[sg], wps[min(sg + 1, nW)]
            local ex, ez = S1.X - S0.X, S1.Z - S0.Z
            local l2 = ex * ex + ez * ez
            local tt = l2 > 1e-6 and clamp(((p.X - S0.X) * ex + (p.Z - S0.Z) * ez) / l2, 0, 1) or 0
            local sProj = c.cum[sg] + tt * sqrt(l2)
            local sLook = sProj + clamp(c.curV * 0.38, 25, 95)
            if c.lockIdx and sg < c.lockIdx then sLook = min(sLook, c.cum[c.lockIdx]) end
            if aim < nW and sLook > c.cum[aim] then
                local LP = P.at(c, sLook, aim)
                A = Vector3.new(LP.X, A.Y, LP.Z)
            end
        end
        local dx, dz = A.X - p.X, A.Z - p.Z
        local dA = sqrt(dx * dx + dz * dz)
        local desired = (dA < 0.5) and fwd or Vector3.new(dx / dA, 0, dz / dA)
        local lastLeg = aim >= nW
        local dF = flat(p, F)

        -- ตรวจสิ่งกีดขวางข้างหน้า (ทุก ~0.07 วิ)
        local steer, capObs = desired, huge
        local final = lastLeg and dF <= 30   -- ช่วงเข้าจอด: ไม่หักหลบ แค่เบรกถ้ามีของขวาง (จอดชิดได้ ไม่ถอยวน)
        if final and c.avoid and not c.ghost then
            if now - c.senseAt >= 0.07 then
                c.senseAt, c.senseT = now, now
                local w0 = c.walls
                c.walls = true   -- ช่วงจอด: เห็นพาร์ทอีกครั้ง เบรกก่อนโต๊ะ/ผนัง (กันจอดซ้อนในของแล้วรถกระเด็นตอนคืนการชน)
                local ok, cl = pcall(P.clearance, c, p, desired, dF + 4, p.Y - c.below)
                c.walls = w0
                c.dev, c.commit, c.L = 0, 0, dF + 4
                c.cl = ok and cl or huge
                c.clFwd = c.cl
            end
            local cl = c.cl - c.curV * (now - c.senseT)
            if c.cl < c.L then capObs = sqrt(2 * c.aDec * max(cl - 10, 0)) + clamp(cl - 5, 0, 4) end
            c.boxedSince = nil
        elseif c.avoid and now >= c.avoidOff and not c.ghost then
            if now - c.senseAt >= 0.07 then
                c.senseAt, c.senseT = now, now
                local ok, dev, cl, L = pcall(P.sense, c, p, desired, c.curV, lastLeg and (dF + 4) or nil, fwd)
                if ok then
                    c.dev, c.cl, c.L = dev, cl, L
                else
                    c.avoid = false
                    c.err = tostring(dev)
                end
            end
            if c.dev ~= 0 then steer = rot(desired, c.dev) end
            local clm = min(c.cl, c.clFwd or huge)
            if clm < c.L then
                -- หยุดก่อนชน ~5 studs: v = sqrt(2·a·(ระยะ-10)) + ส่วนคลาน (0 เมื่อเหลือ <= 5)
                local cl = clm - c.curV * (now - c.senseT)
                capObs = sqrt(2 * c.aDec * max(cl - 10, 0)) + clamp(cl - 5, 0, 4)
            end
            if c.cl < 14 then c.boxedSince = c.boxedSince or now else c.boxedSince = nil end
        else
            c.dev, c.cl, c.L, c.boxedSince = 0, huge, 0, nil
        end

        -- กันวนหลบไม่จบ (เป้าอยู่ในที่ปิด/ประตูแคบกว่าเซนเซอร์): หลบอยู่นานแต่ระยะทางที่เหลือไม่ลดลงเลย 6 วิ
        -- -> ปิดการหลบ 8 วิ ให้ขับตรงเข้าไป (ถ้าชนจริง ลูปขับจะถอย/noclip เหมือนเดิม)
        local rem = dA + (c.suf[aim] or 0)
        if rem < c.bestRem - 10 then c.bestRem, c.bestAt, c.avoidT = rem, now, 0 end
        if c.dev ~= 0 then c.avoidT = c.avoidT + dt end
        if now - c.bestAt > 6 and c.avoidT > 3 and now >= c.avoidOff then
            c.avoidOff = now + 8
            c.bestAt, c.avoidT, c.commit = now, 0, 0
            c.dev, c.cl, c.boxedSince = 0, huge, nil
            c.stalls = (c.stalls or 0) + 1
            steer, capObs = desired, huge
        end

        -- กรองทิศที่จะเลี้ยวให้นุ่ม (จุดเล็ง/มุมหลบเปลี่ยนแบบกระโดด -> ไม่สะบัด) tau 0.08 วิ
        local hs = c.hdS
        if hs then
            local k = 1 - math.exp(-dt / 0.08)
            local nx, nz = hs.X + (steer.X - hs.X) * k, hs.Z + (steer.Z - hs.Z) * k
            local m = sqrt(nx * nx + nz * nz)
            hs = (m > 0.2) and Vector3.new(nx / m, 0, nz / m) or steer
        else
            hs = steer
        end
        c.hdS = hs
        steer = hs
        local err = atan2(fwd.Z * steer.X - fwd.X * steer.Z, fwd.X * steer.X + fwd.Z * steer.Z)
        -- พวงมาลัย: เลี้ยวไวตามทาง (สูงสุด 3 rad/s ตอนช้า, ตอนเร็วจำกัดตามแรงเกาะถนน) อัตราเปลี่ยน <= 16 rad/s²
        -- ช่วงเกือบตรง (< 1.5°) เบาลงนิดหน่อย ไม่ส่ายซ้ายขวา แต่ยังดึงกลับเข้ากลางเส้น
        local ae = abs(err)
        local yT = err * 3.2 * min(1, ae / 0.025 + 0.55)
        local yMax = clamp(c.aLat * 1.8 / max(c.curV, 1), 1.3, 3.0)
        yT = clamp(yT, -yMax, yMax)
        local y0 = c.yaw or 0
        local yStep = 16 * dt
        c.yaw = y0 + clamp(yT - y0, -yStep, yStep)
        local want = c.top
        -- เบรกเข้าเป้าตามระยะทางที่เหลือจริงบนเส้น (ไม่ใช่แค่ท่อนสุดท้าย กันพุ่งเลยเป้าตอนท่อนท้ายสั้น)
        local remain = lastLeg and dF or (flat(p, wps[aim]) + (c.suf[aim] or 0))
        want = min(want, sqrt(2 * c.aDec * max(remain - c.arrive, 0)) + 8)
        if ae > 0.45 then want = min(want, max(c.aLat / ((ae - 0.25) * 3.2), 18)) end   -- หัวรถเบี้ยวมาก (>26°) ค่อยชะลอ
        if not lastLeg then want = min(want, P.cornerCap(c, p, aim)) end -- โค้งข้างหน้า
        want = min(want, capObs)
        if want > c.curV then c.curV = min(want, c.curV + c.aAcc * dt)
        else c.curV = max(want, c.curV - c.aDec * 1.5 * dt) end

        local info = c.info
        info.aim, info.seg, info.lastLeg, info.dF, info.err = aim, c.seg, lastLeg, dF, err
        info.avoiding = (c.dev ~= 0)
        info.cl = c.cl
        info.boxed = (c.boxedSince ~= nil and now - c.boxedSince > 1.2)
        info.shortcut = (aim > c.seg + 1)
        info.why = c.why
        info.avoidOff = now < c.avoidOff
        info.final = final
        info.nearBlocked = final and c.cl < 10 and c.cl < dF - 3   -- จอดไม่ถึงเพราะมีของขวาง (โต๊ะ/ผนัง) = ถือว่าถึง
        return c.curV, c.yaw, info
    end

    return P
end)()

-- ===== ประคองรถให้เกาะพื้น (ใช้ตอน noclip ที่รถไม่ชนพื้น): วัดพื้นใต้ หัว/ท้าย/ซ้าย/ขวา =====
-- คืน (มุมหมุนแกน X, แกน Z ให้รถขนานพื้น, ความเร็วแนวดิ่งที่ต้องดันขึ้น หรือ nil, ระยะยกทันทีถ้าจมลึก หรือ nil)
-- ยิงเรย์จากเหนือรถ 8 studs: ตึก/หลังคาที่สูงกว่านั้นรถทะลุผ่าน ไม่นับเป็นพื้น
RG.groundFollow = function(root, seat, halfL, halfW, below, rp, vel)
    local cf = (seat and seat.Parent) and seat.CFrame or root.CFrame
    local look, right, up = cf.LookVector, cf.RightVector, cf.UpVector
    local p = root.Position
    local lf = Vector3.new(look.X, 0, look.Z)
    if lf.Magnitude < 0.1 then return end
    lf = lf.Unit
    local rf = Vector3.new(-lf.Z, 0, lf.X)
    local L, W = halfL * 0.85, math.max(halfW * 0.8, 1.5)
    local hv = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local ahead = math.min(hv * 0.15, 30)          -- มองพื้นล่วงหน้า 0.15 วิ (ที่ 180 = 27 studs)
    local top = p.Y + 8
    local function ray(pos)
        local h = workspace:Raycast(Vector3.new(pos.X, top, pos.Z), Vector3.new(0, -80, 0), rp)
        if h then return h.Position.Y, (h.Instance == nil) or h.Instance:IsA("Terrain") end
    end
    local gC = ray(p)
    if not gC then return end
    local function g(pos)
        local y, isTerrain = ray(pos)
        -- พาร์ทเตี้ย (รั้ว/ม้านั่ง/หิน) ที่สูงกว่าพื้นใต้รถเกิน 3 studs = รถทะลุผ่าน ไม่นับเป็นพื้น (ไม่เด้งข้าม) | พื้นดินนับเสมอ
        if y and not isTerrain and y > gC + 3 then return gC end
        return y
    end
    local gF, gB, gR, gL = g(p + lf * L), g(p - lf * L), g(p + rf * W), g(p - rf * W)
    if not (gF and gB and gR and gL) then return end   -- พื้นไม่ครบ (ขอบน้ำ/หลุม) ปล่อยให้ระบบลอยของรถทำเอง
    local gA = (ahead > 2) and g(p + lf * (L + ahead)) or nil
    -- มุมเงย/ก้ม: เอาความชันระหว่างท้ายรถกับพื้นข้างหน้า (เงยหัวก่อนถึงเนิน ก้มก่อนถึงทางลง)
    local fY, span = gF, 2 * L
    if gA then
        local sA = (gA - gB) / (2 * L + ahead)
        local sF = (gF - gB) / (2 * L)
        if sA > sF then fY = gB + sA * 2 * L end      -- ข้างหน้าชันขึ้นกว่า: เงยล่วงหน้า (ลงเนินใช้ใต้รถจริง ไม่ก้มเร็วเกิน)
    end
    local Fv = lf * span + Vector3.new(0, fY - gB, 0)
    local Rv = rf * (2 * W) + Vector3.new(0, gR - gL, 0)
    local desUp = Rv:Cross(Fv).Unit
    if desUp.Y < 0.55 then desUp = Vector3.new(0, 1, 0) end   -- ชันเกิน 57° ไม่เอียงตาม
    local corr = up:Cross(desUp) * 12
    if corr.Magnitude > 6 then corr = corr.Unit * 6 end
    -- ส่วนล่างของรถจมต่ำกว่าพื้นเกิน 0.3 studs ไหม (ระยะลอยปกติ = below ที่วัดตอนจอดนิ่ง ไม่ดันซ้ำจนเด้ง)
    local dF, dR = (look * L).Y, (right * W).Y
    local base = p.Y - below
    local pen = math.max(gF - (base + dF), gB - (base - dF), gR - (base + dR), gL - (base - dR)) - 0.3
    local vy, lift
    -- ใต้ท้องสูงจากพื้นเท่าไหร่ (จุดที่ต่ำสุด) | ลอยเกิน 3 studs = กลางอากาศ: ไม่ดันขึ้นเพิ่ม (กันรถบิน) ปล่อยตกลงเอง
    local clear = math.min((base + dF) - gF, (base - dF) - gB, (base + dR) - gR, (base - dR) - gL)
    local nearGround = clear < 3
    -- ไต่เนิน: noclip ไม่มีพื้นดันรถขึ้น ต้องให้ความเร็วแนวดิ่ง = ความเร็ว × ความชันข้างหน้า (เลียบผิวเนินเหมือนล้อเกาะพื้น)
    local sF = (gF - gB) / (2 * L)
    local sA = gA and (gA - gF) / ahead or sF
    local climb = nearGround and hv * math.max(sF, sA, 0) or 0
    -- ยกเท่าที่ขาด: ปลายจะลง |ω|·L ใน 0.15 วิ เทียบกับระยะที่เหลือถึงพื้น (ลอยสูงอยู่แล้ว = ไม่ยก)
    local pitchReq = math.abs(corr:Dot(right)) * L - math.max(clear, 0) / 0.15
    local vyT = climb + math.max(pen, 0) * 15 + math.max(pitchReq, 0)
    if vyT > 0.5 and (nearGround or pen > 0) then vy = math.min(vyT, 160) end
    if vy then vy = math.max(vel.Y, vy) end
    if pen > 2 then lift = pen end
    return corr.X, corr.Z, vy, lift
end

RG.driveToPhys = function(real, tok, wps, speed, opts)
    opts = opts or {}
    local char = lp.Character
    local hum = getHum()
    local root, isVeh = getRoot()
    if not (char and hum and root and isVeh) then return false end
    local seat = hum.SeatPart
    RG.busyUntil = os.clock() + 3
    RG.still(root, tok, 1.0)
    if cancelled(tok) then return false end
    local rig = RG.new(root)
    task.spawn(function() pcall(function() lp:RequestStreamAroundAsync(real, 0.5) end) end)

    local R = RG.ROUTE
    local topSpeed = speed or VEH_SPEED
    local poly = wps or {root.Position, real}     -- ไม่มีเส้น = เส้นตรง 2 จุด (นักบินยังหลบกำแพงให้)
    local nW = #poly
    local L = 0
    for i = 2, nW do L = L + flatDist(poly[i - 1], poly[i]) end
    local tmax = 40 + L / math.max(topSpeed * 0.4, 10)
    local seatRot = (seat and seat.CFrame.Rotation) or root.CFrame.Rotation
    local relRot = seatRot:Inverse() * root.CFrame.Rotation
    local ARRIVE = R.arrive or (CAR_ARRIVE + 4)

    -- ขนาดรถ: ครึ่งความกว้าง (ตามแกนขวาของเบาะ) + ระยะ root ถึงพื้น
    local below, carModel = belowRootOf(root)
    local halfW = 4
    pcall(function()
        local cf, sz = carModel:GetBoundingBox()
        local rv = (seat or root).CFrame.RightVector
        halfW = (math.abs(rv:Dot(cf.RightVector)) * sz.X + math.abs(rv:Dot(cf.UpVector)) * sz.Y
            + math.abs(rv:Dot(cf.LookVector)) * sz.Z) / 2
    end)
    local halfL = 6
    pcall(function()
        local cf, sz = carModel:GetBoundingBox()
        local lv = (seat or root).CFrame.LookVector
        halfL = (math.abs(lv:Dot(cf.RightVector)) * sz.X + math.abs(lv:Dot(cf.UpVector)) * sz.Y
            + math.abs(lv:Dot(cf.LookVector)) * sz.Z) / 2
    end)
    halfL = math.clamp(halfL, 3, 14)
    local human = R.human ~= false
    -- R.noclip: true = noclip ตลอดการขับ | "crash" = ขับปกติ หลบกำแพงเอง ชนจริงค่อย noclip ชั่วคราว | false = ไม่ noclip
    local ghostAll = R.noclip == true and opts.noclip ~= false
    local crashMode = R.noclip == "crash" and opts.noclip ~= false
    local okP, pc = pcall(RG.pilot.new, {
        wps = poly, top = topSpeed, passR = math.max(R.pass, topSpeed * 0.35),
        decel = R.decel, lat = R.lat, accel = R.accel, arrive = ARRIVE,
        halfW = halfW, below = below,
        shortcut = human and R.shortcut ~= false, avoid = human and R.avoid ~= false, look = R.look,
        walls = not ghostAll, lockIdx = opts.solidFrom,
        exclude = {char, carModel or root},
    })
    if not okP then
        warn("[Pilot] เริ่มไม่ได้: " .. tostring(pc))
        RG.release(rig)
        return false
    end
    print(string.format("[Pilot] เริ่ม: จุด=%d ยาว=%.0f ครึ่งกว้างรถ=%.1f ทางลัด=%s หลบ=%s noclip=%s Spherecast=%s",
        nW, L, halfW, tostring(pc.shortcut), tostring(pc.avoid), ghostAll and "ตลอด" or (crashMode and "ตอนชน" or "ปิด"), tostring(pc.sphere)))

    -- noclip ตอนขับ: รถทั้งคัน + ตัวละคร ย้ำทุก 0.15 วิ (Humanoid ชอบเปิดการชนคืนเอง) แบบ driveTo ตัวเก่า
    local ncConn, ncLast, ncBeat = nil, 0, os.clock()
    local function ghostOn()
        setNC(root, true)
        if char and char.Parent then
            for _, pt in ipairs(char:GetDescendants()) do
                if pt:IsA("BasePart") then RG.nc(pt) end
            end
        end
    end
    local crashUntil, crashT, lastCmd = 0, 0, 0   -- noclip ตอนชน: หมดเวลาเมื่อไหร่ / ชนมานานเท่าไหร่ / ความเร็วที่สั่งเฟรมก่อน
    if ghostAll then ghostOn() end
    if ghostAll or crashMode then
        ncConn = RunService.Stepped:Connect(function()
            local t = os.clock()
            if t - ncBeat > 1 or not root.Parent then ncConn:Disconnect(); return end   -- ลูปขับหยุด = เลิก noclip เอง
            if not (ghostAll or t < crashUntil) then return end
            if t - ncLast < 0.15 then return end
            ncLast = t
            pcall(ghostOn)
        end)
    end
    -- รถยังซ้อนอยู่ในของแข็งไหม (ก่อนคืนการชน กันรถกระเด็น)
    local ovP
    pcall(function()
        ovP = OverlapParams.new()
        ovP.FilterType = Enum.RaycastFilterType.Exclude
        ovP.FilterDescendantsInstances = {char, carModel or root}
        ovP.RespectCanCollide = true
    end)
    local function overlapping()
        if not ovP then return false end
        local okO, hit = pcall(function()
            local cf = (seat and seat.Parent) and seat.CFrame or root.CFrame
            local parts = workspace:GetPartBoundsInBox(cf, Vector3.new(halfW * 2, 4, halfL * 2), ovP)
            for _, pt in ipairs(parts) do
                if not pt:IsA("Terrain") then return true end
            end
            return false
        end)
        return okO and hit
    end
    local function crashOff()
        crashUntil = 0
        setNC(root, false)
        pc.walls, pc.gndHigh, pc.gc, pc.gn = true, true, {}, 0
    end
    -- กันตกทะลุพื้น (รถ noclip): ร่วงเร็ว + มีพื้นอยู่เหนือท้องรถ -> ยกรถขึ้นวางบนพื้น
    local fallRP = RaycastParams.new()
    fallRP.FilterType = Enum.RaycastFilterType.Exclude
    fallRP.FilterDescendantsInstances = {char, carModel or root}
    fallRP.IgnoreWater = true
    pcall(function() fallRP.RespectCanCollide = true end)
    local lastFallFix = 0
    local gfFix = 0

    local t0 = os.clock()
    local stuckP, stuckT, ghostUntil, ghosting = root.Position, t0, 0, false
    local revUntil, lastRev, revN = 0, -100, 0
    local lastStream, lastMsg, lastFlip = 0, 0, 0
    local ok, lost, timedOut = true, false, false
    local lastP = root.Position
    local errShown = false

    while true do
        local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
        if cancelled(tok) then ok = false; break end
        local cur, v = getRoot()
        if cur ~= root or not v then lost = true; break end
        lastP = root.Position
        local now = os.clock()
        if now - t0 > tmax then timedOut = true; break end
        RG.activeAt = now
        ncBeat = now
        -- ถึงจุดผ่านแล้ว (ช่วงสุดท้ายเข้าเป้า): ปิด noclip กลับมาชนปกติ + หลบกำแพง (ไม่ทะลุกำแพงเข้าเป้า)
        if (ghostAll or crashMode) and opts.solidFrom and pc.seg >= opts.solidFrom then
            crashMode = false
            if crashUntil > 0 then crashOff() end
            ghostAll = false
            if ncConn then ncConn:Disconnect(); ncConn = nil end
            setNC(root, false)
            pc.walls, pc.gndHigh, pc.gc, pc.gn = true, true, {}, 0
            setStatus("🧱 ถึงจุดผ่าน → ปิด noclip ขับเข้าเป้า")
        end
        if (ghostAll or crashUntil > 0) and now - lastFallFix > 0.5 and root.AssemblyLinearVelocity.Y < -35 then
            local p0 = root.Position
            local hit = workspace:Raycast(p0 + Vector3.new(0, 150, 0), Vector3.new(0, -400, 0), fallRP)
            if hit and hit.Position.Y > p0.Y - below + 2 then
                lastFallFix = now
                local cf = root.CFrame
                root.CFrame = CFrame.new(p0.X, hit.Position.Y + below + 1, p0.Z) * (cf - cf.Position)
                local v0 = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(v0.X, 0, v0.Z)
                setStatus("⚠️ รถจมพื้น → ยกขึ้น")
            end
        end
        local p = root.Position
        local aimPt = poly[math.min(pc.aim, nW)]
        local dir = Vector3.new(aimPt.X - p.X, 0, aimPt.Z - p.Z)
        dir = dir.Magnitude > 0.5 and dir.Unit or Vector3.new(0, 0, 1)

        if now - lastStream > 1 then   -- โหลดแมพข้างหน้าล่วงหน้า
            lastStream = now
            local ahead = poly[math.min(pc.aim + math.max(4, math.floor(topSpeed / 25)), nW)]
            task.spawn(function()
                pcall(function() lp:RequestStreamAroundAsync(Vector3.new(ahead.X, p.Y, ahead.Z), 0.3) end)
            end)
        end

        -- ติด: ขยับน้อยกว่า 4 studs ใน 1.5 วิ (หรือนักบินบอกว่าตัน) -> ถอยหลังก่อน 1 ครั้ง ถ้ายังติด -> noclip ชั่วคราว
        local boxed = pc.info.boxed
        if (now - stuckT >= 1.5 or boxed) and now >= revUntil then
            if ((p - stuckP).Magnitude < 4 or boxed) and now >= ghostUntil then
                if (human or ghostAll) and now - lastRev > 8 then
                    revUntil, lastRev, revN = now + 1.1, now, revN + 1
                    pc.boxedSince = nil
                    pc.commit = -(pc.commit or 0)   -- ถอยแล้วลองอ้อมอีกข้าง
                    setStatus("↩️ ติด → ถอยหลังแล้วหาทางใหม่")
                elseif not ghostAll then
                    ghostUntil = now + 2.5
                    ghosting = true
                    setNC(root, true)
                    setStatus("🧱 ติดสิ่งกีดขวาง → noclip ชั่วคราว")
                end
            end
            stuckP, stuckT = p, now
        end
        if ghosting and now >= ghostUntil then
            ghosting = false
            setNC(root, false)
        end
        pc.ghost = ghosting and not ghostAll

        -- ชนกำแพง: สั่งวิ่ง > 25 แต่ความเร็วจริงตกเหลือ < 40% นาน 0.1 วิ -> noclip 2 วิ (ไม่ทำช่วงจอด 30 studs สุดท้าย)
        if crashMode and now >= revUntil then
            local vNow = root.AssemblyLinearVelocity
            local hvNow = Vector3.new(vNow.X, 0, vNow.Z).Magnitude
            if lastCmd > 25 and hvNow < lastCmd * 0.4 and not pc.info.final then crashT = crashT + dt else crashT = 0 end
            if crashT > 0.1 and crashUntil == 0 then
                crashUntil, crashT = now + 2.0, 0
                pcall(ghostOn)
                pc.walls, pc.gndHigh, pc.gc, pc.gn = false, false, {}, 0   -- ระหว่าง noclip ไม่เบรกเพราะกำแพง ทะลุไปเลย
                pc.curV = math.max(pc.curV, lastCmd * 0.6)
                setStatus("💥 ชน → noclip ชั่วคราว")
            end
        end
        if crashUntil > 0 and now >= crashUntil then
            if overlapping() then crashUntil = now + 0.5 else crashOff() end   -- ยังซ้อนในของ: noclip ต่อจนพ้น
        end
        local ghostNow = ghostAll or crashUntil > 0

        if root.CFrame.UpVector.Y < 0.2 and now - lastFlip > 3 then   -- รถพลิกคว่ำ: ตั้งกลับ (จำกัด 3 วิ/ครั้ง)
            lastFlip = now
            root.CFrame = CFrame.new(p + Vector3.new(0, 4, 0)) * (CFrame.lookAt(Vector3.zero, dir).Rotation * relRot)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            pc.curV = 8
        else
            local fwd = (seat and seat.Parent) and seat.CFrame.LookVector or root.CFrame.LookVector
            fwd = Vector3.new(fwd.X, 0, fwd.Z)
            fwd = fwd.Magnitude > 0.1 and fwd.Unit or dir
            local vel = root.AssemblyLinearVelocity
            local av = root.AssemblyAngularVelocity
            if now < revUntil then   -- ถอยหลังตรงๆ
                pc.curV = 8
                lastCmd = 0
                root.AssemblyLinearVelocity = Vector3.new(-fwd.X * 18, vel.Y, -fwd.Z * 18)
                root.AssemblyAngularVelocity = Vector3.new(av.X, 0, av.Z)
            else
                local okS, spd, yaw, info = pcall(RG.pilot.step, pc, p, fwd, dt, now)
                if not okS then   -- นักบินพัง: ปิดเซนเซอร์ ขับตามเส้นธรรมดาต่อ
                    if not errShown then errShown = true; warn("[Pilot] error → ปิดทางลัด/หลบ: " .. tostring(spd)) end
                    pc.shortcut, pc.avoid = false, false
                    okS, spd, yaw, info = pcall(RG.pilot.step, pc, p, fwd, dt, now)
                    if not okS then ok = false; break end
                end
                if pc.err and not errShown then errShown = true; warn("[Pilot] ปิดบางส่วน: " .. tostring(pc.err)) end
                -- ถึง: ห่างเป้า <= ARRIVE หรือ ช่วงจอดมีโต๊ะ/ผนังขวางหน้า แล้วรถช้าลงแล้ว (จอดชิดเท่าที่ได้)
                if info.lastLeg and (info.dF <= ARRIVE or (info.nearBlocked and spd < 4)) then break end
                if now - lastMsg > 1 then
                    lastMsg = now
                    local tag = (info.avoiding and " 🚧หลบ") or (info.shortcut and " ✂️ทางลัด") or ""
                    setStatus(string.format("🧭 ขับ%s%s %.0f studs/s (ห่างเป้า ~%.0f)",
                        wps and string.format(" ตามเส้น %d→%d/%d", info.seg, info.aim, nW) or "ตรง", tag, spd, info.dF))
                end
                local angX, angZ, vy = av.X, av.Z, vel.Y
                if ghostNow then   -- noclip: รถไม่ชนพื้น ต้องคุมเอง ไม่ให้หัว/ท้ายจมดิน
                    local okG, gx, gz, gvy, lift = pcall(RG.groundFollow, root, seat, halfL, halfW, below, fallRP, vel)
                    if okG and gx then
                        angX, angZ = gx, gz
                        if gvy then vy = gvy end
                        if lift and now - gfFix > 0.3 then   -- จมลึก: ยกขึ้นทันที
                            gfFix = now
                            root.CFrame = root.CFrame + Vector3.new(0, lift, 0)
                        end
                    end
                end
                root.AssemblyLinearVelocity = Vector3.new(fwd.X * spd, vy, fwd.Z * spd)
                root.AssemblyAngularVelocity = Vector3.new(angX, yaw, angZ)
                lastCmd = spd
            end
        end
    end

    if ncConn then ncConn:Disconnect() end
    if ghosting or ghostAll or crashUntil > 0 then setNC(root, false) end   -- ถึง/หยุดขับ: คืนการชนรถ+ตัวละคร (noclip เฉพาะตอนขับ)
    -- หมดเวลาแต่ยังห่างเป้าเกิน ARRIVE+60 = ไม่ถือว่าถึง (ไม่ทิ้งรถไกลจุดฟาม)
    if timedOut and not lost and ok and flatDist(root.Position, real) > ARRIVE + 60 then ok = false end
    -- ถึงแล้ว: ปล่อยให้ค่อยๆ เบาลงจนนิ่ง ก่อนล็อก (ไม่ตัดความเร็วเป็น 0 ทันที)
    if ok and not lost and root.Parent then
        RG.calm()
        local v0 = root.AssemblyLinearVelocity
        local h0 = Vector3.new(v0.X, 0, v0.Z)
        local T = math.clamp(h0.Magnitude / 25, 0.4, 1.5)
        local ts = os.clock()
        while root.Parent and not cancelled(tok) do
            RunService.Heartbeat:Wait()
            local f = 1 - (os.clock() - ts) / T
            if f <= 0 then break end
            local vy = root.AssemblyLinearVelocity.Y
            local av = root.AssemblyAngularVelocity
            root.AssemblyLinearVelocity = Vector3.new(h0.X * f * f, vy, h0.Z * f * f)
            root.AssemblyAngularVelocity = Vector3.new(av.X, av.Y * f, av.Z)
        end
        if cancelled(tok) then ok = false end
    end
    if root.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    -- รถหายตอนใกล้เป้า (ขับเข้าจุดฟามแล้วเกมเก็บรถให้เอง) = ถึงแล้ว ไม่ใช่ล้มเหลว
    if lost and ok and flatDist(lastP, real) <= 40 then
        if ghostAll or ghosting or crashUntil > 0 then pcall(setNC, root, false) end
        pcall(RG.release, rig)
        setStatus("🅿️ ขับเข้าจุดแล้ว เกมเก็บรถให้")
        return true, nil, false
    end
    if lost or not ok then
        RG.release(rig)
        return false
    end
    RG.still(root, tok, 0.4)   -- รอรถนิ่งสั้นๆ (ชะลอจนหยุดมาก่อนแล้ว) ก่อนล็อก
    RG.anchor(rig, true)    -- ถึงแล้วล็อกรถไว้จนลงรถ (ผู้เรียกต้อง RG.park)
    RG.calm()
    return true, rig, false
end

-- ตัวเลือกวิธีดึง: speed ใส่มา (โหมดใหม่) + RG.ROUTE.physics = ฟิสิกส์ | ไม่งั้น driveTo เดิม (ล็อก+ย้าย CFrame)
RG.drive = function(real, tok, wps, speed, opts)
    if speed and RG.ROUTE.physics then return RG.driveToPhys(real, tok, wps, speed, opts) end
    return driveTo(real, tok, wps, speed)
end

local function exitCar()
    local hum = getHum()
    if hum and hum.SeatPart then
        lastCarSeat = hum.SeatPart
        hum.Sit = false
        task.wait(0.1)
        if hum.SeatPart then hum.Jump = true end
    end
end

-- ลงจากรถให้เสร็จจริงก่อน แล้วค่อยปลดล็อกรถ
local function exitAndPark(rig, inside)
    exitCar()
    local h = getHum()
    local t0 = os.clock()
    while h and h.SeatPart and os.clock() - t0 < 1 do task.wait(0.05) end
    RG.park(rig, inside)
end

local function ensureCar(tok)
    local hum = getHum()
    if not hum then return false end
    if hum.SeatPart then return true end
    setStatus("🚗 เรียกรถ...")
    pcall(callCar, tok)
    local t0 = os.clock()
    while os.clock() - t0 < CAR_WAIT do
        if cancelled(tok) then return false end
        if hum.SeatPart then task.wait(0.3); return true end
        task.wait(0.2)
    end
    setStatus("⚠️ เบิกรถไม่สำเร็จ")
    waitSec(2, tok)
    return false
end

