-- ==================== ขับตามเส้นนำทางของแผนที่ (แทนวาป) ====================
-- แผนที่ใหญ่: Minimap.Big_Map ... Canvas มีไอคอนฟาร์ม (Position เป็นสัดส่วน) และท่อนเส้นสีน้ำเงิน (Frame สูง 4px เรียงตามลำดับ)
-- วิธี: จับคู่ไอคอนฟาร์มกับพิกัดจริง (POINTS.r) -> ถดถอยเชิงเส้นได้สูตรแปลง -> แปลงท่อนเส้นเป็นพิกัดโลก
RG.mapRoot = function()
    local mm = gui:FindFirstChild("Minimap")
    return mm and mm:FindFirstChild("Big_Map")
end
RG.mapCanvas = function()
    local big = RG.mapRoot()
    return big and big:FindFirstChild("Canvas", true)
end
RG.linfit = function(xs, ys)   -- y = a*x + c
    local n, sx, sy, sxx, sxy = #xs, 0, 0, 0, 0
    for i = 1, n do
        sx += xs[i]; sy += ys[i]; sxx += xs[i] * xs[i]; sxy += xs[i] * ys[i]
    end
    local den = n * sxx - sx * sx
    if math.abs(den) < 1e-9 then return end
    local a = (n * sxy - sx * sy) / den
    return a, (sy - a * sx) / n
end
RG.calib = function(canvas)
    if RG.cal then return RG.cal end
    local xs, zs, us, vs = {}, {}, {}, {}
    for _, p in ipairs(POINTS) do
        local key = (not p.combo) and p.r and farmKey(p)
        local ic = key and canvas:FindFirstChild(key)
        if ic and ic:IsA("GuiObject") then
            xs[#xs + 1] = p.r.X; zs[#zs + 1] = p.r.Z
            us[#us + 1] = ic.Position.X.Scale; vs[#vs + 1] = ic.Position.Y.Scale
        end
    end
    if #xs < 4 then return nil end
    local ax, cx = RG.linfit(xs, us)
    local az, cz = RG.linfit(zs, vs)
    if not (ax and az) or math.abs(ax) < 1e-7 or math.abs(az) < 1e-7 then return nil end
    RG.cal = {ax = ax, cx = cx, az = az, cz = cz}
    return RG.cal
end
RG.segments = function(canvas)   -- ท่อนเส้นทาง (ตัดจุดกลม 4x4 ที่ Size.X.Scale = 0 ออก)
    local list = {}
    for _, c in ipairs(canvas:GetChildren()) do
        if c:IsA("Frame") and c.Size.Y.Offset == 4 and c.Size.X.Scale > 0 then list[#list + 1] = c end
    end
    return list
end

-- ===== หาทางแบบ GPS จริง: ท่อนเส้นบนแผนที่ -> กราฟ -> ทางสั้นสุด (Dijkstra) =====
-- ไม่ต้องเรียงท่อน ไม่ต้องเริ่มบนถนน: จากตัวรถ (อยู่นอกถนนก็ได้) ขับออฟโรดไปเข้าถนนจุดที่คุ้มสุด
-- แล้วตามถนนไปจนเหลือ near studs จากเป้า แล้วตรงเข้าเป้า | ท่อนขาด (ช่องว่าง <= gap) ต่อให้เอง
-- ท่อนเก่าค้าง/กิ่งทางตันไม่มีผล เพราะเลือกทางที่สั้นสุดจริงเท่านั้น
-- คืน: ลิสต์จุด (ไม่รวมตัวรถ/เป้า), info | nil, เหตุผล
RG.graphPath = function(segs, me, goal, o)
    o = o or {}
    local MERGE = o.merge or 18      -- ปลายท่อนห่างกันไม่เกินนี้ = จุดเดียวกัน
    local GAP = o.gap or 220         -- ต่อช่องว่างระหว่างท่อนได้ไม่เกินนี้ (ค่าใช้จ่าย x2)
    local OFF = o.off or 2.5         -- ขับออฟโรดแพงกว่าถนน 2.5 เท่า
    local near = o.near or 600
    local sqrt = math.sqrt
    local function fd(a, b) local dx, dz = a.X - b.X, a.Z - b.Z; return sqrt(dx * dx + dz * dz) end

    local nodes = {}
    local function nodeOf(p)
        for i = 1, #nodes do
            if fd(nodes[i], p) <= MERGE then return i end
        end
        nodes[#nodes + 1] = p
        return #nodes
    end
    local adj = {}
    local function link(i, j, w)
        if i == j then return end
        adj[i] = adj[i] or {}
        adj[j] = adj[j] or {}
        if not adj[i][j] or w < adj[i][j] then adj[i][j] = w; adj[j][i] = w end
    end
    for _, sg in ipairs(segs) do
        local i, j = nodeOf(sg.a), nodeOf(sg.b)
        link(i, j, fd(sg.a, sg.b))
    end
    local n = #nodes
    if n < 2 then return nil, "เส้นบนแผนที่ว่าง" end
    for i = 1, n do
        for j = i + 1, n do
            local ai = adj[i]
            if not (ai and ai[j]) then
                local d = fd(nodes[i], nodes[j])
                if d <= GAP then link(i, j, d * 2) end
            end
        end
    end
    -- โหนดเสมือน: S = ตัวรถ (n+1), G = เป้า (n+2)
    local S, G = n + 1, n + 2
    local dist, prev, done = {}, {}, {}
    for i = 1, G do dist[i] = math.huge end
    dist[S] = 0
    local function relax(u, v, w)
        local nd = dist[u] + w
        if nd < dist[v] then dist[v] = nd; prev[v] = u end
    end
    while true do
        local u, best = nil, math.huge
        for i = 1, G do
            if not done[i] and dist[i] < best then u, best = i, dist[i] end
        end
        if not u or u == G then break end
        done[u] = true
        if u == S then
            for v = 1, n do relax(S, v, fd(me, nodes[v]) * OFF) end
            relax(S, G, fd(me, goal) * OFF)
        else
            local p = nodes[u]
            for v, w in pairs(adj[u] or {}) do relax(u, v, w) end
            local dg = fd(p, goal)
            relax(u, G, (dg <= near) and dg or dg * OFF)   -- ช่วงสุดท้าย <= near ขับตรงเข้าเป้า (ราคาเท่าถนน)
        end
    end
    if dist[G] == math.huge then return nil, "หาทางไม่เจอ" end
    local path = {}
    local v = prev[G]
    while v and v ~= S do
        table.insert(path, 1, nodes[v])
        v = prev[v]
    end
    local info = {nodes = n, cost = dist[G]}
    if #path > 0 then
        info.entry = fd(me, path[1])          -- ระยะออฟโรดไปเข้าถนน
        info.exit = fd(path[#path], goal)     -- ระยะตรงเข้าเป้าช่วงท้าย
    else
        info.entry, info.exit = 0, fd(me, goal)
    end
    return path, info
end

-- คืน wps (ตารางจุดทางผ่านพิกัดโลก) หรือ nil, เหตุผล
-- อ่านท่อนเส้นเป็น "ปลายสองด้าน" (จุดกึ่งกลาง ± ครึ่งความยาว ตามมุมหมุน) แล้วต่อโซ่จากไอคอนตำแหน่งเรา (Icon) ไปหาหมุดปลายทาง (Marker)
-- ไม่พึ่งลำดับ GetChildren และไม่โดนท่อนเก่าค้างปน
-- หมุดบนแผนที่ของจุดนี้: pt.pin > ชื่อฟาร์ม > หมุดที่อยู่ใกล้พิกัด (เช่นโต๊ะคราฟ) | ไม่มี = nil
RG.keyFor = function(pt)
    if pt.pin then return pt.pin end
    if not pt.r then return nil end
    if not pt.combo then return farmKey(pt) end
    return RG.pinFor(pt.r, 400)
end

RG.route = function(pt, tok)
    local R = RG.ROUTE
    local key = RG.keyFor(pt)
    if not key then return nil, "จุดนี้ไม่มีหมุดบนแผนที่" end
    local big, canvas = RG.mapRoot(), RG.mapCanvas()
    if not (big and canvas) then return nil, "ไม่เจอแผนที่ (Minimap/Canvas)" end
    local cal = RG.calib(canvas)
    if not cal then return nil, "คำนวณสูตรแปลงแผนที่ไม่ได้ (ไอคอนฟาร์มไม่ครบ)" end
    local scroll = big:FindFirstChild("scrolling", true)
    local node = scroll and scroll:FindFirstChild(key)
    local pinBtn = node and node:FindFirstChild("Button", true)
    if not pinBtn then return nil, "ไม่เจอปุ่มหมุด " .. key end

    local openedByUs = false
    if not shown(big) then   -- เปิดแผนที่ก่อน (เหมือนที่ผู้เล่นกดจริง)
        local hb = gui:FindFirstChild("Button")
        local mb = hb and hb:FindFirstChild("Minimap")
        if mb then clickBtn(mb); openedByUs = true; waitSec(0.8, tok) end
    end
    local function closeMap()
        if openedByUs then
            local cb = big:FindFirstChild("Close", true)
            if cb then clickBtn(cb) end
        end
    end
    local function toWorld(u, v)
        return Vector3.new((u - cal.cx) / cal.ax, 0, (v - cal.cz) / cal.az)
    end
    local root = getRoot()
    if not root then closeMap(); return nil, "ไม่มีตัวละคร" end
    local me = root.Position

    -- อ่านเส้น ณ ตอนนี้ -> chain (หรือ nil, เหตุผล)
    local function readChain()
        local W, H = canvas.AbsoluteSize.X, canvas.AbsoluteSize.Y
        if W <= 0 or H <= 0 then return nil, "Canvas ยังไม่แสดง (AbsoluteSize=0)" end
        local segs = {}
        for _, f in ipairs(RG.segments(canvas)) do
            local cu = f.Position.X.Scale + f.Position.X.Offset / W
            local cv = f.Position.Y.Scale + f.Position.Y.Offset / H
            local len = f.Size.X.Scale * W + f.Size.X.Offset
            local th = math.rad(f.Rotation)
            local du, dv = math.cos(th) * len / 2 / W, math.sin(th) * len / 2 / H
            segs[#segs + 1] = {a = toWorld(cu - du, cv - dv), b = toWorld(cu + du, cv + dv)}
        end
        if #segs < 3 then return nil, ("เจอท่อนเส้นแค่ %d ชิ้น"):format(#segs) end
        local ic = canvas:FindFirstChild("Icon")
        local mk = canvas:FindFirstChild("Marker")
        local start = (ic and ic:IsA("GuiObject")) and toWorld(ic.Position.X.Scale, ic.Position.Y.Scale) or me
        local dest = (mk and mk:IsA("GuiObject")) and toWorld(mk.Position.X.Scale, mk.Position.Y.Scale) or pt.r
        if flatDist(dest, pt.r) > 700 then
            return nil, ("หมุดปลายทางไม่ใช่ %s (ห่าง %.0f studs) segs=%d"):format(key, flatDist(dest, pt.r), #segs)
        end
        if flatDist(start, me) > 250 then
            warn(("[RouteDrive] ไอคอนบนแผนที่ห่างตัวรถจริง %.0f studs (สูตรแปลงแผนที่คลาด?) ใช้ตำแหน่งรถจริง"):format(flatDist(start, me)))
        end
        -- หาทางแบบ GPS: ท่อนทั้งหมด -> กราฟ -> ทางสั้นสุดจากตัวรถจริง (อยู่นอกถนนก็ได้ ขับออฟโรดเข้าถนนจุดที่คุ้มสุด)
        local okG, chain, gi = pcall(RG.graphPath, segs, me, pt.r, {near = RG.ROUTE.near})
        if not okG then return nil, "คำนวณเส้นทางพัง: " .. tostring(chain) end
        if not chain then return nil, tostring(gi) .. (" segs=%d"):format(#segs) end
        print(("[RouteDrive] %s: ท่อน=%d โหนด=%d จุดทาง=%d ออฟโรดเข้าถนน=%.0f ช่วงท้ายตรง=%.0f studs"):format(
            key, #segs, gi.nodes, #chain, gi.entry, gi.exit))
        return chain, nil, #segs
    end

    -- ปักหมุด แล้วรอให้จำนวนท่อนนิ่ง
    setStatus("🧭 ปักหมุด " .. key .. " บนแผนที่...")
    clickBtn(pinBtn)
    local t0, lastN, stableAt = os.clock(), -1, os.clock()
    while os.clock() - t0 < 6 and not cancelled(tok) do
        local n = #RG.segments(canvas)
        if n ~= lastN then lastN = n; stableAt = os.clock() end
        if n >= 3 and os.clock() - stableAt > 0.8 then break end
        task.wait(0.1)
    end
    if cancelled(tok) then closeMap(); return nil, "ยกเลิก" end
    local chain, why, nseg = readChain()
    if not chain then   -- ลองกดหมุดซ้ำอีกครั้ง (เผื่อครั้งแรกเป็นการเลือก/ยกเลิก)
        warn("[RouteDrive] อ่านเส้นรอบแรกไม่ผ่าน: " .. tostring(why) .. " -> กดหมุดซ้ำ")
        clickBtn(pinBtn)
        waitSec(2.5, tok)
        chain, why, nseg = readChain()
    end
    closeMap()
    if not chain then return nil, why end
    print(("[RouteDrive] %s: segs=%d chain=%d"):format(key, nseg or -1, #chain))

    local wps = {Vector3.new(me.X, me.Y, me.Z)}
    for _, v in ipairs(chain) do
        if flatDist(v, wps[#wps]) >= R.step then wps[#wps + 1] = Vector3.new(v.X, me.Y, v.Z) end
    end
    wps[#wps + 1] = pt.r
    return wps
end

-- หาหมุดบนแผนที่ที่ใกล้พิกัดโลกนี้สุด (ห่างไม่เกิน maxD) -> คืนชื่อหมุด หรือ nil
-- ใช้กับ "ทุกที่" ที่มีหมุด (ฟาร์ม, Garage, Gas, Food, CarShop, Ecconomy ฯลฯ) จุดที่ไม่มีหมุดแถวนั้น = nil
RG.pinFor = function(target, maxD)
    maxD = maxD or 400
    local big, canvas = RG.mapRoot(), RG.mapCanvas()
    if not (big and canvas) then return nil end
    local cal = RG.calib(canvas)
    if not cal then return nil end
    local scroll = big:FindFirstChild("scrolling", true)
    if not scroll then return nil end
    local best, bd
    for _, ic in ipairs(canvas:GetChildren()) do
        if ic:IsA("ImageLabel") and ic.Size.X.Offset == 34 and scroll:FindFirstChild(ic.Name) then
            local w = Vector3.new((ic.Position.X.Scale - cal.cx) / cal.ax, 0, (ic.Position.Y.Scale - cal.cz) / cal.az)
            local d = flatDist(w, target)
            if d <= maxD and (not bd or d < bd) then best, bd = ic.Name, d end
        end
    end
    return best
end

-- สำเร็จ: คืน true, rig, inside (เหมือน driveTo) | ไม่สำเร็จ: false
RG.routeDrive = function(pt, tok)
    local wps, why = RG.route(pt, tok)
    if not wps then
        RG.lastRouteWhy = why
        if not cancelled(tok) then
            warn("[RouteDrive] เส้นนำทางใช้ไม่ได้: " .. tostring(why))
            setStatus("⚠️ เส้นนำทางใช้ไม่ได้: " .. tostring(why))
            waitSec(RG.ROUTE.fallback and 0.8 or 2, tok)
        end
        return false
    end
    local okd, rg, ins = RG.drive(pt.r, tok, wps, RG.ROUTE.speed)
    if okd then RG.lastRouteWhy = nil else RG.lastRouteWhy = "driveTo ล้มเหลวระหว่างทาง (หลุดจากรถ/ถูกยกเลิก)" end
    return okd, rg, ins
end

-- ไปใกล้จุด: ใกล้ = เดิน, ไกล = วาปด้วยรถ (ล็อกรถไว้จนลงเสร็จ) แล้วเดินเข้า
local function goNear(target, tok, noCar, slow, deadline)
    for _ = 1, 6 do
        if cancelled(tok) then return false end
        if deadline and os.clock() > deadline then return false end
        local root, isVeh = getRoot()
        if not root then return false end
        local d = flatDist(root.Position, target)
        if d <= ARRIVE_DIST + 4 then return true end
        if d > WALK_MAX and not isVeh and not noCar then
            setStatus("🚗 ไกล+ไม่มีรถ → ไปเบิก/ขึ้นรถก่อน")
            callCar(tok)
            root, isVeh = getRoot()
        end
        if d > WALK_MAX and isVeh then
            local okw, rig, ins = false, nil, false
            local key = RG.ROUTE.on and d > RG.ROUTE.near and RG.pinFor(target)
            if key then   -- มีหมุดแถวนั้น: ตามเส้นนำทางของแผนที่ แล้วขับตรงช่วงสุดท้ายเข้าเป้า
                setStatus("🧭 ตามเส้นนำทางไปหมุด " .. key .. "...")
                okw, rig, ins = RG.routeDrive({pin = key, n = key, r = target}, tok)
                if not okw then
                    if cancelled(tok) then return false end
                    if RG.ROUTE.fallback == "warp" then
                        okw, rig = warpTo(target, tok, slow, true); ins = false
                    elseif RG.ROUTE.fallback == "drive" then
                        setStatus("🧭 อ่านเส้นไม่ได้ → ขับตรงไปเอง (หลบสิ่งกีดขวางเอง)")
                        okw, rig, ins = RG.drive(target, tok, nil, RG.ROUTE.speed)
                    end
                end
            elseif not RG.ROUTE.on then
                okw, rig = warpTo(target, tok, slow, true)
            else   -- ไม่มีหมุดแถวนั้น: ดึงรถตรง (ไม่วาป)
                okw, rig, ins = RG.drive(target, tok, nil, RG.ROUTE.speed)
            end
            if not okw then return false end
            if FARM_WAIT > 0 then
                setStatus("⏳ ถึงแล้ว รอ " .. FARM_WAIT .. " วิ แล้วลงรถ...")
                waitSec(FARM_WAIT, tok)
            end
            if cancelled(tok) then RG.park(rig, ins); return false end
            exitAndPark(rig, ins)
            task.wait(0.1)
        elseif isVeh then
            exitCar(); task.wait(0.3)
        end
        walkPath(target, tok)
    end
    local root = getRoot()
    return root ~= nil and flatDist(root.Position, target) <= 12
end

