-- พาร์ทน้ำเป็น set อัปเดตสดตามที่สตรีมเข้า/ออก
local waterParts = {}   -- [part]=true
local waterHooked, waterHookAt = false, 0
local function hookWater()
    waterHookAt = os.clock()
    local sys = workspace:FindFirstChild("Systems")
    local wf = sys and sys:FindFirstChild("Water")
    if not wf then return end
    waterHooked = true
    for _, p in ipairs(wf:GetDescendants()) do
        if p:IsA("BasePart") then waterParts[p] = true end
    end
    RG.t(wf.DescendantAdded:Connect(function(p) if p:IsA("BasePart") then waterParts[p] = true end end))
    RG.t(wf.DescendantRemoving:Connect(function(p) waterParts[p] = nil end))
end
hookWater()

local wtParams = RaycastParams.new()
wtParams.FilterType = Enum.RaycastFilterType.Exclude
wtParams.IgnoreWater = false

-- คำนวณจริง (หนัก) : ความสูงผิวน้ำ ณ (x,z) / nil ถ้าไม่ใช่น้ำ
RG.wraw = function(x, z)
    local best
    for w in pairs(waterParts) do
        if w.Parent then
            local rel = w.CFrame:PointToObjectSpace(Vector3.new(x, w.Position.Y, z))
            if math.abs(rel.X) <= w.Size.X / 2 and math.abs(rel.Z) <= w.Size.Z / 2 then
                local top = w.Position.Y + w.Size.Y / 2
                if not best or top > best then best = top end
            end
        end
    end
    if best then return best end
    wtParams.FilterDescendantsInstances = {lp.Character}
    local y = 1000
    for _ = 1, 6 do
        local hit = workspace:Raycast(Vector3.new(x, y, z), Vector3.new(0, -3000, 0), wtParams)
        if not hit then return nil end
        if hit.Material == Enum.Material.Water then return hit.Position.Y end
        if hit.Instance:IsA("Terrain") then return nil end
        y = hit.Position.Y - 0.5
    end
end

-- มีแคชช่อง 4 studs อายุ 1.5 วิ (เดิมเรียกหนักๆ ทุกเฟรมตอนขับ)
local function waterTop(x, z)
    if not waterHooked and os.clock() - waterHookAt > 3 then hookWater() end
    local key = math.floor(x / 4) * 100003 + math.floor(z / 4)
    local now = os.clock()
    local c = RG.wc[key]
    if c and now - c[1] < 1.5 then return c[2] or nil end
    local r = RG.wraw(x, z)
    if RG.wcN > 400 then RG.wc = {}; RG.wcN = 0 end
    RG.wc[key] = {now, r or false}
    RG.wcN += 1
    return r
end

-- ===== ห้ามโผล่ใกล้น้ำ: จุดโผล่ต้องห่างน้ำอย่างน้อย RG.SAFE studs (เช็คเป็นวงรอบจุด 16 ทิศ) =====
RG.SAFE = 100
RG.nearWater = function(x, z, R)
    if waterTop(x, z) then return true end
    for rad = 20, R, 20 do
        for k = 0, 15 do
            local a = math.rad(k * 22.5)
            if waterTop(x + math.cos(a) * rad, z + math.sin(a) * rad) then return true end
        end
    end
    return false
end
-- หาจุดที่ปลอดภัยใกล้ dest (วงรัศมี 40..600) | ไม่เจอเลยคืน nil (ผู้เรียกใช้ dest เดิม)
RG.safeSpot = function(dest)
    if not RG.nearWater(dest.X, dest.Z, RG.SAFE) then return dest end
    local n = 0
    for rad = 40, 600, 40 do
        for k = 0, 15 do
            local a = math.rad(k * 22.5)
            local x, z = dest.X + math.cos(a) * rad, dest.Z + math.sin(a) * rad
            if not RG.nearWater(x, z, RG.SAFE) then return Vector3.new(x, dest.Y, z) end
            n += 1
            if n % 12 == 0 then task.wait() end
        end
    end
    return nil
end

