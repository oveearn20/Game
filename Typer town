do
    local RS = game:GetService("ReplicatedStorage")
    local EAT_FOODS  = {"Sushi", "RiceKapaoMoo", "Sandwish", "Burger", "Curry", "Ramen", "Onigiri"}
    local EAT_DRINKS = {"HotCocoa", "Coffee", "HotCoffee", "IcedCoffee", "Cocoa", "OrangeJuice", "Water"}
    local PCT_MIN, PCT_MAX, PCT_STEP = 10, 95, 5
    local eatOn, eatPct = true, 75
    local CFS = RG.CFS
    local cfsSet = RG.cfsSet
    if type(CFS.eatOn) == "boolean" then eatOn = CFS.eatOn end
    if type(CFS.eatPct) == "number" then eatPct = math.clamp(math.floor(CFS.eatPct / 5 + 0.5) * 5, 10, 95) end
    local cooldownUntil = 0

    local function readHud(names)
        local hud = gui:FindFirstChild("HUD")
        local hp = hud and hud:FindFirstChild("Health")
        if not hp then return nil end
        for _, n in ipairs(names) do
            local f = hp:FindFirstChild(n)
            if f then
                local lb = f:IsA("TextLabel") and f or f:FindFirstChildWhichIsA("TextLabel", true)
                local v = lb and tonumber(string.match(lb.Text, "%d+"))
                if v then return v end
            end
        end
    end
    local function readAttr(names)
        local pd = lp:FindFirstChild("PlayerData")
        if pd then
            for _, n in ipairs(names) do
                local v = pd:GetAttribute(n)
                if type(v) == "number" then return v end
            end
        end
    end
    local function hunger() return readHud({"Hunger"}) or readAttr({"Hunger", "Food"}) end
    local function thirst() return readHud({"Energy", "Stamina", "Thirst", "Coffee", "Brain"}) or readAttr({"Energy", "Stamina", "Thirst"}) end
    local function pick(list)
        local pd = lp:FindFirstChild("PlayerData")
        if not pd then return nil end
        for _, n in ipairs(list) do
            local c = pd:GetAttribute(n)
            if type(c) == "number" and c > 0 then return n end
        end
    end

    local function consume(name)
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        pcall(function() require(RS.Systems.Modules.Core.Remotes).Fire("_inventory", "Use", name) end)
        local tool
        local t0 = os.clock()
        while os.clock() - t0 < 2.5 do
            char = lp.Character
            tool = char and char:FindFirstChild(name)
            if not tool then
                local bp = lp:FindFirstChild("Backpack")
                tool = bp and bp:FindFirstChild(name)
                if tool then pcall(function() hum:EquipTool(tool) end) end
            end
            if tool and tool.Parent == char then break end
            task.wait(0.1)
        end
        if not (tool and tool.Parent == lp.Character) then return false end
        task.wait(0.4)
        pcall(function() tool:Activate() end)
        task.wait(6.3)
        pcall(function() hum:UnequipTools() end)
        return true
    end

    local function tend(read, list, label)
        local v = read()
        if not v or v >= eatPct then return end
        local stopAt = math.min(100, eatPct + 20)
        for _ = 1, 5 do
            v = read()
            if not v or v >= stopAt or not eatOn then break end
            local item = pick(list)
            if not item then
                setStatus("⚠️ ไม่มี" .. label .. "ให้กินแล้ว")
                cooldownUntil = os.clock() + 30
                break
            end
            setStatus(string.format("🍽 กิน %s (%s %d%% < %d%%)", item, label, v, eatPct))
            local before = v
            if not consume(item) then
                setStatus("⚠️ ถือ/กิน " .. item .. " ไม่ได้")
                cooldownUntil = os.clock() + 20
                break
            end
            task.wait(0.5)
            local after = read()
            if after and after <= before then
                setStatus(string.format("⚠️ กิน %s แล้ว%sไม่เพิ่ม (%d%%) พัก 60 วิ", item, label, after))
                cooldownUntil = os.clock() + 60
                break
            end
        end
    end

    local EP = RG.page.eat
    RG.UI.Label(EP, "กินอัตโนมัติ")
    local eatInfo = RG.UI.StatusRow(EP, "🍴 หิว ?   💧 น้ำ ?")
    local function refreshEatUI()
        local h, t = hunger(), thirst()
        eatInfo(string.format("🍴 หิว %s   💧 น้ำ %s   (กินเมื่อ < %d%%)%s", h and h .. "%" or "?", t and t .. "%" or "?",
            eatPct, eatOn and "" or "  [ปิด]"))
    end
    RG.UI.Toggle(EP, "กินอัตโนมัติ (ไม่กินตอนนั่งรถ)", eatOn, function(on)
        eatOn = on; cooldownUntil = 0; cfsSet("eatOn", eatOn); pcall(refreshEatUI)
    end)
    RG.UI.Stepper(EP, "กินเมื่อต่ำกว่า", PCT_MIN, PCT_MAX, PCT_STEP, eatPct, function(v) return v .. "%" end, function(v)
        eatPct = v; cfsSet("eatPct", eatPct); pcall(refreshEatUI)
    end)
    pcall(refreshEatUI)

    task.spawn(function()
        local eating = false
        while sg.Parent do
            task.wait(2)
            RG.safe("eatUI", refreshEatUI)
            RG.safe("eat", function()
                if eatOn and not eating and os.clock() >= cooldownUntil then
                    local ch = lp.Character
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and not hum.SeatPart then
                        eating = true
                        RG.safe("eatFood", tend, hunger, EAT_FOODS, "หิว")
                        RG.safe("eatDrink", tend, thirst, EAT_DRINKS, "น้ำ")
                    end
                end
            end)
            eating = false
        end
    end)

    -- ===== AUTO RUN: กด Shift ครั้งเดียวแล้วค้างไว้ | กดใหม่เฉพาะตอน "หลุด" (ปุ่มถูกปล่อย หรือ เลิกวิ่ง) =====
    -- ไม่ปล่อยตอนหยุดเดิน (เดินต่อได้ปกติ) | ปล่อยเฉพาะตอนนั่งรถ (Shift ในรถอาจเป็นไนตรัส/เบรกมือ) แล้วลงรถกดให้ใหม่ 1 ครั้ง
    local VIMr
    pcall(function() VIMr = game:GetService("VirtualInputManager") end)
    local runOn = true
    if type(CFS.runOn) == "boolean" then runOn = CFS.runOn end
    local RUN = {held = false, base = nil, char = nil, fresh = false, pressedAt = 0, keyOK = nil,
        moveAt = nil, sawRun = false, tryAt = 0, tryN = 0, gaveUp = false, btnUsed = false,
        runSince = nil, runLen = 99, dropAt = nil}

    RG.UI.Label(EP, "วิ่งอัตโนมัติ")
    local runInfo = RG.UI.StatusRow(EP, "")
    local function paint(c) pcall(runInfo, c) end
    paint(runOn and "🟢 วิ่งอัตโนมัติ: พร้อม" or "⚪ วิ่งอัตโนมัติ: ปิด")

    local function key(down)
        if not VIMr then return false end
        return pcall(function() VIMr:SendKeyEvent(down, Enum.KeyCode.LeftShift, false, game) end)
    end
    local function press()            -- กดลงครั้งเดียว (ค้างไว้)
        if key(true) then
            RUN.held, RUN.pressedAt = true, os.clock()
            return true
        end
        return false
    end
    local function release()
        if RUN.held then key(false) end
        RUN.held = false
    end
    local function repress()          -- ยกแล้วกดใหม่ 1 ครั้ง
        key(false)
        task.wait(0.08)
        RUN.held = false
        press()
    end
    local function shiftDown()
        local ok, v = pcall(function() return UIS:IsKeyDown(Enum.KeyCode.LeftShift) end)
        return ok and v == true
    end
    RG.UI.Toggle(EP, "วิ่งอัตโนมัติ (ตอนเดินเท้า)", runOn, function(on)
        runOn = on
        if not runOn then release(); paint("⚪ วิ่งอัตโนมัติ: ปิด") else paint("🟢 วิ่งอัตโนมัติ: พร้อม") end
        cfsSet("runOn", runOn)
    end)

    local function findRunButton()
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("GuiButton") and d.Visible and not d:IsDescendantOf(sg) then
                local n = d.Name:lower()
                if n:find("sprint") or n:find("dash") or n == "run" or n:find("runbutton") or n:find("runbtn") then return d end
            end
        end
    end
    -- วิ่งอยู่ไหม: WalkSpeed สูงกว่าความเร็วเดินปกติ หรือ ความเร็วจริงเกิน 1.25 เท่า
    local function running(hum)
        local base = RUN.base
        if not base or base <= 0 then return false end
        if (tonumber(hum.WalkSpeed) or 0) > base + 0.5 then return true end
        local rp = hum.RootPart
        if rp then
            local v = rp.AssemblyLinearVelocity
            if Vector3.new(v.X, 0, v.Z).Magnitude > base * 1.25 then return true end
        end
        return false
    end

    local function runStep()
        local now = os.clock()
        if not runOn then release() return end
        if not VIMr then paint("⚠️ executor นี้กดปุ่มแทนไม่ได้ (ไม่มี VirtualInputManager)") return end
        local ch = lp.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hum or (tonumber(hum.Health) or 0) <= 0 then return end
        local ws = tonumber(hum.WalkSpeed) or 0
        if ch ~= RUN.char then   -- ตัวละครใหม่ (เกิดใหม่): จำความเร็วเดินก่อนกด แล้วกดใหม่ 1 ครั้ง
            RUN.char = ch
            RUN.base = (ws > 0 and not hum.SeatPart) and ws or RUN.base
            RUN.sawRun, RUN.tryN, RUN.gaveUp, RUN.btnUsed, RUN.moveAt = false, 0, false, false, nil
            RUN.fresh = RUN.held
        end
        if hum.SeatPart then
            if RUN.held then release() end
            paint("🚗 นั่งรถ → ปล่อย Shift (ลงรถแล้วกดให้ใหม่)")
            return
        end
        local okT, tb = pcall(function() return UIS:GetFocusedTextBox() end)
        if okT and tb then return end   -- กำลังพิมพ์แชต ไม่กด
        if ws > 0 and (not RUN.base or ws < RUN.base) then RUN.base = ws end

        -- 1) ยังไม่ได้กด (เพิ่งเปิด/ลงรถ/เกิดใหม่) -> กดครั้งเดียว
        if not RUN.held or RUN.fresh then
            if RUN.fresh then RUN.fresh = false; repress() else press() end
            RUN.keyOK = nil
            paint("🟢 กด Shift ค้างไว้แล้ว")
            return
        end
        -- 2) ปุ่ม Shift หลุด (เช่น สลับหน้าต่าง) -> กดใหม่ | เช็คได้เฉพาะ executor ที่ IsKeyDown เห็นปุ่มที่กดแทน
        if RUN.keyOK == nil and now - RUN.pressedAt > 0.3 then RUN.keyOK = shiftDown() end
        if RUN.keyOK and not shiftDown() then
            RUN.held = false
            press()
            paint("🟠 Shift หลุด → กดใหม่แล้ว")
            return
        end
        -- 3) เลิกวิ่ง (กำลังเดินอยู่ 1.2 วิ แต่ไม่เร็วขึ้น) -> กดใหม่ 1 ครั้ง (ลองถี่สุดทุก 3 วิ, 3 ครั้งแล้วยังไม่ติด ห่างเป็น 15 วิ)
        local md = hum.MoveDirection
        local moving = md ~= nil and md.Magnitude > 0.1
        if moving then RUN.moveAt = RUN.moveAt or now else RUN.moveAt = nil end
        if not (moving and now - RUN.moveAt > 1.2) then
            if not moving then paint("🟢 กด Shift ค้างไว้แล้ว") end
            return
        end
        if running(hum) then
            RUN.sawRun, RUN.tryN, RUN.dropAt = true, 0, nil
            RUN.runSince = RUN.runSince or now
            paint("🟢 วิ่งอยู่")
            return
        end
        if RUN.runSince then   -- เพิ่งเลิกวิ่ง: จำว่าวิ่งได้นานแค่ไหน
            RUN.runLen, RUN.runSince, RUN.dropAt = now - RUN.runSince, nil, now
        end
        if RUN.gaveUp then paint("🟢 กด Shift ค้างไว้แล้ว") return end
        -- วิ่งได้สั้นกว่า 5 วิ แล้วหลุด = แรงหมด: รอ 8 วิให้แรงคืนก่อน (ไม่วิ่งๆ หยุดๆ) | ปกติรอ 3 วิ | ลองแล้วไม่ติด 3 ครั้ง = ห่างเป็น 15 วิ
        local gap = (RUN.tryN >= 3) and 15 or ((RUN.sawRun and RUN.runLen < 5) and 8 or 3)
        if now - math.max(RUN.tryAt, RUN.dropAt or 0) < gap then return end
        RUN.tryAt, RUN.tryN = now, RUN.tryN + 1
        if RUN.tryN >= 3 and not RUN.sawRun then
            -- กด Shift แล้วไม่เคยวิ่งเลย: ลองปุ่มวิ่งของเกม 1 ครั้ง (มือถือบางรุ่น) แล้วเลิกกดซ้ำ (ไม่รบกวนการเดิน)
            local b = (not RUN.btnUsed) and findRunButton()
            if b and RG.clickBtn then RUN.btnUsed = true; pcall(RG.clickBtn, b) end
            RUN.gaveUp = true
            paint("🟢 กด Shift ค้างไว้แล้ว (ตรวจสถานะวิ่งไม่ได้)")
            return
        end
        repress()
        paint("🟠 วิ่งหลุด → กด Shift ใหม่ (" .. RUN.tryN .. ")")
    end
    task.spawn(function()
        while sg.Parent do
            task.wait(0.25)
            RG.safe("autoRun", runStep)
        end
        release()
    end)
    sg.Destroying:Connect(function() release() end)
end

