sellAll = function(pt, tok, force)
    for attempt = 1, SELL_TRIES do
        if cancelled(tok) then return false end
        if not force then
            local c0, m0 = invCount(pt)
            if c0 and m0 and c0 < m0 then return true end
        end
        do local ca, ma = invCount(pt); setStatus(string.format("💰 ไปจุดขาย (รอบ %d/%d) กระเป๋า %s/%s", attempt, SELL_TRIES, tostring(ca), tostring(ma))) end
        if goNear(SELL_POS, tok, false, true) then
            local pp, tw = nil, os.clock()
            while os.clock() - tw < 5 and not cancelled(tok) do
                pp = findSellPrompt()
                if pp then break end
                task.wait(0.3)
            end
            if pp then
                local ui, btn
                local t0 = os.clock()
                while os.clock() - t0 < SELL_PRESS_WINDOW and not cancelled(tok) do
                    ui, btn = sellUI()
                    if btn then break end
                    pressPrompt(pp)
                    task.wait(0.2)
                end
                if btn then
                    task.wait(0.4)
                    local sold = false
                    local cBefore = invCount(pt)
                    for _ = 1, 3 do
                        if cancelled(tok) then break end
                        setStatus("💰 กดขายทั้งหมด...")
                        local tClick = os.clock()
                        clickBtn(btn)
                        local confirmed = false
                        while os.clock() - tClick < 4 and not cancelled(tok) do
                            if lastMoneyMsg >= tClick then confirmed = true; break end
                            local c0 = invCount(pt)
                            if c0 == 0 and cBefore and cBefore > 0 then confirmed = true; break end
                            task.wait(0.15)
                        end
                        if confirmed then
                            local t2 = os.clock()
                            while os.clock() - t2 < 3 and not cancelled(tok) do
                                local c1 = invCount(pt)
                                if c1 == nil or c1 == 0 then break end
                                task.wait(0.2)
                            end
                            sold = true
                            break
                        end
                    end
                    if not sold then
                        local c, m = invCount(pt)
                        if c and m and c < m then sold = true end
                    end
                    if sold then setStatus("✅ ขายสำเร็จ ยืนยันแล้ว") end
                    closeSellUI()
                    if sold then return true end
                end
