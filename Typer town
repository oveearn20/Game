local function findOwnCarModel(me)
    local best, bd
    local function consider(m)
        if m and m.Parent and isMine(m) then
            local seat = seatOf(m)
            local pos = seat and seat.Position
            if not pos then
                local pp = m.PrimaryPart
                pos = pp and pp.Position
            end
            if pos then
                local d = (pos - me).Magnitude
                if d <= TRUNK_CAR_RANGE and (not bd or d < bd) then best, bd = m, d end
            end
        end
    end
    if lastCarSeat and lastCarSeat.Parent then consider(RG.model(lastCarSeat)) end
    local sys = workspace:FindFirstChild("Systems")
    local vf = sys and sys:FindFirstChild("Vehicles")
    if vf then
        for _, m in ipairs(vf:GetChildren()) do consider(m) end
    end
    return best, bd
end
