        task.wait(1)
        return
    end

    local root = getRoot()
    if not root then task.wait(0.5); return end
    local seated = hum.SeatPart ~= nil
    if seated then lastCarSeat = hum.SeatPart end

    -- 1) เช็คกระเป๋า: เต็ม = ไปขายก่อน
    local cnt, cap = invCount(pt)
    if stopWhenFull and ((cnt and cap and cnt >= cap) or (fullTok == tok and fullReal)) then
        return "full"
    end
    local fresh = os.clock() - lastSoldAt >= 8
    if cnt and cap then
        if cnt < cap then
            if fullTok == tok then fullTok = -1; fullReal = false end
            fullSince = nil
        elseif fresh then
            fullSince = fullSince or os.clock()
            if os.clock() - fullSince >= 1.5 then fullTok = tok; fullReal = true end
        end
    else
        fullSince = nil
    end

    if fullTok == tok and (fullReal or (cnt and cap)) then
        if not AUTO_SELL then
            setStatus("🎒 ของเต็ม (ปิดขายอัตโนมัติ)")
            task.wait(0.5)
            return
        end
        if os.clock() < sellBackoffUntil then
            setStatus(string.format("⏳ ขายไม่สำเร็จ รอลองใหม่ %d วิ", math.ceil(sellBackoffUntil - os.clock())))
            task.wait(0.5)
            return
        end
        -- เก็บท้ายรถ: รถถูกเก็บไว้ที่จุดฟาม -> เรียกรถออกมาก่อน แล้วค่อยใส่ของ
        if TRUNK_ON and not trunkDisabled and not trunkFull and not pt.combo then
            local r0 = getRoot()
            if r0 and RG.findOwnCar and not RG.findOwnCar(r0.Position) then
                setStatus("🚗 กระเป๋าเต็ม → เรียกรถมาเก็บของ")
                ensureCar(tok)
                if cancelled(tok) then return end
            end
        end
        if stashTry(farmKey(pt), tok) then
            fullTok = -1; fullReal = false; presses = 0; fullSince = nil
            lastSoldAt = os.clock()
            -- ใส่เสร็จ: ขับรถเข้าจุดฟามให้เกมเก็บรถทุกรอบ (ไม่ทิ้งรถไว้ข้างนอก) แล้วฟามต่อ
            local r1 = getRoot()
            if not pt.combo and r1 and RG.findOwnCar and RG.findOwnCar(r1.Position) then
                setStatus("📦 ใส่ท้ายรถแล้ว → ขับรถเข้าจุดฟามให้เกมเก็บรถ")
                carWarp(pt, tok)
                if cancelled(tok) then return end
            end
            setStatus("📦 ใส่ท้ายรถแล้ว กลับไปฟามต่อ")
            return
        end
        if cancelled(tok) then return end
        local _, inCar = getRoot()
        if not inCar then
            setStatus("🚗 เต็ม → หารถ/ขึ้นรถ")
            callCar(tok)
            if cancelled(tok) then return end
        end
        if sellAll(pt, tok) then
            if RG.shouldUnload() then RG.unloadAll(farmKey(pt), pt, tok) end   -- ท้ายรถเต็ม: เอาของทุกชนิดในท้ายรถมาขายด้วย
            if cancelled(tok) then return end
            fullTok = -1; fullReal = false; presses = 0
            lastSoldAt = os.clock()
            setStatus("✅ ขายหมดแล้ว กลับไปฟาม")
        elseif not cancelled(tok) then
            sellBackoffUntil = os.clock() + 5
        end
        return
    end

    -- 2) ไปให้ถึงพิกัดฟาม
    local d = flatDist(root.Position, pt.r)
    if seated or d > RANGE then
        presses = 0
        goBack(pt, tok, d, seated)
        return
    end

    -- 3) ฟาม
    if fullTok == tok then
        if os.clock() - fullAt < FULL_RETRY then
            setStatus("🎒 ของเต็ม? — รอ/เช็คทุก " .. FULL_RETRY .. " วิ")
            return
        end
        local ps = findPrompts(pt)
        if #ps > 0 then pressPrompt(ps[1]) end
        fullAt = os.clock()
        for _ = 1, 8 do
            task.wait(0.05)
            if farmStarted() then fullTok = -1; presses = 0; return end
            if reallyFull(pt) then fullReal = true; return end
        end
        return
    end

    if farmStarted() then
        presses = 0
        setStatus(cnt and string.format("🌾 กำลังฟาม %s (%d/%d)", pt.n, cnt, cap) or ("🌾 กำลังฟาม " .. pt.n))
        return
    end

    if presses >= MAX_PRESS then
        fullTok = tok; fullAt = os.clock(); fullReal = false
        presses = 0
        return
    end

    local ps = findPrompts(pt)
    if #ps == 0 then
        setStatus("⚠️ ไม่พบปุ่มฟาม " .. pt.n)
        task.wait(0.5)
        return
    end
    pressPrompt(ps[1])
    presses = presses + 1
    setStatus(string.format("🌾 กดฟามรัวๆ... (%d ครั้ง) %s", presses, pt.n))

    for _ = 1, 8 do
        task.wait(0.05)
        if farmStarted() then return end
        if reallyFull(pt) then
            fullTok = tok; fullAt = os.clock(); fullReal = true
            setStatus("🎒 ของเต็ม " .. pt.n)
            return
        end
    end
end

