local function farLanding(pt)
    local r = pt.r or pt.p
    local base = pt.p or r
    local dir = Vector3.new(base.X - r.X, 0, base.Z - r.Z)
    if dir.Magnitude < 1 then
        local root = getRoot()
        dir = root and Vector3.new(root.Position.X - r.X, 0, root.Position.Z - r.Z) or Vector3.zero
        if dir.Magnitude < 1 then dir = Vector3.new(1, 0, 0) end
    end
    local dist = math.max(LAND_FAR, dir.Magnitude)
    dir = dir.Unit
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {lp.Character}
    rp.IgnoreWater = true
    local others = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp then
            local ch = pl.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then others[#others + 1] = hrp.Position end
        end
    end
    local function nearestPlayer(x, z)
        local m = 5000
        for _, o in ipairs(others) do
            local dd = Vector3.new(o.X - x, 0, o.Z - z).Magnitude
            if dd < m then m = dd end
        end
        return m
    end
    local function nearWater(x, z)
        return RG.nearWater(x, z, RG.SAFE)   -- ห้ามใกล้น้ำ 100 studs
    end
    local best, bestScore
    for _, ang in ipairs({0, 25, -25, 50, -50, 80, -80, 120, -120, 160, -160, 180}) do
        local d = CFrame.Angles(0, math.rad(ang), 0):VectorToWorldSpace(dir)
        local x, z = r.X + d.X * dist, r.Z + d.Z * dist
        if not nearWater(x, z) then
            local hit = workspace:Raycast(Vector3.new(x, r.Y + 600, z), Vector3.new(0, -1500, 0), rp)
            local pos, penal
            if hit then
                if hit.Position.Y <= r.Y + 60 and hit.Position.Y >= r.Y - 120 then
                    pos = Vector3.new(x, hit.Position.Y, z)
                end
            else
                pos, penal = Vector3.new(x, base.Y, z), true
            end
            if pos then
                local sc = nearestPlayer(x, z) - (penal and 500 or 0)
                if not penal and sc >= PLAYER_CLEAR then return pos end
                if not best or sc > bestScore then best, bestScore = pos, sc end
            end
        end
    end
    return best or base
end

-- วาปด้วยรถ -> ขับไปพิกัดจริง -> รอ -> ลงรถ -> ค่อยปลดล็อกรถ
local function carWarp(pt, tok)
    if not ensureCar(tok) then return false end
    if cancelled(tok) then return false end
    -- มีจุดผ่าน (โต๊ะคราฟ): ไปจุดผ่านก่อน (ตามเส้นแผนที่ ใช้ noclip ได้) แล้ววิ่งต่อเข้าพิกัดจริงในเที่ยวเดียว
    -- ห้ามตัดข้ามจุดผ่าน | ถึงจุดผ่านแล้วปิด noclip (ไม่ทะลุกำแพงเข้าเป้า)
    if pt.via and pt.r and RG.ROUTE.on and RG.ROUTE.physics then
        local rN = getRoot()
        local me = rN and rN.Position
        if not me then return false end
        local wps, vi
        if flatDist(me, pt.via) > 25 and flatDist(me, pt.r) > 60 then
            local viaPt = {n = pt.n .. " (จุดผ่าน)", r = pt.via, combo = true}
            if flatDist(me, pt.via) >= RG.ROUTE.near and RG.keyFor(viaPt) then
                setStatus("🧭 ขับตามเส้นนำทางไปจุดผ่าน " .. pt.n .. "...")
                local w, why = RG.route(viaPt, tok)
                if cancelled(tok) then return false end
                if w then wps = w else warn("[RouteDrive] ไปจุดผ่าน: เส้นใช้ไม่ได้ (" .. tostring(why) .. ") → ขับตรง") end
            end
            wps = wps or {Vector3.new(me.X, me.Y, me.Z), pt.via}
            wps[#wps] = pt.via
            vi = #wps
        else
            wps = {Vector3.new(me.X, me.Y, me.Z)}
        end
        wps[#wps + 1] = pt.r
        setStatus("🚗 ไป " .. pt.n .. " ผ่านจุดทางเข้า...")
        local okd, rig, ins = RG.drive(pt.r, tok, wps, RG.ROUTE.speed, {solidFrom = vi, noclip = vi ~= nil})
        if not okd then return false end
        if cancelled(tok) then RG.park(rig, ins); return false end
        if FARM_WAIT > 0 then
            setStatus("⏳ ถึงแล้ว รอ " .. FARM_WAIT .. " วิ แล้วลงรถ...")
            waitSec(FARM_WAIT, tok)
        end
        if cancelled(tok) then RG.park(rig, ins); return false end
        setStatus("🚪 ถึงแล้ว → ลงรถ")
        exitAndPark(rig, ins)
        return true
    end
    local rig, inside
    local routed = false
    local useWarp = not RG.ROUTE.on
    local rN = getRoot()
    local nearTarget = rN and pt.r and flatDist(rN.Position, pt.r) < RG.ROUTE.near
    local routeKey = RG.ROUTE.on and pt.r and RG.keyFor and RG.keyFor(pt)   -- ไม่มีหมุด (เช่นโต๊ะคราฟ) = ขับตรง ไม่ใช่ล้มเหลว
    if routeKey and RG.routeDrive and not nearTarget then   -- โหมดใหม่: ตามเส้นนำทางของแผนที่ (ไม่วาป)
        setStatus("🧭 ขับตามเส้นนำทางไป " .. pt.n .. "...")
        local okd, rg, ins = RG.routeDrive(pt, tok)
        if okd then
            rig, inside, routed = rg, ins, true
            if cancelled(tok) then RG.park(rig, inside); return false end
        else
            if cancelled(tok) then return false end
            local fb = RG.ROUTE.fallback
            if not fb then return false end
            setStatus("⚠️ ตามเส้นไม่ได้ (" .. tostring(RG.lastRouteWhy) .. ") → " .. (fb == "warp" and "ใช้วาปแทน" or "ขับตรงแทน"))
            task.wait(1.5)
            useWarp = (fb == "warp")
        end
    end
    if not routed then
        if useWarp then
            setStatus("🚗 วาปไป " .. pt.n .. "...")
            if not warpTo(farLanding(pt), tok, false, false) then return false end   -- ปลด+รอนิ่ง ล้อลงพื้นจริง
            if cancelled(tok) then return false end
        end
        if pt.r then
            setStatus("🚗 ขับไปพิกัดจริง " .. pt.n .. "...")
            local okd, rg, ins = RG.drive(pt.r, tok, nil, (not useWarp) and RG.ROUTE.speed or nil)
            if not okd then return false end
            rig, inside = rg, ins
            if cancelled(tok) then RG.park(rig, inside); return false end
        end
    end
    if FARM_WAIT > 0 then
        setStatus("⏳ ถึงแล้ว รอ " .. FARM_WAIT .. " วิ แล้วลงรถ...")
        waitSec(FARM_WAIT, tok)                      -- รถยังล็อกอยู่ ไม่พุ่ง
    end
    if cancelled(tok) then RG.park(rig, inside); return false end
    setStatus("🚪 ถึงแล้ว → ลงรถแล้วกดฟามเลย")
    exitAndPark(rig, inside)
    if pressFarmNow and not cancelled(tok) then pcall(pressFarmNow, pt) end   -- ลงรถแล้วกดทันที
    return true
end

