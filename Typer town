local function trunkMove(side, key, tok)
    local before = stCount(side, key)
    local w0 = stWeight()
    if not before or before <= 0 then trunkWhy = "ไม่มีของฝั่ง " .. side; return 0, before, w0, w0 end
    local methods = {"sig", "all", "tap"}
    if trunkMethod then table.insert(methods, 1, trunkMethod) end
    local tried = {}
    for _, m in ipairs(methods) do
        if not tried[m] then
            tried[m] = true
            if cancelled(tok) then return 0, before, w0, w0 end
            local btn = stChild("Scrolling", side, "Scrolling", key, "Holder", "Button")
            if not btn then trunkWhy = "ไม่เจอปุ่มไอเท็ม " .. side .. "/" .. key; return 0, before, w0, w0 end
            trunkClick(btn, m)
            waitSec(0.6, tok)
            local mx = stChild("Menu", "Main", "Amount", "Max")
            local cf = stChild("Menu", "Main", "Button", "Confirm")
            if not (mx and cf) then trunkWhy = "ไม่เจอปุ่ม Max/Confirm"; return 0, before, w0, w0 end
            trunkClick(mx, m)
            waitSec(0.4, tok)
            trunkClick(cf, m)
            local t0 = os.clock()
            local moved = false
            while os.clock() - t0 < 3.5 and not cancelled(tok) do
                task.wait(0.15)
                if (stCount(side, key) or 0) < before then moved = true; break end
            end
            if moved then
                if trunkMethod ~= m then trunkMethod = m; setStatus("✅ กดปุ่มท้ายรถได้ผลด้วยวิธี " .. m) end
                waitSec(0.5, tok)
                local after = stCount(side, key) or 0
                return math.max(0, before - after), before, w0, stWeight()
            end
            trunkWhy = "กดแบบ " .. m .. " แล้วจำนวนไม่เปลี่ยน"
        end
    end
    return 0, before, w0, w0
end

local function stashItem(key, tok)
    for attempt = 1, 2 do
        local opened, why = openTrunk(tok, attempt > 1)
        if cancelled(tok) then return "fail" end
        if not opened then
            lastStashWhy = tostring(why)
            if why ~= "nocar" and why ~= "cancel" then trunkFails += 1 end
            pcall(closeTrunk)
            setStatus("⚠️ เปิดท้ายรถไม่ได้ (" .. tostring(why) .. ") → ขายตามเดิม")
            return "fail"
        end
        local have = stCountWait("Inventory", key, 1.5, tok)
        if not have or have <= 0 then
            if attempt == 2 then lastStashWhy = "ไม่เห็นของในกระเป๋า(UI)"; pcall(closeTrunk); return "none" end
        else
            local cur, cap = stWeight()
            local unit = trunkUnit[key]
            if unit and cur and cap and (cap - cur) < unit * have then
                pcall(closeTrunk)
                trunkFull = true
                lastStashWhy = "น้ำหนักท้ายรถเต็ม"
                return "full"
            end
            setStatus(string.format("📦 ใส่ %s %d ชิ้นเข้าท้ายรถ...", key, have))
            local moved, _, w0, w1 = trunkMove("Inventory", key, tok)
            if moved > 0 then
                trunkFails = 0
                trunkStock[key] = (trunkStock[key] or 0) + moved
                if w0 and w1 and w1 > w0 then trunkUnit[key] = (w1 - w0) / moved end
                if w1 and cap then trunkRoom = cap - w1 end
                local left = stCount("Inventory", key) or 0
                pcall(closeTrunk)
                if left > 0 then trunkFull = true end
                return "ok"
            end
        end
    end
    pcall(closeTrunk)
    do
        local cw, cc = stWeight()
        if cw and cc and cc - cw < 0.2 then trunkFull = true end
    end
    trunkFails += 1
    lastStashWhy = "ย้ายไม่ได้: " .. trunkWhy
    setStatus("⚠️ ใส่ท้ายรถไม่ได้ (" .. trunkWhy .. ") " .. trunkFails .. "/" .. TRUNK_FAIL_MAX)
    return "fail"
end

