local function trySit(seat)
    local hum = getHum()
    if not (hum and seat) then return false end
    local model = RG.model(seat)
    local pp = seat:FindFirstChildWhichIsA("ProximityPrompt", true)
        or (model and model:FindFirstChildWhichIsA("ProximityPrompt", true))
    for _ = 1, 3 do
        if pp then pressPrompt(pp) end
        local t0 = os.clock()
        while os.clock() - t0 < 1.2 do
            if hum.SeatPart then lastCarSeat = hum.SeatPart; return true end
            task.wait(0.2)
        end
        pcall(function() seat:Sit(hum) end)
        task.wait(0.4)
        if hum.SeatPart then lastCarSeat = hum.SeatPart; return true end
    end
    return false
end

local function isMine(m)
    return m and (m:GetAttribute("OwnerId") == lp.UserId or m:GetAttribute("Owner") == lp.Name)
end

local function seatOf(m)
    local seat = m:FindFirstChild("DriveSeat")
    if seat then return seat end
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("VehicleSeat") or d:IsA("Seat") then return d end
    end
end

local function findOwnCar(me)
    if lastCarSeat and lastCarSeat.Parent and not lastCarSeat.Occupant then
        local m = RG.model(lastCarSeat)
        if isMine(m) then
            local d = (lastCarSeat.Position - me).Magnitude
            if d <= OWN_CAR_RANGE then return lastCarSeat, d end
        end
    end
    local sys = workspace:FindFirstChild("Systems")
    local vf = sys and sys:FindFirstChild("Vehicles")
    if not vf then return end
    local best, bd
    for _, m in ipairs(vf:GetChildren()) do
        if isMine(m) then
            local seat = seatOf(m)
            if seat and not seat.Occupant then
                local d = (seat.Position - me).Magnitude
                if d <= OWN_CAR_RANGE and (not bd or d < bd) then best, bd = seat, d end
            end
        end
    end
    return best, bd
end

callCar = function(tok)
    local deadline = os.clock() + CALLCAR_MAX
    do
        local h0 = getHum()
        if h0 and h0.SeatPart then return end
    end
    local root = getRoot()
    local me = root and root.Position or Vector3.zero

    local seat, sd = findOwnCar(me)
    if seat then
        setStatus(string.format("🚗 ขึ้นรถตัวเอง (ห่าง %.0f)", sd))
        if goNear(seat.Position, tok, true, false, deadline) and trySit(seat) then return end
        if cancelled(tok) then return end
    end

    local order = {}
    for _, v in ipairs(CAR_SPAWNS) do
        table.insert(order, {pos = v, dist = (Vector3.new(v.X, 0, v.Z) - Vector3.new(me.X, 0, me.Z)).Magnitude})
    end
    table.sort(order, function(a, b) return a.dist < b.dist end)

    local tryList = {}
    local function flat(v, w) return (Vector3.new(v.X, 0, v.Z) - Vector3.new(w.X, 0, w.Z)).Magnitude end
    do
        local best, bd
        for _, v in ipairs(FARM_SPAWNS) do
            local dd = flat(v, me)
            if not bd or dd < bd then best, bd = v, dd end
        end
        if best and bd <= NEAR_SPAWN_RANGE then tryList[#tryList + 1] = {pos = best, dist = bd} end
    end
    for i = 1, 2 do
        local e = order[i]
        if e then
            local used = false
            for _, t in ipairs(tryList) do if t.pos == e.pos then used = true end end
            if not used then tryList[#tryList + 1] = e end
        end
    end
    for i = 1, #tryList do
      for attempt = 1, 2 do
        if os.clock() > deadline or cancelled(tok) then return end
        local sp = tryList[i]
        local hum0 = getHum()
        if hum0 and hum0.SeatPart then return end
        if attempt > 1 then
            setStatus(string.format("🔁 เบิกไม่ติด ลองซ้ำที่จุดเดิม (รอบ %d/2)", attempt))
            task.wait(0.8)
            local r4 = getRoot()
            local seat4 = r4 and findOwnCar(r4.Position)
            if seat4 and trySit(seat4) then return end
        else
            setStatus(string.format("🚗 ไปจุดเบิกรถ (ห่าง %.0f)", sp.dist))
        end
        if not goNear(sp.pos, tok, true, false, deadline) then
            if cancelled(tok) then return end
        else
            local pp
            local t0 = os.clock()
            while os.clock() - t0 < 4 and not cancelled(tok) do
                local r2 = getRoot()
                local pos = r2 and r2.Position or sp.pos
                local bd
                local sysF = workspace:FindFirstChild("Systems")
                for _, rootName in ipairs({"Car_Spawn", "Farm"}) do
                    local cs = sysF and sysF:FindFirstChild(rootName)
                    if cs then
                        for _, d in ipairs(cs:GetDescendants()) do
                            if d:IsA("ProximityPrompt") and (d.ObjectText == "SPAWN CAR" or d.ActionText:find("SPAWN", 1, true)
                                or d:FindFirstAncestor("Car_Spawn")) then
                                local pp2 = promptPos(d)
                                if pp2 and (pp2 - pos).Magnitude <= 150 and (not bd or (pp2 - pos).Magnitude < bd) then
                                    pp, bd = d, (pp2 - pos).Magnitude
                                end
                            end
                        end
                    end
                end
                if pp then break end
                task.wait(0.3)
            end
            if pp then
                goNear(promptPos(pp), tok, true, false, deadline)
                pressPrompt(pp)
                local ui, t1 = nil, os.clock()
                while os.clock() - t1 < 4 and not cancelled(tok) do
                    ui = gui:FindFirstChild("Car_Spawn")
                    if ui and ui.Enabled then break end
                    task.wait(0.2)
                end
                if ui then
                    task.wait(0.5)
                    local btn
                    for _, b in ipairs(ui:GetDescendants()) do
                        if b:IsA("TextButton") and b.Name == "Spawn" and shown(b) then
                            local tpl = b.Parent
                            local match = (not CAR_NAME) or tpl.Name == CAR_NAME
                            if not match then
                                for _, l in ipairs(tpl:GetDescendants()) do
                                    if l:IsA("TextLabel") and l.Text == CAR_NAME then match = true; break end
                                end
                            end
                            if match then btn = b; break end
                        end
                    end
                    if btn then
                        setStatus("🚗 กดเบิกรถ")
                        clickBtn(btn)
                        local hum = getHum()
                        local t2 = os.clock()
                        while os.clock() - t2 < 5 and not cancelled(tok) do
                            if hum and hum.SeatPart then return end
                            task.wait(0.2)
                        end
                        local r3 = getRoot()
                        local seat2 = r3 and findOwnCar(r3.Position)
                        if seat2 and trySit(seat2) then return end
                    else
                        setStatus("⚠️ ไม่เจอปุ่ม Spawn / ชื่อรถไม่ตรง")
                    end
                end
            else
                setStatus("⚠️ ไม่เจอ prompt เบิกรถแถวนี้")
            end
        end
      end
    end
end

