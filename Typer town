        local tween = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut,
            -1, reverses ~= false), p)
        tween:Play()
        return tween
    end

    -- ความโปร่งของกระจก ปรับตามการตั้งค่าความโปร่งใสของผู้เล่น
    local function alpha(a) return math.max(a, 0) * PREF_T end

    -- ลำดับใน UIListLayout ให้ตรงลำดับที่สร้างเสมอ
    local orderN = 0
    local function ord() orderN = orderN + 1 return orderN end

    -- พื้นผิวกระจก: สีโปร่งแสง + ไล่สี
    local function glass(o, r, a, c1, c2, rot)
        o.BackgroundColor3 = C.white
        o.BackgroundTransparency = alpha(a)
        o.BorderSizePixel = 0
        round(o, r)
        return grad(o, c1, c2, rot)
