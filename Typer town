    -- ปรับตัวเลข [-] ค่า [+] (กดค้างเพื่อเลื่อนเร็ว) สไตล์เดียวกับ Toggle
    local function Stepper(page, str, minV, maxV, step, value, fmt, cb)
        local BASE = 0.3
        local _, inner = item(page, 40)
        local row = new("Frame", {Size = UDim2.fromScale(1, 1)}, inner)
        glass(row, 11, BASE, T.surfTop, T.surfBot, 90)
        rim(row, C.blue, 1.1, 0.5)
        sheen(row, 11, 0.88)
        text(row, str, 12, Enum.Font.GothamBold, {Position = UDim2.fromOffset(12, 0),
            Size = UDim2.new(1, -150, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd})
        local function chipBtn(label, x)
            local b = new("TextButton", {Text = label, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = C.white,
                AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0),
                Size = UDim2.fromOffset(28, 28), BackgroundColor3 = C.white, BackgroundTransparency = 0.15,
                BorderSizePixel = 0, ClipsDescendants = true}, row)
            pill(b)
            grad(b, C.blue, C.deep, 90)
            stroke(b, C.glow, 1.1, 0.4)
            return b
        end
        local plus = chipBtn("+", -8)
        local valL = text(row, "", 13, Enum.Font.GothamBlack, {AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -40, 0.5, 0), Size = UDim2.fromOffset(62, 24)})
        local minus = chipBtn("−", -106)
        local v = value
        local function show() valL.Text = fmt and fmt(v) or tostring(v) end
        local function setV(nv, fire)
            nv = math.clamp(math.floor((tonumber(nv) or v) / step + 0.5) * step, minV, maxV)
            if nv == v and not fire then show() return end
            v = nv
            show()
            if not REDUCED_MOTION then
                valL.TextSize = 16
                tw(valL, 0.2, {TextSize = 13}, Enum.EasingStyle.Back)
            end
            if fire and cb then task.spawn(cb, v) end
        end
        setV(value, false)
        local function hold(b, dir)
            local fire = rippleOn(b, C.white, 0.6)
            local holdId = 0
            b.MouseButton1Down:Connect(function()
                fire()
                holdId = holdId + 1
                local id = holdId
                setV(v + dir * step, true)
                task.delay(0.4, function()
                    while holdId == id and b.Parent do
                        setV(v + dir * step, true)
                        task.wait(0.07)
                    end
                end)
                UIS.InputEnded:Once(function() if holdId == id then holdId = holdId + 1 end end)
            end)
            b.MouseLeave:Connect(function() holdId = holdId + 1 end)
        end
        hold(minus, -1)
        hold(plus, 1)
        return {Get = function() return v end, Set = function(nv, silent) setV(nv, not silent) end}
    end

