function TX.bag(key)
    local pd = lp:FindFirstChild("PlayerData")
    local v = pd and pd:GetAttribute(key)
    return type(v) == "number" and v or nil
end

function TX.call(action, key, n)
    return pcall(function() return TX.R.Invoke("_storage_tx", action, TX.carName(), key, n) end)
end

function TX.waitChange(key, before, tok)
    local t0 = os.clock()
    while os.clock() - t0 < 3 and not cancelled(tok) do
        task.wait(0.2)
        local now = TX.bag(key)
        if now and now ~= before then task.wait(0.4); return TX.bag(key) end
    end
    return TX.bag(key)
end

function TX.read(key)
    local cars = lp:FindFirstChild("Cars")
    local car = cars and cars:FindFirstChild(TX.carName())
    local sto = car and car:FindFirstChild("Storage")
    if not sto then return nil end
    local v = sto:GetAttribute(key)
    if type(v) == "number" then return v end
    local c = sto:FindFirstChild(key)
    if c and c:IsA("ValueBase") and type(c.Value) == "number" then return c.Value end
    if next(sto:GetAttributes()) ~= nil or #sto:GetChildren() > 0 then return 0 end
    return nil
end

function TX.sync(key)
    local r = TX.read(key)
    if r then
        trunkStock[key] = r
        local u = TX.unit[key]
        if u and r * u >= TX.cap - u + 1e-6 then trunkFull = true end
        TX.realOk = true
    end
    return r
end

function TX.deposit(key, tok)
    if not TX.R or TX.broken then return nil end
    local before = TX.bag(key)
    if not before then return nil end
    if before <= 0 then lastStashWhy = "กระเป๋าไม่มี " .. key; return false end
    TX.sync(key)
    local n, unit = before, TX.unit[key]
    if unit then
        local room = math.floor((TX.cap - (trunkStock[key] or 0) * unit) / unit + 1e-6)
        if room <= 0 then trunkFull = true; lastStashWhy = "ท้ายรถเต็ม (คำนวณ)"; return false end
        n = math.min(before, room)
    end
    local ok, res = TX.call("Deposit", key, n)
    if not ok then TX.broken = true; lastStashWhy = "remote error: " .. tostring(res); return nil end
    local after = TX.waitChange(key, before, tok)
    if after and after < before then
        TX.noChange = 0
        local moved = before - after
        local real = TX.read(key)
        trunkStock[key] = real or ((trunkStock[key] or 0) + moved)
        setStatus(string.format("📦 ใส่ท้ายรถ %s x%d (รวม %d%s)", key, moved, trunkStock[key], real and " ✔อ่านจากเกม" or " ~จดเอง"))
        if moved < n then
            trunkFull = true; lastStashWhy = "ท้ายรถเต็ม (ใส่ได้ " .. moved .. ")"
        elseif unit and trunkStock[key] * unit >= TX.cap - unit + 1e-6 then
            trunkFull = true; lastStashWhy = "ท้ายรถเต็ม (ครบ " .. TX.cap .. " KG)"
        end
        return true
    end
    TX.noChange += 1
    lastStashWhy = "remote ไม่เปลี่ยนจำนวน res=" .. tostring(res)
    if TX.noChange >= 2 then trunkFull = true end
    return false
end

function TX.unload(key, pt, tok)
    if not TX.R or TX.broken or TX.bag(key) == nil then return nil end
    TX.sync(key)
    local fails = 0
    for _ = 1, 60 do
        if cancelled(tok) then return false end
        local stock = trunkStock[key] or 0
        if stock <= 0 then break end
        local c, m = invCount(pt)
        c = TX.bag(key) or c or 0
        local n = math.min(stock, (m or 60) - c)
        if n <= 0 then
            if not sellAll(pt, tok, true) then return false end
            lastSoldAt = os.clock()
        else
            setStatus(string.format("📦 เอา %s ออกจากท้ายรถ x%d (เหลือประมาณ %d)", key, n, stock))
            local before = TX.bag(key) or c
            local ok, res = TX.call("Withdraw", key, n)
            if not ok then TX.broken = true; lastStashWhy = "remote error: " .. tostring(res); return nil end
            local after = TX.waitChange(key, before, tok)
            local moved = (after or before) - before
            if moved > 0 then
                fails = 0
                trunkStock[key] = TX.read(key) or math.max(0, stock - moved)
                if not sellAll(pt, tok, true) then return false end
                lastSoldAt = os.clock()
            else
                fails += 1
                lastStashWhy = "withdraw ไม่เปลี่ยนจำนวน res=" .. tostring(res)
                setStatus("⚠️ เอาออกจากท้ายรถไม่ได้: " .. tostring(res))
                if fails >= 2 then return false end
            end
        end
    end
    if (trunkStock[key] or 0) <= 0 then
        trunkStock[key] = 0
        trunkFull = false
        trunkRoom = nil
        return true
    end
    return false
end

stashTry = function(key, tok)
    if TX.R and not TX.broken then pcall(TX.sync, key) end
    if not TRUNK_ON or trunkDisabled or trunkFull or not key then
        lastStashWhy = (not TRUNK_ON and "TRUNK_ON=false") or (trunkDisabled and "ระบบท้ายรถถูกปิด") or (trunkFull and "ท้ายรถเต็ม") or "no key"
        return false
    end
    do
        local r = TX.deposit(key, tok)
        if r ~= nil then return r end
    end
    do
        local have = invCount({n = key})
        if have and trunkUnit[key] and trunkRoom and trunkRoom < trunkUnit[key] * have then
            trunkFull = true
            lastStashWhy = "น้ำหนักท้ายรถเหลือไม่พอ"
            return false
        end
    end
    local ok, r = pcall(stashItem, key, tok)
    if not ok then
        r = "fail"
        trunkFails += 1
        pcall(closeTrunk)
    end
    if trunkFails >= TRUNK_FAIL_MAX and not trunkDisabled then
        trunkDisabled = true
        setStatus("⚠️ ท้ายรถใช้ไม่ได้ " .. TRUNK_FAIL_MAX .. " ครั้งติด → ปิดระบบท้ายรถ ขายตามปกติ")
    end
    return r == "ok"
end

-- อ่านของทุกชนิดในท้ายรถจากเกม (ใส่ trunkStock) | ไม่มีข้อมูล = ใช้ที่จดไว้
function TX.syncAll()
    local cars = lp:FindFirstChild("Cars")
    local car = cars and cars:FindFirstChild(TX.carName())
    local sto = car and car:FindFirstChild("Storage")
    if not sto then return false end
    for k, v in pairs(sto:GetAttributes()) do
        if type(v) == "number" then trunkStock[k] = v end
    end
    for _, c in ipairs(sto:GetChildren()) do
        if c:IsA("ValueBase") and type(c.Value) == "number" then trunkStock[c.Name] = c.Value end
    end
    return true
end

-- หลังขายกระเป๋าแล้ว: เอาของทุกชนิดในท้ายรถออกมาขายจนหมด (ของฟามนี้ก่อน แล้วของที่ค้างจากฟามอื่น)
-- จบรอบขาย = ล้างสถานะ "ท้ายรถเต็ม" ให้เริ่มเก็บใหม่
RG.unloadAll = function(firstKey, pt, tok)
    if TX.R and not TX.broken then pcall(TX.syncAll) end
    local keys = {}
    if firstKey and (trunkStock[firstKey] or 0) > 0 then keys[1] = firstKey end
    for k, v in pairs(trunkStock) do
        if k ~= firstKey and type(v) == "number" and v > 0 then keys[#keys + 1] = k end
    end
    local allOk = true
    for _, k in ipairs(keys) do
        if cancelled(tok) then return false end
        local ok = unloadAndSell(k, (k == firstKey) and pt or {n = k}, tok)
        if not ok then allOk = false end
    end
    trunkFull = false
    TX.noChange = 0
    return allOk
end

-- ถึงเวลาเทท้ายรถมาขายไหม: ท้ายรถเต็มจริง / ปิดระบบท้ายรถ / ระบบท้ายรถใช้ไม่ได้ (ใส่ไม่ผ่านเพราะพลาดชั่วคราว = ยังไม่เท)
RG.shouldUnload = function()
    return trunkFull or not TRUNK_ON or trunkDisabled
end

RG.setTrunk = function(on)
    TRUNK_ON = on == true
    if TRUNK_ON then   -- เปิดใหม่ = ให้โอกาสลองใหม่
        trunkDisabled, trunkFails, trunkFull = false, 0, false
        TX.noChange, TX.broken = 0, false
    end
    setStatus(TRUNK_ON and "📦 เก็บท้ายรถจนเต็มแล้วค่อยขาย: เปิด" or "📦 เก็บท้ายรถ: ปิด (เต็มแล้วไปขายเลย)")
end

unloadAndSell = function(key, pt, tok)
    do
        local r = TX.unload(key, pt, tok)
        if r ~= nil then return r end
    end
    local fails = 0
    for _ = 1, 30 do
        if cancelled(tok) then return false end
        if (trunkStock[key] or 0) <= 0 then break end
        setStatus(string.format("📦 เอา %s ออกจากท้ายรถมาขาย (เหลือประมาณ %d)", key, trunkStock[key]))
        local okc, opened = pcall(openTrunk, tok, false)
        if not (okc and opened) then
            pcall(closeTrunk)
            fails += 1
            if fails >= 2 then break end
            waitSec(1, tok)
        else
            local n = stCountWait("Storage", key, 1.5, tok)
            if not n or n <= 0 then
                trunkStock[key] = 0
                pcall(closeTrunk)
                break
            end
            local okm, moved = pcall(trunkMove, "Storage", key, tok)
            pcall(closeTrunk)
            if not okm or not moved or moved <= 0 then
                fails += 1
                if fails >= 2 then break end
            else
                fails = 0
                trunkStock[key] = math.max(0, n - moved)
                if not sellAll(pt, tok, true) then break end
                lastSoldAt = os.clock()
            end
        end
    end
    if (trunkStock[key] or 0) <= 0 then
        trunkStock[key] = 0
        trunkFull = false
        trunkRoom = nil
        return true
    end
    return false
end

-- ==================== คราฟ ====================
local function readRows()
    local sf = craftChild("Right_Tab", "ScrollingFrame")
    if not sf then return end
    local rows, any = {}, false
    for _, nm in ipairs(RECIPE_ROWS) do
        local ch = sf:FindFirstChild(nm)
        local a = ch and ch:FindFirstChild("Amount")
        local txt = textOf(a)
        if txt and shown(ch) then
            local t = txt:gsub(",", "")
            local h, n = t:match("(%d+)%s*/%s*(%d+)")
            if h and n then rows[nm] = {have = tonumber(h), need = tonumber(n)}; any = true end
        end
    end
    if any then return rows end
end

local function craftAmount()
    local txt = textOf(craftChild("Function", "Amount", "Amount"))
    if txt then
        local t = txt:gsub(",", "")
        return tonumber(t:match("%d+"))
    end
end

local function pressUntilOpen(tok, seconds)
    local pp = findCraftPrompt()
    local t0 = os.clock()
    while os.clock() - t0 < seconds and not cancelled(tok) do
        if craftIsOpen() then return true end
        if not (pp and pp.Parent) then pp = findCraftPrompt() end
        if pp then pressPrompt(pp) end
        task.wait(0.4)
    end
    return craftIsOpen()
end

-- คืนจำนวนที่คราฟได้ (>0) / 0 = ทำไม่ได้ / nil = ผิดพลาด (ลองใหม่ได้)
local function craftTry(tok, force, room)
    if force then
        local pp = findCraftPrompt()
        if pp then pressPrompt(pp) end
        waitSec(1, tok)
    end
    setStatus("🍚 เปิดหน้าคราฟ...")
    if not pressUntilOpen(tok, 8) then return nil end
    waitSec(0.5, tok)

    local selected = false
    for _ = 1, 6 do
        if cancelled(tok) then return nil end
        local sf = craftChild("Left_Tab", "ScrollingFrame")
        local it = sf and sf:FindFirstChild(RECIPE_NAME)
        if it then
            if it:IsA("GuiButton") then
                clickOnce(it)
            else
                for _, d in ipairs(it:GetDescendants()) do
                    if d:IsA("GuiButton") then clickOnce(d); break end
                end
            end
        end
        waitSec(0.5, tok)
        local nm = textOf(craftChild("ItemName"))
        if nm and nm:upper():gsub("%s", "") == RECIPE_TITLE then selected = true; break end
    end
    if not selected then
        setStatus("⚠️ เลือกสูตร " .. RECIPE_NAME .. " ไม่ได้")
        return nil
    end

    local rows
    local t0 = os.clock()
    while os.clock() - t0 < 4 and not cancelled(tok) do
        local r = readRows()
        if r and r.Rice and r.Mango then rows = r; break end
        task.wait(0.2)
    end
    if not rows then
        setStatus("⚠️ อ่านวัตถุดิบในหน้าคราฟไม่ได้")
        return nil
    end
    local cur = craftAmount()
    if not cur or cur < 1 then
        cur = math.max(1, math.floor(rows.Rice.need / FALLBACK_RICE_UNIT + 0.5))
    end
    local unit, maxN, limiter = {}, math.min(CRAFT_MAX, room or CRAFT_MAX), nil
    for _, nm in ipairs(RECIPE_ROWS) do
        local r = rows[nm]
        if r then
            unit[nm] = r.need / cur
            if unit[nm] > 0 then
                local can = math.floor(r.have / unit[nm] + 1e-6)
                if can < maxN then maxN = can; limiter = nm end
            end
        end
    end
    if not unit.Rice or unit.Rice <= 0 then return nil end
    if room and room < maxN then maxN = math.max(room, 0) end
    if maxN < 1 and room and room < 1 then return 0 end
    if maxN < 1 then
        if limiter and rows[limiter] then
            setStatus(string.format("⚠️ คราฟไม่ได้: %s ไม่พอ (มี %d ต้องใช้ %d ต่อชิ้น %s)", tostring(limiter),
                rows[limiter].have, math.ceil(unit[limiter]), RECIPE_NAME))
        else
            setStatus("⚠️ ช่องเก็บข้าวเหนียวมะม่วงเต็มแล้ว")
        end
        return 0
    end

    local plus, minus = craftChild("Function", "Plus"), craftChild("Function", "Subtraction")
    local btnCraft = craftChild("Button", "Craft")
    if not (plus and minus and btnCraft) then
        setStatus("⚠️ ไม่เจอปุ่ม + / - / Craft ในหน้าคราฟ")
        return nil
    end
    local function curN()
        local rs = readRows()
        if rs and rs.Rice then return math.floor(rs.Rice.need / unit.Rice + 0.5) end
    end
    local stuck = 0
    for _ = 1, 160 do
        if cancelled(tok) then return nil end
        local c = curN()
        if c == maxN then break end
        setStatus(string.format("🍚 ตั้งจำนวนคราฟ %s → %d (สูงสุดที่ของพอ, จำกัดโดย %s)", tostring(c), maxN, tostring(limiter or "-")))
        clickOnce((c and c > maxN) and minus or plus)
        waitSec(0.18, tok)
        if curN() == c then stuck += 1 else stuck = 0 end
        if stuck >= 5 then break end
    end
    local final = curN()
    if not final or final < 1 or final > maxN then
        setStatus("⚠️ ตั้งจำนวนคราฟไม่สำเร็จ")
        return nil
    end

    local have0 = rows.Rice.have
    local tClick = os.clock()
    setStatus(string.format("🍚 กดคราฟ %d ชิ้น...", final))
    clickOnce(btnCraft)
    local started, rejected = false, false
    local t1 = os.clock()
    while os.clock() - t1 < 4 and not cancelled(tok) do
        if lastCraftStart >= tClick then started = true; break end
        if lastCraftReject >= tClick then rejected = true; break end
        local rs = readRows()
        if rs and rs.Rice and rs.Rice.have < have0 then started = true; break end
        task.wait(0.1)
    end
    if cancelled(tok) then return nil end
    if rejected then
        setStatus("⚠️ เซิร์ฟเวอร์ปฏิเสธการคราฟ (ของ/Exp ไม่พอ)")
        return 0
    end
    if not started then return nil end

    local t2, done = os.clock(), false
    while os.clock() - t2 < CRAFT_DONE_MAX and not cancelled(tok) do
        if lastCraftDone >= tClick then done = true; break end
        if os.clock() - t2 >= 12 then
            local rs = readRows()
            if rs and rs.Rice and rs.Rice.have < have0 then done = true; break end
        end
        setStatus(string.format("🍚 กำลังคราฟ %d ชิ้น... %d วิ", final, math.floor(os.clock() - t2)))
        task.wait(0.25)
    end
    if cancelled(tok) then return nil end
    if not done then return nil end
    waitSec(0.8, tok)
    return final
end

local function doCraft(tok, room)
    local total = 0
    for _ = 1, CRAFT_ROUNDS do
        if room - total < 1 then break end
        local n
        for attempt = 1, 3 do
            n = craftTry(tok, attempt > 1, room - total)
            if n ~= nil or cancelled(tok) then break end
            setStatus(string.format("🔁 คราฟไม่ติด ลองใหม่ (%d/3)", attempt))
            waitSec(1, tok)
        end
        if cancelled(tok) or n == nil or n == 0 then break end
        total += n
        waitSec(0.5, tok)
    end
    return total
end

local function resetFarmState()
    presses = 0; fullTok = -1; fullReal = false; fullSince = nil; sellBackoffUntil = 0
end

local function comboFarm(key, nextPhase, tok)
    local pt = findPoint(key)
    if not pt then
        setStatus("⚠️ ไม่พบจุดฟาม " .. key)
        task.wait(1)
        return
    end
    stopWhenFull = true
    local ok, r = pcall(farmTick, pt, tok)
    stopWhenFull = false
    if not ok then error(r) end
    if r == "full" and not cancelled(tok) then
        resetFarmState()
        comboPhase = nextPhase
        setStatus("✅ " .. key .. " เต็มแล้ว → " .. (nextPhase == "rice" and "ไปฟามข้าว" or "ไปคราฟ"))
    end
end

local function comboStopAuto(msg)
    autoOn = false
    RG.cfsSet("autoOn", false)
    token = token + 1
    refreshToggle()
    local hum = getHum()
    if hum then hum:Move(Vector3.zero) end
    setStatus(msg)
end

local function comboTick(_, tok)
    if comboPhase == "mango" then
        comboFarm("Mango", "rice", tok)

    elseif comboPhase == "rice" then
        comboFarm("Rice", "craft", tok)

    elseif comboPhase == "craft" then
        local haveProd = invCount(PROD_PT)
        if haveProd == nil then haveProd = comboBag end
        local room = math.max(PROD_CAP - haveProd, 0)
        if room < 1 then
            comboFlush = true
            comboPhase = "sell"
            setStatus("📦 กระเป๋าเต็มด้วยข้าวเหนียวมะม่วง → ไปขาย")
            return
        end
        local root0, veh0 = getRoot()
        if not root0 then task.wait(0.5); return end
        local d0 = flatDist(root0.Position, CRAFT_POS)
        local reached = true
        if veh0 or d0 > 15 then
            setStatus("🍚 ไปโต๊ะคราฟ Craft_3...")
            goBack(CRAFT_PT, tok, d0, veh0)
            if cancelled(tok) then return end
            local r1 = getRoot()
            reached = r1 ~= nil and flatDist(r1.Position, CRAFT_POS) <= 25
        end
        if not reached then
            if cancelled(tok) then return end
            comboTravelFails += 1
            if comboTravelFails >= 5 then
                comboStopAuto("⛔ ไปโต๊ะคราฟไม่ถึง 5 รอบติด (เช็ครถ/ทาง) หยุดออโต้")
                return
            end
            setStatus("⚠️ ไปโต๊ะคราฟไม่ถึง ลองใหม่ (" .. comboTravelFails .. "/5)")
            waitSec(2, tok)
            return
        end
        comboTravelFails = 0

        local pp
        local t0 = os.clock()
        while os.clock() - t0 < 6 and not cancelled(tok) do
            pp = findCraftPrompt()
            if pp then break end
            task.wait(0.3)
        end
        if cancelled(tok) then return end

        local total = 0
        if pp then
            local pos = promptPos(pp)
            if pos then goNear(pos, tok, true, false) end
            if cancelled(tok) then return end
            total = doCraft(tok, room)
            if cancelled(tok) then return end
        else
            setStatus("⚠️ ไม่เจอพร้อพโต๊ะ Craft_3")
        end

        if total > 0 then
            comboCrafted = total
            comboCraftFails = 0
            local stashed = stashTry(PROD_PT.n, tok)
            if cancelled(tok) then return end
            local bag = invCount(PROD_PT)
            if bag == nil then
                comboBag = stashed and 0 or (comboBag + total)
                bag = comboBag
            end
            if bag >= PROD_SELL_AT then
                comboFlush = true
                comboPhase = "sell"
                setStatus(string.format("✅ คราฟได้ %d ชิ้น | กระเป๋า %d (ท้ายรถ ~%d) [%s] → ไปขาย", total, bag, trunkStock[PROD_PT.n] or 0, stashed and "ok" or lastStashWhy))
            else
                resetFarmState()
                comboPhase = "mango"
                setStatus(string.format("✅ คราฟได้ %d ชิ้น | %s | กระเป๋า %d ท้ายรถ ~%d → ฟามต่อ",
                    total, stashed and "เก็บท้ายรถแล้ว" or ("ไม่ได้ใส่ท้ายรถ: " .. lastStashWhy), bag, trunkStock[PROD_PT.n] or 0))
            end
        else
            comboCraftFails += 1
            if comboCraftFails >= CRAFT_FAIL_STOP then
                comboStopAuto(string.format("⛔ คราฟไม่ผ่าน %d รอบติด (เช็ค Exp/วัตถุดิบ/ชื่อสูตร) หยุดออโต้", CRAFT_FAIL_STOP))
                return
            end
            comboCrafted = 0
            comboPhase = "sell"
            setStatus(string.format("⚠️ คราฟไม่สำเร็จ (%d/%d) → ขายของเคลียร์กระเป๋าแล้วเริ่มใหม่", comboCraftFails, CRAFT_FAIL_STOP))
            waitSec(1.5, tok)
        end

    elseif comboPhase == "sell" then
        if comboFlush and TX.R and not TX.broken then pcall(TX.sync, PROD_PT.n) end
        local sold = sellAll(PROD_PT, tok, true)
        if sold and (comboFlush or RG.shouldUnload()) then
            local okU = RG.unloadAll(PROD_PT.n, PROD_PT, tok)   -- ข้าวเหนียวมะม่วงในท้ายรถ (+ของที่ค้างจากฟามอื่น)
            if comboFlush then sold = okU end
        end
        if sold then
            local left = invCount(PROD_PT)
            if comboCrafted > 0 and left and left > 0 then
                setStatus("⚠️ ขายแล้วแต่ข้าวเหนียวมะม่วงยังเหลือ " .. left .. " (ไปต่อ)")
                waitSec(1.5, tok)
            else
                setStatus("✅ ขายเสร็จ → กลับไปฟามมะม่วง")
            end
            lastSoldAt = os.clock()
            comboCrafted = 0
            comboBag = 0
            comboFlush = false
            comboSellFails = 0
            resetFarmState()
            comboPhase = "mango"
        elseif not cancelled(tok) then
            comboSellFails += 1
            if comboSellFails >= 3 then
                comboSellFails = 0
                comboFlush = false
                resetFarmState()
                comboPhase = "mango"
                setStatus("⚠️ ขายไม่สำเร็จ 3 รอบ → ข้ามไปฟามต่อ (ของที่คราฟยังอยู่)")
            else
                setStatus("⚠️ ขายไม่สำเร็จ ลองใหม่ (" .. comboSellFails .. "/3)")
            end
            waitSec(3, tok)
        end
    end
end

