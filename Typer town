local invCap = {}
local function invCount(pt)
    local key = farmKey(pt)
    if not key then return end
    do
        local pd = lp:FindFirstChild("PlayerData")
        local av = pd and pd:GetAttribute(key)
        if type(av) == "number" then return av, invCap[key] or 60 end
    end
    local txt
    local inv = gui:FindFirstChild("Inventory")
    local sf = inv and inv:FindFirstChild("ScrollingFrame", true)
    local it = sf and sf:FindFirstChild(key)
    local lbl = it and it:FindFirstChild("items")
    if lbl and lbl:IsA("TextLabel") then txt = lbl.Text end
    if not txt then
        local af = gui:FindFirstChild("Auto Farm")
        local main = af and af:FindFirstChild("Main", true)
        local nm = main and main:FindFirstChild("NameFarm")
        local am = main and main:FindFirstChild("Amount")
        if nm and am and nm.Text:lower() == key:lower() then txt = am.Text end
    end
    if not txt and sf and not it then
        for _, ch in ipairs(sf:GetChildren()) do
            if ch:FindFirstChild("items") then return 0, invCap[key] or 60 end
        end
    end
    if not txt then return end
    local c, m = txt:match("(%d+)%s*|%s*(%d+)")
    c, m = tonumber(c), tonumber(m)
    if c and m and m > 0 then invCap[key] = m; return c, m end
end

