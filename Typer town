        CHECK_EVERY    = 0.5,
        RETRY_SECONDS  = 8,
        CATEGORY       = "ROLEPLAY",
        MIN_PLAYERS    = 1,
        ONLY_ONLINE    = true,
        MAX_PING       = 120,
        JOIN_TIMEOUT   = 25,
        MAX_TRIES      = 5,
        BL_ENABLED     = true,
        ENABLED        = false,
    }

    local BLACKLIST = {
        "sant1975", "Venvonya", "amirkill498", "jyvanwaalrtynnesfv81", "FS17_4036",
        "r_oess54", "GM_14YPRO", "A525311501", "burhxn52", "morn1",
        "FDFYFG48", "awesd001111", "kaitunN3P_128", "JHUI_SM83", "abzshop3011",
        "j4ysixx", "n9xxyz", "sant_sangchay", "Gam_Shebada", "Bmh1z",
        "Milloh0019", "Themac1555", "2tghjbv_443", "Kaitunzonen5_264", "4kxnzdev",
        "nsr36557", "hagame5555", "Switch_Hub020B", "GDE_11345", "HtmlXDEV",
        "Qxfe4r", "TremTem01", "tooj1239",
    }
    local function norm(n) return (tostring(n):lower():gsub("i", "l")) end
    local BL_NAMES = {}
    for _, n in ipairs(BLACKLIST) do BL_NAMES[norm(n)] = true end
    local BL_IDS = {}
    local function isBlacklisted(plr)
        return BL_NAMES[norm(plr.Name)] == true or BL_IDS[plr.UserId] == true   -- ชื่อ หรือ ไอดี (เปลี่ยนชื่อก็ยังจับได้)
    end

    -- กันรันซ้อน: ตัวใหม่แทนตัวเก่า
    local RUN_ID = tostring(os.clock()) .. tostring(math.random(1, 1e9))
    local env = (getgenv and getgenv()) or _G
    env.__SERVERHOP_ID = RUN_ID
    local function alive() return env.__SERVERHOP_ID == RUN_ID and sg.Parent ~= nil end

    -- ---------- ตั้งค่า + บันทึกไฟล์ ----------
    local LIMIT_MIN, LIMIT_MAX = 1, 75
    local SAVE_FILE = "serverhop_settings.json"
    local function clampv(v) return math.clamp(math.floor(tonumber(v) or LIMIT_MIN), LIMIT_MIN, LIMIT_MAX) end
    local idCache = {}   -- ชื่อ -> ไอดี (จำไว้ในไฟล์ รอบหน้าไม่ต้องหาใหม่)
    pcall(function()
        if isfile and readfile and isfile(SAVE_FILE) then
            local d = HttpService:JSONDecode(readfile(SAVE_FILE))
            CONFIG.LEAVE_ABOVE = d.leave or CONFIG.LEAVE_ABOVE
            if d.enabled ~= nil then CONFIG.ENABLED = d.enabled end
            if type(d.blids) == "table" then idCache = d.blids end
        end
    end)
    CONFIG.LEAVE_ABOVE = clampv(CONFIG.LEAVE_ABOVE)
    local function save()
        pcall(function()
            if writefile then
                writefile(SAVE_FILE, HttpService:JSONEncode({leave = CONFIG.LEAVE_ABOVE, enabled = CONFIG.ENABLED, blids = idCache}))
            end
        end)
    end
    -- ไอดีแบล็คลิสต์: ใช้ที่จำไว้ทันที + หาชื่อที่ยังไม่มีพร้อมกันทุกชื่อ (ไม่ทีละชื่อ)
    local missing = 0
    for _, n in ipairs(BLACKLIST) do
        local id = tonumber(idCache[n])
        if id then BL_IDS[id] = true else missing = missing + 1 end
    end
    local blReady = (missing == 0)
    if missing > 0 then
        local left = missing
        for _, n in ipairs(BLACKLIST) do
            if not tonumber(idCache[n]) then
                task.spawn(function()
                    local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(n) end)
                    if ok and id then BL_IDS[id] = true; idCache[n] = id end
                    left = left - 1
                    if left <= 0 then blReady = true; save() end
                end)
            end
        end
    end

    -- ---------- UI (หน้า ย้ายเซิร์ฟ) ----------
    local HP = RG.page.hop
    RG.UI.Label(HP, "ย้ายเซิร์ฟ")
    RG.UI.Toggle(HP, "ย้ายหนีคนเยอะ", CONFIG.ENABLED == true, function(on) CONFIG.ENABLED = on; save() end)
    RG.UI.Stepper(HP, "ย้ายเมื่อคนมากกว่า", LIMIT_MIN, LIMIT_MAX, 1, CONFIG.LEAVE_ABOVE, nil, function(v)
        CONFIG.LEAVE_ABOVE = clampv(v); save()
    end)
    local hopStatus = RG.UI.StatusRow(HP, "PlaceId " .. game.PlaceId, 54)

    local lastLog = nil
    local function log(...)
        local t = {}
        for i, v in ipairs({...}) do t[i] = tostring(v) end
        local msg = table.concat(t, " ")
        if msg == lastLog then return end   -- ข้อความเดิมซ้ำทุก 0.5 วิ ไม่พิมพ์ซ้ำ (console ไม่รก)
        lastLog = msg
        print("[ServerHop] " .. msg)
        pcall(hopStatus, msg)
    end

    -- ---------- โหมดในแมพ ----------
    local function runInMap()
        log("โหมดแมพ: ย้ายเมื่อคน >", CONFIG.LEAVE_ABOVE, "| แบล็คลิสต์", #BLACKLIST, "ชื่อ")
        local lastTry, tries = 0, 0

        -- ย้ายเซิร์ฟเฉพาะตอนรถไม่ได้วาป/ขับ/ล็อกอยู่เท่านั้น (ถึงที่แล้วค่อยย้าย) ไม่ตีกับระบบวาป
        -- urgent (แบล็คลิสต์) = ย้ายทันที ไม่รอรถขับเสร็จ ลองซ้ำทุก 3 วิ | คนเยอะ = รอรถถึงที่ก่อน ลองซ้ำทุก 8 วิ
        local function hop(reason, urgent)
            if not urgent and RG.busy() then
                log("⏳ " .. reason .. " → รอวาป/ขับรถเสร็จก่อนค่อยย้าย")
                return
            end
            if os.clock() - lastTry <= (urgent and 3 or CONFIG.RETRY_SECONDS) then return end
            lastTry = os.clock()
            tries = tries + 1
            local target = (tries % 2 == 1) and CONFIG.LOBBY_PLACE_ID or game.PlaceId
            log(("%s -> Teleport ไป %d (ครั้งที่ %d)"):format(reason, target, tries))
            local ok, err = pcall(function() TeleportService:Teleport(target, lp) end)
            if not ok then log("Teleport error:", err) end
        end

        local function checkBlacklist()
            if not CONFIG.BL_ENABLED then return false end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp and isBlacklisted(plr) then
                    hop("🚨 เจอแบล็คลิสต์ " .. plr.Name .. " → ย้ายทันที", true)
                    return true
                end
            end
            return false
        end

        local function check()
            if not alive() then return end
            if checkBlacklist() then return end
            local n = #Players:GetPlayers()
            if not CONFIG.ENABLED then
                log(("แมพ | คน %d | ย้ายหนีคนเยอะ: ปิด"):format(n))
                return
            end
            if n > CONFIG.LEAVE_ABOVE then
                hop(("คน %d > %d"):format(n, CONFIG.LEAVE_ABOVE))
            else
                log(("แมพ | คน %d ≤ %d | ปกติ"):format(n, CONFIG.LEAVE_ABOVE))
            end
        end

        RG.t(Players.PlayerAdded:Connect(function(plr)
            if CONFIG.BL_ENABLED and isBlacklisted(plr) then hop("🚨 เจอแบล็คลิสต์ " .. plr.Name .. " → ย้ายทันที", true) else check() end
        end))
        RG.t(Players.PlayerRemoving:Connect(function() task.defer(check) end))
        check()
        while alive() do
            task.wait(CONFIG.CHECK_EVERY)
            check()
        end
    end

    RG.t(TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
        log("TeleportInitFailed:", tostring(result), msg)
    end))

    -- ---------- โหมดล็อบบี้ ----------
    local function runInLobby()
        local pg = gui
        local slGui = pg:WaitForChild("ServerList", 30)
        if not slGui then log("ไม่เจอ ServerList") return end
        log("โหมดล็อบบี้: เลือกเซิร์ฟคนน้อยอัตโนมัติ")

        local serverFolder = RS:WaitForChild("main", 30)
        serverFolder = serverFolder and serverFolder:WaitForChild("assets", 15)
        serverFolder = serverFolder and serverFolder:WaitForChild("server", 15)
        serverFolder = serverFolder and serverFolder:WaitForChild(CONFIG.CATEGORY, 15)
        if not serverFolder then log("ไม่เจอรายชื่อเซิร์ฟ (main.assets.server." .. CONFIG.CATEGORY .. ")") return end

        local function lobbyOpen()
            local g = pg:FindFirstChild("ServerList")
            return g ~= nil and g.Enabled
        end

        -- ไอดีแบล็คลิสต์: จำไว้ในไฟล์แล้ว = ไม่รอ | ครั้งแรก รอหาพร้อมกันทุกชื่อได้ไม่เกิน 4 วิ
        local t0 = os.clock()
        while not blReady and os.clock() - t0 < 4 do task.wait(0.1) end

        local function hasBlacklisted(s)
            if not CONFIG.BL_ENABLED then return false end
            local roster = s:GetAttribute("Roster")
            if typeof(roster) ~= "string" then return false end
            for id in roster:gmatch("%d+") do
                if BL_IDS[tonumber(id)] then return true end
            end
            return false
        end

        local function getCandidates()
            local list = {}
            for _, s in ipairs(serverFolder:GetChildren()) do
                if not hasBlacklisted(s) then
                    local online = s:GetAttribute("Online") == true
                    local count  = tonumber(s:GetAttribute("PlayerCount")) or 0
                    local max    = tonumber(s:GetAttribute("MaxPlayers")) or 75
                    local ping   = tonumber(s:GetAttribute("PingServer")) or 0
                    local ok = count < max
                        and count >= CONFIG.MIN_PLAYERS
                        and (not CONFIG.ONLY_ONLINE or online)
                        and (not online or ping <= CONFIG.MAX_PING)
                    if ok then table.insert(list, {name = s.Name, count = count, ping = ping, online = online}) end
                end
            end
            table.sort(list, function(a, b)
                if a.count ~= b.count then return a.count < b.count end
                return a.ping < b.ping
            end)
            return list
        end

        local function findJoinButton(name)
            local g = pg:FindFirstChild("ServerList")
            local bg2 = g and g:FindFirstChild("Backgound")
            local sv2 = bg2 and bg2:FindFirstChild("Server")
            local sc = sv2 and sv2:FindFirstChild("Scrolling")
            local fr = sc and sc:FindFirstChild(name)
            return fr and fr:FindFirstChild("JoinButton", true)
        end

        local function press(b)
            if getconnections then
                local fired = false
                local okc, list = pcall(getconnections, b.MouseButton1Click)
                for _, c in ipairs(okc and type(list) == "table" and list or {}) do
                    if pcall(function() c:Fire() end) then fired = true end
                end
                if fired then return true end
            end
            if firesignal and pcall(firesignal, b.MouseButton1Click) then return true end
            return RG.tapGui ~= nil and RG.tapGui(b)   -- executor ไม่มีทั้งสอง: แตะปุ่มจริง
        end

        local bgS = slGui:FindFirstChild("Backgound")
        local srv = bgS and bgS:FindFirstChild("Server")
        local sc = srv and srv:WaitForChild("Scrolling", 15)
        if not sc then log("ไม่เจอหน้ารายชื่อเซิร์ฟ") return end
        if #sc:GetChildren() <= 1 then
            local catF = srv:FindFirstChild("Category")
            local cat = catF and catF:FindFirstChild(CONFIG.CATEGORY)
            cat = cat and cat:FindFirstChild("Button")
            if cat then press(cat) end
        end
        -- รอรายชื่อเซิร์ฟ + ปุ่มเข้า ขึ้นมาจริง (เช็คทุก 0.1 วิ สูงสุด 6 วิ) แทนรอตายตัว 3.5 วิ
        local tw = os.clock()
        while os.clock() - tw < 6 do
            local c = getCandidates()
            if #c > 0 and findJoinButton(c[1].name) then break end
            task.wait(0.1)
        end

        local tried = {}
        for _ = 1, CONFIG.MAX_TRIES do
            if not alive() then return end
            local cands, pick = getCandidates(), nil
            for i = 1, math.min(5, #cands) do
                log(("  #%d %s  %d คน  ping %dms  online=%s"):format(i, cands[i].name, cands[i].count, cands[i].ping, tostring(cands[i].online)))
            end
            for _, c in ipairs(cands) do if not tried[c.name] then pick = c break end end
            if not pick then log("ไม่มีเซิร์ฟที่เข้าเงื่อนไข (ลองผ่อน MAX_PING หรือตั้ง MIN_PLAYERS = 0)") return end
            tried[pick.name] = true

            local b = findJoinButton(pick.name)
            if b then
                log(("เข้า %s (%d คน, ping %dms)"):format(pick.name, pick.count, pick.ping))
                if not press(b) then log("กดปุ่มไม่ได้ (executor ไม่รองรับ)") return end
                local t = os.clock()
                while os.clock() - t < CONFIG.JOIN_TIMEOUT do
                    task.wait(0.2)
                    if not lobbyOpen() then log("เข้าสำเร็จ") return end
                end
                log(pick.name, "ไม่ผ่านภายในเวลา ลองตัวถัดไป")
            end
        end
        log("ลองครบแล้วยังเข้าไม่ได้")
    end

    -- ---------- เริ่มทำงาน (ไม่บล็อกฟาม) ----------
    task.spawn(function()
        local ok, err = pcall(function()
            if not game:IsLoaded() then game.Loaded:Wait() end
            local isLobby = game.PlaceId == CONFIG.LOBBY_PLACE_ID or gui:FindFirstChild("ServerList") ~= nil   -- รู้ทันที ไม่ต้องรอ 8 วิ
            log(("PlaceId %d | โหมด: %s"):format(game.PlaceId, isLobby and "ล็อบบี้" or "แมพ"))
            if isLobby then
                runInLobby()
            else
                -- (กด Enter ตอนเข้าแมพ ย้ายไปไว้บนสุดของสคริปต์ เริ่มทันที)
                runInMap()
            end
        end)
        if not ok then log("error:", err); warn("[ServerHop] error:", err) end
    end)
